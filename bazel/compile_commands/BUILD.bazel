load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")

# Shared compile_commands.json foundation. Consumed by the clang-tidy migration
# (//:clang_tidy_* targets) -- keep this target and its label stable for that.
# Hedron's default @//... covers every host-compatible workspace target.
#   bazel run //bazel/compile_commands:refresh
# exclude_headers="all": keeps the DB scoped to translation units instead of
# ballooning with every header transitively pulled in.
# exclude_external_sources: our code only.
refresh_compile_commands(
    name = "refresh",
    exclude_external_sources = True,
    exclude_headers = "all",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
