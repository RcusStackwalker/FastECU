# Qt is reachable only through the aliases below, and only from the layers
# allowed to hold Qt code. A target elsewhere that reaches for Qt -- directly,
# or by way of QT_DEPS / QT_DEPS_NO_WIDGETS -- fails at analysis with a
# visibility error naming both ends. See
# docs/adr/0016-enforce-qt-reachability-by-visibility.md.

# Packages that may link any Qt module. `src/backend` and `src/algorithms` are
# absent except for the leaf packages that exist to hold Qt-typed transitional
# code -- the `legacy` adapters and the `qt_compat` shims. A new package under
# either is denied by default and has to be added here deliberately.
package_group(
    name = "qt_layer",
    packages = [
        "//apps/...",
        "//resources/...",
        "//src/algorithms/protocol/qt_compat",
        "//src/backend/calibration/legacy",
        "//src/backend/config/legacy",
        "//src/backend/definition/legacy",
        "//src/backend/definitions",
        "//src/backend/logging/legacy",
        "//src/platform/...",
        "//src/ui/...",
        "//tests/...",
    ],
)

# Packages that may additionally build a user interface. Nothing under
# `src/backend` or `src/algorithms` qualifies.
package_group(
    name = "widget_layer",
    packages = [
        "//apps/...",
        "//src/platform/...",
        "//src/ui/...",
        "//tests/...",
    ],
)

[
    alias(
        name = module,
        actual = "@fastecu_qt//:qt_" + module,
        visibility = [":qt_layer"],
    )
    for module in [
        "core",
        "gui",
        "remote_objects",
        "serial_port",
        "test",
        "web_sockets",
        "xml",
    ]
]

alias(
    name = "widgets",
    actual = "@fastecu_qt//:qt_widgets",
    visibility = [":widget_layer"],
)

# qt_charts pulls in qt_widgets transitively, so it is gated the same way.
alias(
    name = "charts",
    actual = "@fastecu_qt//:qt_charts",
    visibility = [":widget_layer"],
)
