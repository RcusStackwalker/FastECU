+def _wrapper_command(executable, fixes):
+    """Use the current Bash; Windows PATH can resolve bash.exe to WSL.
+
+    clang-tidy writes the --export-fixes file only when it has diagnostics, but a declared
+    output must exist, so an empty report is written in its place.
+    """
+    command = '"$BASH" "{}" "$@"'.format(executable._clang_tidy_wrapper.path)
+    if not fixes:
+        return command
+    return command + "; status=$?; [ -e \"{fixes}\" ] || printf -- '---\\nMainSourceFile: \"\"\\nDiagnostics: []\\n...\\n' > \"{fixes}\"; exit $status".format(fixes = fixes.path)
