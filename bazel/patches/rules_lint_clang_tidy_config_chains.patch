 _DISABLED_FEATURES = [
     "layering_check",
 ]
+
+def _configs_for(ctx, src):
+    """The configuration files `src` can see.
+
+    With `config_chains`, a `.clang-tidy` is kept only when it is in the chain of the
+    nearest directory above `src` that has one; every other config file is always kept.
+    """
+    chains = ctx.attr._config_chains
+    if not chains:
+        return ctx.files._configs
+    parts = src.short_path.split("/")[:-1]
+    chain = []
+    for count in range(len(parts), -1, -1):
+        key = "/".join(parts[:count])
+        if key in chains:
+            chain = chains[key]
+            break
+    return [
+        config
+        for config in ctx.files._configs
+        if config.basename != ".clang-tidy" or config.short_path in chain
+    ]
 
 def _gather_inputs(ctx, compilation_context, srcs):
