package(default_visibility = ["//visibility:private"])

exports_files([
    "gtest_targets.bzl",
    "qt_common.bzl",
    "qt_remote_objects.bzl",
    "qt_targets.bzl",
    "x86_windows_transition.bzl",
])

# Fuzz harnesses (`*_fuzz_test` targets) build only when a config from
# bazel/fuzz.bazelrc sets this define; every other build skips them.
config_setting(
    name = "fuzz_harnesses_enabled",
    define_values = {"fastecu_fuzz_harnesses": "enabled"},
    visibility = ["//visibility:public"],
)
