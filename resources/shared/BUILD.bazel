# Tests regenerate; production sources and helper binaries retain existing owners.
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "qt_resource_via_qrc")

# Composition and desktop test fixtures provision these resources.
package(default_visibility = [
    "//bazel/layers:apps_desktop",
    "//bazel/layers:tests",
    "//src/platform/desktop/common/ports:__pkg__",
    # MainWindow test fixtures provision real configuration from the bundle.
    "//src/ui/desktop/widgets:__pkg__",
])

# resources/shared/protocols_cfg_eeprom_capabilities_test.cpp pins protocols.cfg's
# write=no/test_write=no capability flags for the Denso SH705x EEPROM
# protocols, and src/backend/config:protocol_catalog_test parses the whole
# file through load_protocol_catalog, both by reading the real, checked-in
# file (not a synthetic copy that could silently drift) -- exported narrowly
# to those two packages rather than widening config_resource's own
# visibility. Deliberately NOT a nested resources/shared/config/BUILD.bazel:
# that would turn config/ into its own Bazel package, which silently
# excludes it from config_resource's glob(["config/*"]) below (verified: an
# empty glob() there fails the build outright since allow_empty defaults to
# false).
exports_files(
    [
        "config/menu.cfg",
        "config/protocols.cfg",
    ],
    visibility = [
        "//resources/shared:__pkg__",
        "//src/backend/config:__pkg__",
        # legacy_menu_golden_test renders the shipped menu.cfg.
        "//src/ui/desktop/menu:__pkg__",
    ],
)

fastecu_gtest(
    name = "test_protocols_cfg_eeprom_capabilities",
    size = "small",
    srcs = ["protocols_cfg_eeprom_capabilities_test.cpp"],
    data = [":config/protocols.cfg"],
    env = {"PROTOCOLS_CFG_PATH": "$(location :config/protocols.cfg)"},
    qt = False,
    deps = ["@googletest//:gtest"],
)

fastecu_gtest(
    name = "test_protocols_cfg_subaru_mitsu_m32r_kline",
    size = "small",
    srcs = ["protocols_cfg_subaru_mitsu_m32r_kline_test.cpp"],
    data = [":config/protocols.cfg"],
    env = {"PROTOCOLS_CFG_PATH": "$(location :config/protocols.cfg)"},
    qt = False,
    deps = ["@googletest//:gtest"],
)

fastecu_gtest(
    name = "test_protocols_cfg_subaru_hitachi_m32r_kline",
    size = "small",
    srcs = ["protocols_cfg_subaru_hitachi_m32r_kline_test.cpp"],
    data = [":config/protocols.cfg"],
    env = {"PROTOCOLS_CFG_PATH": "$(location :config/protocols.cfg)"},
    qt = False,
    deps = ["@googletest//:gtest"],
)

# Resource libraries come from a custom macro that Gazelle does not know, so the
# rule is hand-owned; it is linked for registration, not included.
qt_resource_via_qrc(
    name = "config_resource",
    files = glob(["config/*"]),
    qrc_file = "config.qrc",
    deps = ["//bazel/qt:core"],
)

# Hand-owned for the same reason as config_resource: a custom resource macro.
qt_resource_via_qrc(
    name = "kernels_resource",
    files = glob(["kernels/*"]),
    qrc_file = "kernels.qrc",
    deps = ["//bazel/qt:core"],
)
