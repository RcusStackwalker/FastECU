load("//bazel:qt_common.bzl", "qt_resource_via_qrc")

# Composition and desktop test fixtures provision these resources.
package(default_visibility = [
    "//bazel/layers:apps_desktop",
    "//bazel/layers:tests",
    "//src/platform/desktop/common/ports:__pkg__",
    # MainWindow test fixtures provision real configuration from the bundle.
    "//src/ui/desktop/widgets:__pkg__",
])

# The bundled kernels as plain files, so tests can compare the catalog's
# kernel names with the bundle and load real kernels.
filegroup(
    name = "kernel_files",
    srcs = glob(["kernels/*"]),
    visibility = [
        "//bazel/layers:tests",
        # Tests that load the real kernels.
        "//src/backend/flash/eeprom:__pkg__",
        "//src/platform/desktop/common/flash:__pkg__",
    ],
)

# Resource libraries come from a custom macro that Gazelle does not know, so the
# rule is hand-owned; it is linked for registration, not included.
qt_resource_via_qrc(
    name = "config_resource",
    files = glob(["config/*"]),
    qrc_file = "config.qrc",
    deps = ["//bazel/qt:core"],
)

# Hand-owned for the same reason as config_resource: a custom resource macro.
qt_resource_via_qrc(
    name = "kernels_resource",
    files = glob(["kernels/*"]),
    qrc_file = "kernels.qrc",
    deps = ["//bazel/qt:core"],
)
