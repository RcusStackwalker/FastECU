{
  "minLines": 10,
  "minTokens": 100,
  "format": [
    "cpp"
  ],
  "path": [
    "src",
    "apps",
    "tests"
  ],
  "gitignore": true,
  "ignore": [
    "**/third_party/**",
    "**/vendor/**",
    "**/generated/**",
    "src/algorithms/diagnostics/dtc_tables.cpp",
    "src/backend/config/builtin_catalog.cpp"
  ],
  "reporters": [
    "json"
  ],
  "output": ".nloc-loop/jscpd",
  "silent": true,
  "formatsExts": {
    "cpp": [
      "cpp",
      "cc",
      "cxx",
      "h",
      "hh",
      "hpp",
      "hxx"
    ]
  },
  "absolute": true
}
