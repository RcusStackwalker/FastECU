load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary")
load("//bazel:llvm_static_runtime.bzl", "llvm_static_binary")

genrule(
    name = "llvm_identity",
    srcs = ["@local_llvm//:llvm-identity.json"],
    outs = ["llvm-identity.json"],
    cmd = "cp $< $@",
    cmd_bat = "copy /Y \"$(location @local_llvm//:llvm-identity.json)\" \"$@\" >nul",
    tags = ["manual"],
    visibility = [
        "//:__pkg__",
        "//bazel:__pkg__",
        "//tools/clang-tidy/scripts:__pkg__",
    ],
)

cc_binary(
    name = "windows_host",
    srcs = [
        "FastecuTidyMain.cpp",
        "FastecuTidyModule.cpp",
        "TestAssertionSupport.cpp",
        "TestAssertionSupport.h",
    ] + glob([
        "*Check.cpp",
        "*Check.h",
    ]),
    additional_compiler_inputs = ["@local_llvm//:clang_tidy_headers"],
    # The Windows toolchain lowers CcInfo.system_includes to ordinary /I.
    # clang-cl's /imsvc restores the dependency header classification.
    copts = [
        "/GR-",
        "@$(location @local_llvm//:clang_tidy_headers)",
    ],
    linkopts = [
        "psapi.lib",
        "shell32.lib",
        "ole32.lib",
        "uuid.lib",
        "advapi32.lib",
        "ws2_32.lib",
        "ntdll.lib",
        "version.lib",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "@local_llvm//:clang_tidy_headers",
        "@local_llvm//:clang_tidy_libraries",
        "@zlib",
        "@zstd",
    ],
)

llvm_static_binary(
    name = "fastecu_clang_tidy",
    binary = ":windows_host",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = [
        "//:__pkg__",
        "//bazel:__pkg__",
        "//tools/clang-tidy/scripts:__pkg__",
    ],
)

py_binary(
    name = "load_smoke",
    srcs = ["smoke/smoke.py"],
    data = ["smoke/smoke.cpp"],
    main = "smoke/smoke.py",
    deps = ["@python_deps//pyyaml"],
)

# Built against the system LLVM's headers (see //bazel:llvm.bzl). Tagged manual:
# it needs the selected LLVM development installation used by analysis jobs.
cc_binary(
    name = "fastecu_tidy",
    srcs = [
        "FastecuTidyModule.cpp",
        "TestAssertionSupport.cpp",
        "TestAssertionSupport.h",
    ] + glob([
        "*Check.cpp",
        "*Check.h",
    ]),
    copts = [
        "-std=c++20",
        "-fno-rtti",
        "-fno-exceptions",
    ],
    linkopts = select({
        "@platforms//os:macos": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    linkshared = True,
    tags = ["manual"],
    visibility = [
        "//:__pkg__",
        "//bazel:__pkg__",
        "//tools/clang-tidy/scripts:__pkg__",
    ],
    deps = ["@local_llvm//:clang_tidy_headers"],
)

# Release archives contain these libraries but omit the test executable.
# Compile LLVM's unmodified driver instead of maintaining a FileCheck substitute.
cc_binary(
    name = "filecheck_host",
    srcs = ["@llvm_filecheck_driver//file"],
    additional_compiler_inputs = ["@local_llvm//:clang_tidy_headers"],
    additional_linker_inputs = select({
        "@platforms//os:macos": ["@local_llvm//:lib/libLTO.dylib"],
        "//conditions:default": [],
    }),
    copts = select({
        "@platforms//os:windows": [
            "/GR-",
            "@$(location @local_llvm//:clang_tidy_headers)",
        ],
        "//conditions:default": ["-fno-rtti"],
    }),
    linkopts = select({
        "@platforms//os:windows": [
            "advapi32.lib",
            "ole32.lib",
            "shell32.lib",
            "uuid.lib",
            "psapi.lib",
            "ws2_32.lib",
            "ntdll.lib",
            "version.lib",
        ],
        "@platforms//os:macos": ["-Wl,-lto_library,$(location @local_llvm//:lib/libLTO.dylib)"],
        "@platforms//os:linux": [
            "-ldl",
            "-lpthread",
            "-lm",
        ],
        "//conditions:default": [],
    }),
    tags = ["manual"],
    deps = [
        "@local_llvm//:clang_tidy_headers",
        "@local_llvm//:filecheck_libraries",
        "@zlib",
        "@zstd",
    ],
)

llvm_static_binary(
    name = "FileCheck_windows",
    binary = ":filecheck_host",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:windows"],
)

alias(
    name = "FileCheck",
    actual = select({
        "@platforms//os:windows": ":FileCheck_windows",
        "//conditions:default": ":filecheck_host",
    }),
    tags = ["manual"],
    visibility = [
        "//:__pkg__",
        "//tools/clang-tidy/scripts:__pkg__",
    ],
)

filegroup(
    name = "test_files",
    srcs = glob(
        ["test/**"],
        exclude = ["test/**/__pycache__/**"],
    ),
    visibility = [
        "//:__pkg__",
        "//tools/clang-tidy/scripts:__pkg__",
    ],
)
