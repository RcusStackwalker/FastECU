load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "sonar_scope_files",
    srcs = ["BUILD.bazel"] + glob(
        ["**/*.py"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//:__pkg__"],
)

# The //:clang_tidy_* runner targets are declared in the root package by
# //bazel:clang_tidy.bzl and take their sources from here.
exports_files(
    [
        "clang_tidy_benchmark.py",
        "clang_tidy_output.py",
        "clang_tidy_profile.py",
        "clang_tidy_runner.py",
        "clang_tidy_scope.py",
        "clang_tidy_toolchain.py",
    ],
    visibility = [
        "//:__pkg__",
        "//bazel:__pkg__",
    ],
)

# Runs the Bazel lint aspect (//tools/clang-tidy/aspect); `bazel run //:clang_tidy_aspect`.
py_binary(
    name = "clang_tidy_aspect",
    srcs = [
        "clang_tidy_aspect.py",
        "clang_tidy_output.py",
        "clang_tidy_profile.py",
        "clang_tidy_scope.py",
        "clang_tidy_toolchain.py",
    ],
    data = ["//tools/clang-tidy/plugin:llvm_identity"] + select({
        "@platforms//os:windows": ["//tools/clang-tidy/plugin:fastecu_clang_tidy"],
        "//conditions:default": ["//tools/clang-tidy/plugin:fastecu_tidy"],
    }),
    imports = ["."],
    main = "clang_tidy_aspect.py",
    visibility = ["//:__pkg__"],
)

py_test(
    name = "clang_tidy_aspect_test",
    size = "small",
    srcs = [
        "clang_tidy_aspect.py",
        "clang_tidy_output.py",
        "clang_tidy_profile.py",
        "clang_tidy_scope.py",
        "clang_tidy_toolchain.py",
        "tests/clang_tidy_aspect_test.py",
    ],
    imports = ["."],
    main = "tests/clang_tidy_aspect_test.py",
)

# Compares the findings of the compile-database runner and the aspect runner.
py_binary(
    name = "clang_tidy_parity",
    srcs = ["clang_tidy_parity.py"],
    main = "clang_tidy_parity.py",
)

py_test(
    name = "clang_tidy_parity_test",
    size = "small",
    srcs = [
        "clang_tidy_parity.py",
        "tests/clang_tidy_parity_test.py",
    ],
    imports = ["."],
    main = "tests/clang_tidy_parity_test.py",
)

py_test(
    name = "clang_tidy_toolchain_test",
    srcs = [
        "clang_tidy_toolchain.py",
        "tests/clang_tidy_toolchain_test.py",
    ],
    data = ["//:.github/workflows/pr.yml"],
    imports = ["."],
    main = "tests/clang_tidy_toolchain_test.py",
)

py_test(
    name = "clang_tidy_check_fixtures",
    size = "medium",
    srcs = [
        "clang_tidy_toolchain.py",
        "tests/clang_tidy_lit.py",
    ],
    args = [
        "--helper",
        "$(location @llvm_check_clang_tidy//file)",
        "--filecheck",
        "$(location //tools/clang-tidy/plugin:FileCheck)",
        "--gtest-header",
        "$(location @googletest//:googletest/include/gtest/gtest.h)",
        "--gmock-header",
        "$(location @googletest//:googlemock/include/gmock/gmock.h)",
    ],
    data = [
        "//:.clang-tidy",
        "//tests:clang_tidy_fixture_headers",
        "//tools/clang-tidy/plugin:FileCheck",
        "//tools/clang-tidy/plugin:llvm_identity",
        "//tools/clang-tidy/plugin:test_files",
        "@googletest//:googlemock/include/gmock/gmock.h",
        "@googletest//:googletest/include/gtest/gtest.h",
        "@llvm_check_clang_tidy//file",
    ] + select({
        "@platforms//os:windows": ["//tools/clang-tidy/plugin:fastecu_clang_tidy"],
        "//conditions:default": ["//tools/clang-tidy/plugin:fastecu_tidy"],
    }),
    imports = ["."],
    main = "tests/clang_tidy_lit.py",
    tags = [
        "local",
        "manual",
    ],
    visibility = ["//:__pkg__"],
    deps = ["@python_deps//lit"],
)

