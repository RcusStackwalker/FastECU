# Editing this file makes CI's changed-files clang-tidy run analyze every
# translation unit in scope instead of only the changed ones
# (config_changed in scripts/clang_tidy_runner.py): budget for a full run.
#
# CI pins LLVM 23 for clang-tidy (CLANG_TIDY_LLVM_* in .github/workflows/pr.yml);
# bumping it should touch this comment so the whole tree is re-checked.
#
# The runner does not pass -config-file, so clang-tidy discovers the nearest
# .clang-tidy per translation unit. A nested file with InheritParentConfig: true
# overrides only the keys it lists (src/ui/desktop/ keeps Qt-style method names).
#
# bugprone-easily-swappable-parameters - too many warnings to be actionable
# bugprone-exception-escape - fires inside gmock MATCHER_P expansions, gmock's
#   own matchers and Qt headers, none of which we can change
# bugprone-throwing-static-initialization - can't be enabled due to googletest
# bugprone-unchecked-optional-access - googletest 1.18 expands ASSERT_TRUE through
#   an AssertionResultExpectation aggregate that clang's dataflow cannot follow, so
#   no `ASSERT_TRUE(opt.has_value())` counts as a guard and every later `*opt` in a
#   test is reported (85 test files use the idiom). LLVM 23 followed the googletest
#   1.17 expansion. Re-enable once clang models the 1.18 form.
# clang-analyzer-cplusplus.NewDeleteLeaks - false positives on Qt parent-owned
#   `new` (layouts and widgets handed to a parent are never leaked)
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-throwing-static-initialization,
  -bugprone-unchecked-optional-access,
  clang-analyzer-*,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  modernize-avoid-c-arrays,
  modernize-deprecated-headers,
  performance-avoid-endl,
  readability-braces-around-statements,
  readability-container-size-empty,
  readability-duplicate-include,
  readability-identifier-naming,
  readability-redundant-member-init,
  readability-simplify-boolean-expr,
  readability-uppercase-literal-suffix,
  readability-use-anyofallof

WarningsAsErrors: >
  *,
  -custom-fastecu-result-assertion,
  -custom-fastecu-container-assertion,
  -custom-fastecu-message-concatenation
HeaderFilterRegex: 'src/(algorithms|backend|platform|ui)/.*\.h'
# workaround for the issue with separators normalization
ExcludeHeaderFilterRegex: '([/\\\\]generated_ui[/\\\\].*|_replica)\.h'
FormatStyle: none
CheckOptions:
  # LLVM 23 added this option with a default of false, which flags the literal
  # in `x >> 1` and `x & 0x100` even when x is unsigned. LLVM 22 never did;
  # keep that. Signed variables are still reported.
  - key: bugprone-signed-bitwise.IgnorePositiveIntegerLiterals
    value: true
  - key: readability-braces-around-statements.ShortStatementLines
    value: '1'
  - key: modernize-deprecated-headers.CheckHeaderFile
    value: True
  # Google C++ style, adopted one identifier kind at a time (#49); see the
  # Naming section of docs/coding-style.md.
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  # Google's exception: an underscore may separate words only where
  # capitalization cannot, i.e. next to a digit (kFlashBlocksSH7058_1block).
  # Every underscore sits in a token holding its digit neighbour, so no name
  # can end on one or contain "__". A matching name skips the check entirely,
  # which is why the pattern itself spells out the k prefix and CamelCase.
  - key: readability-identifier-naming.ConstexprVariableIgnoredRegexp
    value: '^k[A-Z]([A-Za-z0-9]|_?[0-9]_[A-Za-z]|_[0-9])*$'
  - key: readability-identifier-naming.TypeTemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k
  - key: readability-identifier-naming.ClassConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ClassConstantPrefix
    value: k
  - key: readability-identifier-naming.ClassMemberCase
    value: lower_case
  - key: readability-identifier-naming.ClassMemberSuffix
    value: _
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.UnionCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  # Same digit-adjacent underscore allowance as constexpr variables
  # (SubaruDensoSh7055_02Executor): capitalization cannot separate a digit run.
  - key: readability-identifier-naming.ClassIgnoredRegexp
    value: '^[A-Z]([A-Za-z0-9]|_?[0-9]_[A-Za-z]|_[0-9])*$'
  # Struct names: same digit-adjacent underscore allowance as classes.
  - key: readability-identifier-naming.StructIgnoredRegexp
    value: '^[A-Z]([A-Za-z0-9]|_?[0-9]_[A-Za-z]|_[0-9])*$'
  # Type alias names: same digit-adjacent underscore allowance as classes.
  - key: readability-identifier-naming.TypeAliasIgnoredRegexp
    value: '^[A-Z]([A-Za-z0-9]|_?[0-9]_[A-Za-z]|_[0-9])*$'
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  # Ui is generated by uic and forward-declared by our headers.
  - key: readability-identifier-naming.NamespaceIgnoredRegexp
    value: '^Ui$'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: _
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  # Same digit-adjacent underscore allowance as constexpr variables.
  - key: readability-identifier-naming.GlobalConstantIgnoredRegexp
    value: '^k[A-Z]([A-Za-z0-9]|_?[0-9]_[A-Za-z]|_[0-9])*$'
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case
  # Deviation from Google style, which has no prefix for globals: `g_` marks
  # mutable namespace-scope state at the use site.
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: g_
  # Deviation from Google style: public data members of structs carry no
  # trailing underscore (unlike private/protected members of classes).
  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.MethodCase
    value: CamelCase
  # Google style names const/constexpr values with a k prefix only where the
  # value is fixed for the program's duration; per-call const parameters stay
  # plain variables.
  - key: readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key: readability-identifier-naming.StaticConstantPrefix
    value: k
  - key: readability-identifier-naming.StaticConstantIgnoredRegexp
    value: '^k[A-Z]([A-Za-z0-9]|_?[0-9]_[A-Za-z]|_[0-9])*$'
  - key: readability-identifier-naming.StaticVariableCase
    value: lower_case
  - key: readability-identifier-naming.ConstantParameterCase
    value: lower_case
  - key: readability-identifier-naming.ParameterPackCase
    value: lower_case
  - key: readability-identifier-naming.TemplateTemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.ConceptCase
    value: CamelCase
  # Google: macros are UPPER_CASE with a project prefix where practical.
  # `#define private public` in tests is a keyword override, not a macro name.
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '^(private|protected)$'
  # gmock's `_` wildcard matcher (`using ::testing::_;`) is the one reserved
  # identifier this tree has to name.
  - key: bugprone-reserved-identifier.AllowedIdentifiers
    value: '_'

# Diagnostic-only repository conventions. The Bazel runner enables these in
# a separate advisory pass with a wider first-party header filter. Keeping
# them out of Checks above preserves the built-in pass's enforcement scope.
# LLVM prefixes each Name with custom-. Use the registered name when enabling
# a check or excluding it from WarningsAsErrors.
CustomChecks:
# Match the direct operand of GoogleTest's AssertionResult construction.
# Following only transparent wrappers and logical negation excludes unrelated
# nested calls/aggregates while retaining direct assertions inside callbacks.
  - Name: fastecu-result-assertion
    Query: |
      match cxxConstructExpr(
        hasType(
          recordType(hasDeclaration(cxxRecordDecl(hasName("::testing::AssertionResult"))))
        ),
        anyOf(
          isExpandedFromMacro("EXPECT_TRUE"),
          isExpandedFromMacro("EXPECT_FALSE"),
          isExpandedFromMacro("ASSERT_TRUE"),
          isExpandedFromMacro("ASSERT_FALSE")
        ),
        hasArgument(
          0,
          ignoringImplicit(
            ignoringParenImpCasts(
              anyOf(
                cxxMemberCallExpr(
                  callee(
                    cxxMethodDecl(
                      hasName("has_value"),
                      ofClass(
                        classTemplateSpecializationDecl(
                          hasName("::std::expected"),
                          hasTemplateArgument(
                            1,
                            refersToType(recordType(hasDeclaration(cxxRecordDecl(hasName("::fastecu::Error")))))
                          )
                        )
                      )
                    )
                  )
                ).bind("assertion"),
                unaryOperator(
                  hasOperatorName("!"),
                  hasUnaryOperand(
                    ignoringImplicit(
                      ignoringParenImpCasts(
                        cxxMemberCallExpr(
                          callee(
                            cxxMethodDecl(
                              hasName("has_value"),
                              ofClass(
                                classTemplateSpecializationDecl(
                                  hasName("::std::expected"),
                                  hasTemplateArgument(
                                    1,
                                    refersToType(recordType(hasDeclaration(cxxRecordDecl(hasName("::fastecu::Error")))))
                                  )
                                )
                              )
                            )
                          )
                        ).bind("assertion")
                      )
                    )
                  )
                )
              )
            )
          )
        ),
        unless(isExpansionInFileMatching("(^|.*[/\\\\])src[/\\\\]backend[/\\\\]ports[/\\\\]result_test[.]cpp$"))
      )
    Diagnostic:
      - BindName: assertion
        Message: 'assert Result/Status with IsOk(), IsErr(), or IsErrWith() rather than a bare boolean assertion'
        Level: Warning
  - Name: fastecu-container-assertion
    Query: |
      match cxxConstructExpr(
        hasType(
          recordType(hasDeclaration(cxxRecordDecl(hasName("::testing::AssertionResult"))))
        ),
        anyOf(
          isExpandedFromMacro("EXPECT_TRUE"),
          isExpandedFromMacro("EXPECT_FALSE"),
          isExpandedFromMacro("ASSERT_TRUE"),
          isExpandedFromMacro("ASSERT_FALSE")
        ),
        hasArgument(
          0,
          ignoringImplicit(
            ignoringParenImpCasts(
              anyOf(
                expr(
                  anyOf(
                    callExpr(
                      callee(functionDecl(hasAnyName("::std::all_of", "::std::any_of", "::std::none_of")))
                    ),
                    cxxOperatorCallExpr(
                      hasOverloadedOperatorName("()"),
                      hasArgument(
                        0,
                        ignoringParenImpCasts(
                          declRefExpr(
                            to(
                              varDecl(
                                hasAnyName("::std::ranges::all_of", "::std::ranges::any_of", "::std::ranges::none_of")
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                ).bind("assertion"),
                unaryOperator(
                  hasOperatorName("!"),
                  hasUnaryOperand(
                    ignoringImplicit(
                      ignoringParenImpCasts(
                        expr(
                          anyOf(
                            callExpr(
                              callee(functionDecl(hasAnyName("::std::all_of", "::std::any_of", "::std::none_of")))
                            ),
                            cxxOperatorCallExpr(
                              hasOverloadedOperatorName("()"),
                              hasArgument(
                                0,
                                ignoringParenImpCasts(
                                  declRefExpr(
                                    to(
                                      varDecl(
                                        hasAnyName("::std::ranges::all_of", "::std::ranges::any_of", "::std::ranges::none_of")
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        ).bind("assertion")
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    Diagnostic:
      - BindName: assertion
        Message: 'assert container properties with Google Mock matchers instead of reducing the predicate to a boolean'
        Level: Warning
  - Name: fastecu-message-concatenation
    Query: |
      match callExpr(
        anyOf(
          callee(functionDecl(hasName("::fastecu::Fail"))),
          callee(cxxMethodDecl(hasName("Log"), ofClass(cxxRecordDecl(hasName("::fastecu::IEventSink")))))
        ),
        hasArgument(1, ignoringParenImpCasts(anyOf(
          ignoringImplicit(cxxOperatorCallExpr(hasOverloadedOperatorName("+"),
            hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(
              cxxRecordDecl(hasName("::std::basic_string"))
            )))))),
          cxxMemberCallExpr(callee(cxxConversionDecl()),
            on(ignoringImplicit(cxxOperatorCallExpr(hasOverloadedOperatorName("+"),
              hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(
                cxxRecordDecl(hasName("::std::basic_string"))
              ))))
            )))
          )
        )))
      ).bind("message")
    Diagnostic:
      - BindName: message
        Message: 'construct this diagnostic message with std::format instead of string concatenation'
        Level: Warning
