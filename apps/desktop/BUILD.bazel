# The executable keeps the Qt binary macro through the existing mapping.
# gazelle:map_kind cc_binary qt_cc_binary //bazel:qt_targets.bzl
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
# Platform implementation files are selected by select() in the BUILD rules,
# so discovery must not treat any of them as a package source.
# gazelle:exclude default_config_root_unix.cpp
# gazelle:exclude default_config_root_windows.cpp
# gazelle:exclude startup_test_platform_macos.cpp
# gazelle:exclude startup_test_platform_other.cpp
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "qt_cc_binary")

# Only the root //:fastecu alias consumes this composition root.
package(default_visibility = ["//:__pkg__"])

# Builds and owns MainWindow's long-lived services. Private to this package.
cc_library(
    name = "composition",
    srcs = ["desktop_composition.cpp"],
    hdrs = ["desktop_composition.h"],
    copts = COMMON_COPTS,
    implementation_deps = [
        "//src/backend/config:builtin_catalog",
        "//src/platform/desktop/common/logging/runtime:logging_runtime",
        "//src/platform/desktop/common/logging/runtime:systemlogger",
        "//src/platform/desktop/common/remote_utility",
        "//src/platform/desktop/common/transport:logging_protocol_registration",
    ],
    visibility = ["//visibility:private"],
    deps = [
        # Composition provisions these resources; registration has no include.
        "//resources/shared:config_resource",  # keep
        "//resources/shared:kernels_resource",  # keep
        ":startup",
        "//bazel/qt:core",
        "//src/backend/calibration/session:calibration_workspace",
        "//src/backend/calibration/session:rom_open",
        "//src/backend/calibration/session:rom_save",
        "//src/backend/config:config_session",
        "//src/backend/definition:definition_service",
        "//src/backend/logging:logger_definition_service",
        "//src/backend/logging:logger_model",
        "//src/backend/ports",
        "//src/platform/desktop/common/connection:adapter_connection",
        "//src/platform/desktop/common/definition:definition_catalog_session",
        "//src/platform/desktop/common/ports",
        "//src/platform/desktop/common/ports/event_sink:qt_event_sink",
        "//src/platform/desktop/common/serial:desktop_serial_factory",
        "//src/ui/desktop:main_window_services",
        "//src/ui/desktop/channels:log_channel",
        "//src/ui/desktop/channels:remote_peer",
    ],
)

# Startup diagnostics and the platform's default configuration root, one
# source per platform. The select() cannot be inferred from an include, so the
# whole `srcs` expression is a narrow keep: a new source here is added by hand,
# and the platform-specific dependencies stay manually maintained.
cc_library(
    name = "startup",
    srcs = ["startup_diagnostics.cpp"] + select({
        "@platforms//os:windows": ["default_config_root_windows.cpp"],
        "//conditions:default": ["default_config_root_unix.cpp"],
    }),  # keep: per-OS source selection is hand-written
    hdrs = [
        "default_config_root.h",
        "startup_diagnostics.h",
        "startup_event_sink.h",
    ],
    copts = COMMON_COPTS,
    implementation_deps = ["//bazel/qt:widgets"],
    visibility = ["//visibility:private"],
    deps = [
        "//bazel/qt:core",
        "//src/backend/ports",
    ],
)

cc_library(
    name = "startup_test_platform",
    testonly = True,
    srcs = select({
        "@platforms//os:macos": ["startup_test_platform_macos.cpp"],
        "//conditions:default": ["startup_test_platform_other.cpp"],
    }),  # keep: per-OS source selection is hand-written
    hdrs = ["startup_test_platform.h"],
    copts = COMMON_COPTS,
    visibility = ["//visibility:private"],
    deps = ["//bazel/qt:core"],
)

fastecu_gtest(
    name = "startup_diagnostics_test",
    size = "small",
    srcs = ["startup_diagnostics_test.cpp"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [
        ":startup",
        ":startup_test_platform",
        "//bazel/qt:core",
        "//bazel/qt:widgets",
        "//src/platform/desktop/common/testing:widgets_application_environment",
        "@googletest//:gtest",
    ],
)

# Asks for a vehicle before MainWindow exists when none is selected. Private
# to this package.
cc_library(
    name = "startup_vehicle_gate",
    srcs = ["startup_vehicle_gate.cpp"],
    hdrs = ["startup_vehicle_gate.h"],
    visibility = ["//visibility:private"],
    deps = [
        "//src/backend/config:config_session",
        "//src/backend/ports",
    ],
)

fastecu_gtest(
    name = "startup_vehicle_gate_test",
    srcs = ["startup_vehicle_gate_test.cpp"],
    # The gate and the session are Qt-free; keep the test's closure free too.
    qt = False,
    deps = [
        ":startup_vehicle_gate",
        "//src/backend/config/testing:config_session_fixture",
        "@googletest//:gtest",
    ],
)

# The platform choice for the local serial backend, named by the binary. The
# OS selection is build configuration, so the alias is hand-owned.
alias(
    name = "direct_serial_backend",
    actual = select({
        "@platforms//os:windows": "//src/platform/desktop/common/serial/direct/windows:serial_port_actions_direct_windows",
        "//conditions:default": "//src/platform/desktop/common/serial/direct/unix:serial_port_actions_direct_unix",
    }),
    visibility = ["//visibility:private"],
)

fastecu_gtest(
    name = "desktop_composition_test",
    size = "small",
    srcs = ["desktop_composition_test.cpp"],
    deps = [
        # Selected implementation supplies the backend factory, without a direct include.
        ":direct_serial_backend",  # keep
        ":composition",
        ":startup",
        "//bazel/qt:core",
        "//src/backend/calibration/session:calibration_workspace",
        "//src/platform/desktop/common/definition:definition_catalog_session",
        "//src/platform/desktop/common/logging:logging_adapters",
        "//src/platform/desktop/common/logging/runtime:logging_runtime",
        "//src/platform/desktop/common/logging/runtime:systemlogger",
        "//src/platform/desktop/common/remote_utility",
        "//src/platform/desktop/common/testing:core_application_environment",
        "//src/platform/desktop/common/testing:event_helpers",
        "//src/platform/desktop/common/testing:signal_recorder",
        "//src/ui/desktop/channels:log_channel",
        "//src/ui/desktop/channels:remote_peer",
        "@googletest//:gtest",
    ],
)

qt_cc_binary(
    name = "fastecu",
    srcs = ["main.cpp"],
    deps = [
        # Selected implementation supplies the backend factory, without a direct include.
        ":direct_serial_backend",  # keep
        ":composition",
        ":startup",
        ":startup_vehicle_gate",
        "//bazel/qt:widgets",
        "//src/ui/desktop/widgets:desktop",
    ],
)
