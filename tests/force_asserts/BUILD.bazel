load("//bazel:qt_targets.bzl", "qt_cc_test", "qt_cpp_moc_headers")

package(default_visibility = ["//visibility:public"])

# Retained under tests/: this is a release-mode process probe whose contract
# is that QT_FORCE_ASSERTS aborts a child process even with QT_NO_DEBUG.

qt_cpp_moc_headers(
    name = "force_asserts_cpp_mocs",
    srcs = ["tst_force_asserts.cpp"],
    deps = ["@rules_qt//:qt_test"],
)

qt_cc_test(
    name = "tst_force_asserts",
    srcs = ["tst_force_asserts.cpp"],
    copts = [
        "-DQT_FORCE_ASSERTS",
        "-DQT_NO_DEBUG",
    ] + select({
        "@platforms//os:macos": [
            "-mmacosx-version-min=10.15",
            "-Wno-implicit-function-declaration",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":force_asserts_cpp_mocs",
        "@rules_qt//:qt_core",
        "@rules_qt//:qt_test",
    ],
)
