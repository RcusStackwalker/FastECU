# Tests regenerate; production sources and helper binaries retain existing owners.
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
load("//bazel:gtest_targets.bzl", "fastecu_gtest")

package(default_visibility = ["//visibility:private"])

# Retained under tests/: this is a release-mode process probe whose contract
# is that QT_FORCE_ASSERTS aborts a child process even with QT_NO_DEBUG.

fastecu_gtest(
    name = "tst_force_asserts_test",
    srcs = ["tst_force_asserts.cpp"],
    copts = [
        "-DQT_FORCE_ASSERTS",
        "-DQT_NO_DEBUG",
    ] + select({
        "@platforms//os:macos": [
            "-mmacosx-version-min=10.15",
            "-Wno-implicit-function-declaration",
        ],
        "//conditions:default": [],
    }),
    # The SonarCloud build-wrapper injects an interceptor library (DYLD_INSERT_LIBRARIES
    # on macOS) into every process it wraps so it can record compiler invocations. This
    # test's fork() duplicates only the calling thread, and if the interceptor's own
    # locks/threads are held at that instant, the child deadlocks trying to use them
    # before it ever reaches the deliberate abort() -- hanging the SonarCloud job for the
    # rest of its 6h runner timeout instead of failing. Excluded from the `sonar` config
    # in bazel/coverage.bazelrc; still runs under plain `bazel test` and local coverage runs.
    tags = ["no-sonar-build-wrapper"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//bazel/qt:core",
        "@googletest//:gtest",
    ],
)

# Preserve the public label when Gazelle discovers additional test sources.
# keep
test_suite(
    name = "tst_force_asserts",
    tests = [":tst_force_asserts_test"],
)
