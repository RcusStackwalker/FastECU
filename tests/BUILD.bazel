# Portable. Header-only test double for IKlineFlashTransport, consumed by
# //src/backend/flash/eeprom's kline executor test (a different package, so
# it needs a real label rather than being folded into a test's own srcs the
# way the mut_dma suites include their local scripted_*_transport.h helpers).
cc_library(
    name = "scripted_kline_flash_transport",
    testonly = True,
    hdrs = ["scripted_kline_flash_transport.h"],
    deps = ["//src/backend/flash:flash_executor"],
)

# Portable. Header-only test double for ICanFlashTransport, consumed by
# //src/backend/flash/eeprom's CAN executor test (step 5c, Task 9) -- same
# cross-package shape as :scripted_kline_flash_transport above.
cc_library(
    name = "scripted_can_flash_transport",
    testonly = True,
    hdrs = ["scripted_can_flash_transport.h"],
    deps = ["//src/backend/flash:flash_executor"],
)

# Portable. Relocated verbatim (step 5c, Task 8) from the now-deleted
# tests/test_eeprom_ecu_subaru_denso_sh705x_kline_operation_characterization.cpp
# -- this test never exercised that legacy operation class, only the real,
# checked-in resources/shared/config/protocols.cfg, so it survives that
# class's deletion as its own standalone target instead of going through the
# mut_dma_test_suites() macro built for the QThread-driven legacy suites.
cc_test(
    name = "test_protocols_cfg_eeprom_capabilities",
    size = "small",
    srcs = ["test_protocols_cfg_eeprom_capabilities.cpp"],
    data = ["//resources/shared:config/protocols.cfg"],
    env = {
        "PROTOCOLS_CFG_PATH": "$(location //resources/shared:config/protocols.cfg)",
    },
    deps = ["@googletest//:gtest_main"],
)
