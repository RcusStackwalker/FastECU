load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_test")
load("//bazel:x86_windows_transition.bzl", "x86_windows_binary")

package(default_visibility = ["//visibility:public"])

# Deliberately still a glob: check-openpty-includes.py globs this package
# for *.cpp at runtime looking for openpty() users to lint, so this
# filegroup must keep tracking whatever test files actually exist here.
filegroup(
    name = "cpp_sources",
    srcs = glob(["*.cpp"]),
)

# Windows-only process/ABI fixture: it must remain outside a production
# package because it is loaded by cross-bitness bridge integration tests.
cc_binary(
    name = "fake_j2534_dll_native",
    srcs = ["fake_j2534_dll.cpp"],
    additional_linker_inputs = ["fake_j2534_dll.def"],
    linkopts = ["/DEF:$(location fake_j2534_dll.def)"],
    linkshared = True,
    target_compatible_with = [
        "@platforms//cpu:x86_32",
        "@platforms//os:windows",
    ],
    deps = ["//src/platform/desktop/windows/j2534:j2534_bridge_protocol"],
)

x86_windows_binary(
    name = "fake_j2534_dll_x86",
    binary = ":fake_j2534_dll_native",
    extension = ".dll",
    target_compatible_with = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

WINDOWS_ONLY = select({
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Windows wire-format probe; assert() is its test protocol, so release builds
# explicitly re-enable assertions and retain the handwritten main.
cc_test(
    name = "j2534_bridge_protocol_test",
    srcs = ["j2534_bridge_protocol_test.cpp"],
    copts = ["/UNDEBUG"],
    target_compatible_with = WINDOWS_ONLY,
    deps = ["//src/platform/desktop/windows/j2534:j2534_bridge_protocol"],
)

# Cross-bitness PE probe with external x86/x64 fixtures and assert()-based
# process exit semantics; no single production package owns both fixtures.
cc_test(
    name = "pe_bitness_test",
    srcs = ["pe_bitness_test.cpp"],
    copts = ["/UNDEBUG"],
    data = [
        "//bazel/platforms:x86_smoke_test_x86",
        "//src/platform/desktop/windows/j2534:pe_bitness_x64_fixture",
    ],
    env = {
        "PE_BITNESS_X86_FIXTURE": "$(location //bazel/platforms:x86_smoke_test_x86)",
        "PE_BITNESS_X64_FIXTURE": "$(location //src/platform/desktop/windows/j2534:pe_bitness_x64_fixture)",
    },
    target_compatible_with = WINDOWS_ONLY,
    deps = ["//src/platform/desktop/windows/j2534:pe_bitness"],
)

J2534_PROCESS_DATA = [
    ":fake_j2534_dll_x86",
    "//src/platform/desktop/windows/j2534/j2534_bridge_host:j2534_bridge_host_x86",
]

J2534_PROCESS_ENV = {
    "FAKE_J2534_DLL_PATH": "$(location :fake_j2534_dll_x86)",
    "J2534_BRIDGE_HOST_EXE": "$(location //src/platform/desktop/windows/j2534/j2534_bridge_host:j2534_bridge_host_x86)",
}

# Cross-process x86 bridge integration probes retain handwritten mains and
# assertion flags because their observable contract is process/pipe behavior.
cc_test(
    name = "j2534_bridge_integration_test",
    srcs = ["j2534_bridge_integration_test.cpp"],
    copts = ["/UNDEBUG"],
    data = J2534_PROCESS_DATA,
    env = J2534_PROCESS_ENV,
    target_compatible_with = WINDOWS_ONLY,
    deps = ["//src/platform/desktop/windows/j2534:j2534_bridge_protocol"],
)

cc_test(
    name = "j2534_bridge_client_test",
    srcs = ["j2534_bridge_client_test.cpp"],
    copts = ["/UNDEBUG"],
    data = J2534_PROCESS_DATA,
    env = J2534_PROCESS_ENV,
    target_compatible_with = WINDOWS_ONLY,
    deps = ["//src/platform/desktop/windows/j2534:j2534_bridge_client"],
)

qt_cc_test(
    name = "j2534_win_bridge_test",
    srcs = ["j2534_win_bridge_test.cpp"],
    copts = COMMON_COPTS + ["/UNDEBUG"],
    data = J2534_PROCESS_DATA,
    env = J2534_PROCESS_ENV,
    target_compatible_with = WINDOWS_ONLY,
    deps = QT_DEPS + ["//src/platform/desktop/windows/j2534"],
)

UNIX_ONLY = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Real pseudo-terminal end-to-end probe crosses serial, J2534, and OS APIs.
fastecu_qttest(
    name = "serial_pty_e2e_test",
    src = "serial_pty_e2e_test.cpp",
    target_compatible_with = UNIX_ONLY,
    deps = [
        "//src/platform/desktop/common/serial:serial_qt_compat",
        "//src/platform/desktop/unix/j2534/testing:mock_openport",
    ],
)

# PTY/process integration intentionally remains centralized: it exercises
# algorithms, backend transports, serial I/O, cancellation, and J2534 together.
fastecu_qttest(
    name = "mut_dma_integration_tests",
    src = "tst_mut_dma_integration.cpp",
    target_compatible_with = UNIX_ONLY,
    deps = [
        "//src/algorithms/protocol",
        "//src/algorithms/protocol:qt_compat",
        "//src/algorithms/protocol/mut_dma",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/backend/protocol",
        "//src/platform/desktop/common/serial:serial_qt_compat",
        "//src/platform/desktop/common/transport",
        "//src/platform/desktop/unix/j2534/testing:mock_openport",
    ],
)

# Crash/teardown probe requires a real PTY and Unix J2534 process boundary.
fastecu_qttest(
    name = "serial_crash_tests",
    src = "tst_serial_port_crash.cpp",
    target_compatible_with = UNIX_ONLY,
    deps = [
        "//src/platform/desktop/common/serial:serial_qt_compat",
        "//src/platform/desktop/unix/j2534",
        "//src/platform/desktop/unix/j2534/testing:mock_openport",
    ],
)
