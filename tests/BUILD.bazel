load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

# Tests regenerate; production sources and helper binaries retain existing owners.
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
# gazelle:exclude fake_j2534_dll.cpp
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:x86_windows_transition.bzl", "x86_windows_binary")

package(default_visibility = ["//visibility:private"])

# Windows-only process/ABI fixture: it must remain outside a production
# package because it is loaded by cross-bitness bridge integration tests.
# The shared-library DLL fixture is a native cc_binary with a module-definition
# file and x86-only constraints, which Gazelle cannot infer; it stays hand-owned.
# keep
cc_binary(
    name = "fake_j2534_dll_native",
    srcs = ["fake_j2534_dll.cpp"],
    additional_linker_inputs = ["fake_j2534_dll.def"],
    linkopts = ["/DEF:$(location fake_j2534_dll.def)"],
    linkshared = True,
    target_compatible_with = [
        "@platforms//cpu:x86_32",
        "@platforms//os:windows",
    ],
    deps = ["//src/platform/desktop/windows/j2534:j2534_bridge_protocol"],
)

# Platform-transition wrapper around the DLL fixture above; not a C++ rule
# Gazelle generates.
x86_windows_binary(
    name = "fake_j2534_dll_x86",
    binary = ":fake_j2534_dll_native",
    extension = ".dll",
    target_compatible_with = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

WINDOWS_ONLY = select({
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Windows wire-format probe.
fastecu_gtest(
    name = "j2534_bridge_protocol_test",
    srcs = ["j2534_bridge_protocol_test.cpp"],
    qt = False,
    target_compatible_with = WINDOWS_ONLY,
    deps = [
        "//src/platform/desktop/windows/j2534:j2534_bridge_protocol",
        "@googletest//:gtest",
    ],
)

# Cross-bitness PE probe with external x86/x64 fixtures; no single production
# package owns both.
fastecu_gtest(
    name = "pe_bitness_test",
    srcs = ["pe_bitness_test.cpp"],
    data = [
        "//bazel/platforms:x86_smoke_test_x86",
        "//src/platform/desktop/windows/j2534:pe_bitness_x64_fixture",
    ],
    env = {
        "PE_BITNESS_X86_FIXTURE": "$(location //bazel/platforms:x86_smoke_test_x86)",
        "PE_BITNESS_X64_FIXTURE": "$(location //src/platform/desktop/windows/j2534:pe_bitness_x64_fixture)",
    },
    qt = False,
    target_compatible_with = WINDOWS_ONLY,
    deps = [
        "//src/platform/desktop/windows/j2534:pe_bitness",
        "@googletest//:gtest",
    ],
)

J2534_PROCESS_DATA = [
    ":fake_j2534_dll_x86",
    "//src/platform/desktop/windows/j2534/j2534_bridge_host:j2534_bridge_host_x86",
]

J2534_PROCESS_ENV = {
    "FAKE_J2534_DLL_PATH": "$(location :fake_j2534_dll_x86)",
    "J2534_BRIDGE_HOST_EXE": "$(location //src/platform/desktop/windows/j2534/j2534_bridge_host:j2534_bridge_host_x86)",
}

# Cross-process x86 bridge integration probe; its observable contract is
# process/pipe behavior.
fastecu_gtest(
    name = "j2534_bridge_integration_test",
    srcs = ["j2534_bridge_integration_test.cpp"],
    data = J2534_PROCESS_DATA,
    env = J2534_PROCESS_ENV,
    qt = False,
    target_compatible_with = WINDOWS_ONLY,
    deps = [
        "//src/platform/desktop/windows/j2534:j2534_bridge_protocol",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "j2534_bridge_client_test",
    srcs = ["j2534_bridge_client_test.cpp"],
    data = J2534_PROCESS_DATA,
    env = J2534_PROCESS_ENV,
    qt = False,
    target_compatible_with = WINDOWS_ONLY,
    deps = [
        "//src/platform/desktop/windows/j2534:j2534_bridge_client",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "j2534_win_bridge_test",
    srcs = ["j2534_win_bridge_test.cpp"],
    data = J2534_PROCESS_DATA,
    env = J2534_PROCESS_ENV,
    qt = True,
    target_compatible_with = WINDOWS_ONLY,
    deps = [
        "//src/platform/desktop/windows/j2534",
        "@googletest//:gtest",
    ],
)

UNIX_ONLY = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Real pseudo-terminal end-to-end probe crosses serial, J2534, and OS APIs.
fastecu_gtest(
    name = "serial_pty_e2e_test",
    srcs = ["serial_pty_e2e_test.cpp"],
    target_compatible_with = UNIX_ONLY,
    deps = [
        # The real direct backend is linked at runtime, not included.
        "//src/platform/desktop/common/serial:direct_serial_backend_for_tests",  # keep
        "//src/platform/desktop/common/serial:direct_serial_backend",
        "//src/platform/desktop/common/serial/facade:serial_port_actions",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)

# PTY/process integration intentionally remains centralized: it exercises
# algorithms, backend transports, serial I/O, cancellation, and J2534 together.
fastecu_gtest(
    name = "mut_dma_integration_tests_test",
    srcs = ["tst_mut_dma_integration.cpp"],
    target_compatible_with = UNIX_ONLY,
    deps = [
        # The real direct backend is linked at runtime, not included.
        "//src/platform/desktop/common/serial:direct_serial_backend_for_tests",  # keep
        "//bazel/qt:core",
        "//src/algorithms/protocol/mut_dma",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/backend/protocol",
        "//src/platform/desktop/common/bytes:qt_bytes",
        "//src/platform/desktop/common/serial:direct_serial_backend",
        "//src/platform/desktop/common/serial/facade:serial_port_actions",
        "//src/platform/desktop/common/testing:core_application_environment",
        "//src/platform/desktop/common/testing:event_helpers",
        "//src/platform/desktop/common/transport",
        "@googletest//:gtest",
    ],
)

# Crash/teardown probe requires a real PTY and Unix J2534 process boundary.
fastecu_gtest(
    name = "serial_crash_tests_test",
    srcs = ["tst_serial_port_crash.cpp"],
    target_compatible_with = UNIX_ONLY,
    deps = [
        # The real direct backend is linked at runtime, not included.
        "//src/platform/desktop/common/serial:direct_serial_backend_for_tests",  # keep
        "//bazel/qt:core",
        "//src/platform/desktop/common/serial/direct:serial_port_actions_direct",
        "//src/platform/desktop/common/testing:core_application_environment",
        "//src/platform/desktop/unix/j2534/driver:j2534",
        "//src/platform/desktop/unix/j2534/testing:mock_openport",
        "@googletest//:gtest",
    ],
)

# The built-in catalog against checksum routing, the kernel bundle and the
# flash memory models; no single production package owns all four.
fastecu_gtest(
    name = "catalog_consistency_test",
    srcs = ["catalog_consistency_test.cpp"],
    data = ["//resources/shared:kernel_files"],
    env = {"KERNEL_FILES": "$(locations //resources/shared:kernel_files)"},
    qt = False,
    deps = [
        "//src/backend/checksum:dispatch",
        "//src/backend/config:builtin_catalog",
        "//src/backend/flash:flash_device_lookup",
        "@googletest//:gtest",
    ],
)
