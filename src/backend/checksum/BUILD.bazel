load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "checksum_selection",
    hdrs = ["checksum_selection.h"],
    deps = ["//src/algorithms/checksum"],
)

cc_library(
    name = "dispatch",
    srcs = ["dispatch.cpp"],
    hdrs = ["dispatch.h"],
    deps = [
        ":checksum_selection",
        "//src/algorithms/checksum",
        "//src/backend/flash:flash_device_lookup",
    ],
)

fastecu_portable_gtest(
    name = "dispatch_test",
    srcs = ["dispatch_test.cpp"],
    deps = [":dispatch"],
)
