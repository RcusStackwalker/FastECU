load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = ["//bazel/layers:backend_and_above"])

cc_library(
    name = "checksum_selection",
    hdrs = ["checksum_selection.h"],
    deps = [
        "//src/algorithms/checksum",
        "//src/algorithms/protocol",
    ],
)

cc_library(
    name = "dispatch",
    srcs = ["dispatch.cpp"],
    hdrs = ["dispatch.h"],
    implementation_deps = [
        "//src/algorithms/checksum",
        "//src/algorithms/memory:address",
        "//src/algorithms/memory:memory_error",
        "//src/backend/flash:flash_device_lookup",
    ],
    deps = [
        ":checksum_selection",
        "//src/algorithms/memory:memory_image",
    ],
)

fastecu_portable_gtest(
    name = "dispatch_test",
    srcs = ["dispatch_test.cpp"],
    deps = [
        ":dispatch",
        "//src/algorithms/memory:memory_image",
        "//src/algorithms/memory:memory_map",
        "//src/algorithms/memory/testing:memory_views",
        "//src/algorithms/protocol/testing:byte_matchers",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "catalog_checksum_agreement_test",
    srcs = ["catalog_checksum_agreement_test.cpp"],
    deps = [
        ":checksum_selection",
        ":dispatch",
        "//src/algorithms/memory:address",
        "//src/algorithms/memory:memory_image",
        "//src/algorithms/memory:memory_map",
        "//src/algorithms/protocol",
        "//src/backend/config:builtin_catalog",
        "//src/backend/config:catalog",
        "//src/backend/flash:flash_device_lookup",
        "@googletest//:gtest",
    ],
)
