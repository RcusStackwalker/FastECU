load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "COMMON_COPTS", "QT_DEPS_NO_WIDGETS")

# The Qt-typed half of //src/backend/config, in its own package so that one
# stays free of Qt by visibility rather than by a source scan -- see
# docs/adr/0016-enforce-qt-reachability-by-visibility.md. Visible only to
# packages that may themselves hold Qt.
package(default_visibility = ["//bazel/qt:qt_layer"])

# Qt-linked (FileActions::ConfigValuesStructure is Qt-typed). Explicit srcs so
# this neither collides with nor is swept into
# //src/backend/definitions:definitions's glob.
#
# Depends on //src/backend/definitions:config_values (the extracted value
# struct), not the full //src/backend/definitions target: FileActions owns a
# LegacyConfigAdapter member, so a dependency on the full `definitions` target
# here would form a hard Bazel cycle with `definitions`'s own dependency on
# `legacy_config_adapter`. config_values is a leaf with no dependency on
# `definitions`, so both can depend on it without cycling. See
# config_values.h's comment for the full rationale.
cc_library(
    name = "legacy_config_adapter",
    srcs = ["legacy_config_adapter.cpp"],
    hdrs = ["legacy_config_adapter.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS_NO_WIDGETS + [
        ":legacy_config_paths",
        "//src/backend/config:app_config",
        "//src/backend/config:car_model_catalog",
        "//src/backend/config:config_paths",
        "//src/backend/config:protocol_catalog",
        "//src/backend/config:provisioning",
        "//src/backend/definitions:config_values",
        "//src/backend/ports",
    ],
)

fastecu_gtest(
    name = "test_legacy_config_adapter",
    srcs = ["legacy_config_adapter_test.cpp"],
    deps = [
        ":legacy_config_adapter",
        "//src/backend/definitions",
        "//src/backend/ports",
        "//src/backend/ports/testing:in_memory_file_repository",
        "//src/backend/ports/testing:in_memory_file_system",
        "//src/backend/ports/testing:in_memory_resource_bundle",
    ],
)

# Qt-linked (ConfigValuesStructure's fields are QString). Depends on
# //src/backend/definitions:config_values, the extracted leaf value struct,
# not the full //src/backend/definitions target, for the same cycle-avoidance
# reason legacy_config_adapter documents above.
cc_library(
    name = "legacy_config_paths",
    srcs = ["legacy_config_paths.cpp"],
    hdrs = ["legacy_config_paths.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS_NO_WIDGETS + [
        "//src/backend/config:config_paths",
        "//src/backend/definitions:config_values",
    ],
)

fastecu_gtest(
    name = "test_legacy_config_paths",
    srcs = ["legacy_config_paths_test.cpp"],
    deps = [":legacy_config_paths"],
)
