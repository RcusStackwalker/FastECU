# Qt-linked (FileActions::ConfigValuesStructure is Qt-typed). Explicit srcs so
# this neither collides with nor is swept into
# //src/backend/definitions:definitions's glob. legacy_config_adapter.h
# declares no QObject/Q_OBJECT, so it goes through normal_hdrs rather than
# hdrs (which would run it through moc unconditionally) -- same convention as
# src/platform/desktop/common/transport/BUILD.bazel's flash_transports.
#
# Depends on //src/backend/definitions:config_values (the extracted value
# struct), not the full //src/backend/definitions target: FileActions owns a
# LegacyConfigAdapter member (wired in Task 11), so a dependency on the full
# `definitions` target here would form a hard Bazel cycle with
# `definitions`'s own dependency on `legacy_config_adapter`. config_values is
# a leaf with no dependency on `definitions`, so both can depend on it
# without cycling. See config_values.h's comment for the full rationale.
qt_cc_library(
    name = "legacy_config_adapter",
    srcs = ["legacy_config_adapter.cpp"],
    hdrs = [],
    copts = COMMON_COPTS,
    normal_hdrs = ["legacy_config_adapter.h"],
    deps = QT_DEPS + [
        ":app_config",
        ":car_model_catalog",
        ":config_paths",
        ":legacy_config_paths",
        ":protocol_catalog",
        ":provisioning",
        "//src/backend/definitions:config_values",
        "//src/backend/ports",
    ],
)

# Qt-linked (ConfigValuesStructure's fields are QString), so NOT portable and
# never in PORTABLE_ROOTS. Depends on :config_values (the extracted leaf value
# struct), not the full //src/backend/definitions target, for the same
# cycle-avoidance reason legacy_config_adapter documents above.
qt_cc_library(
    name = "legacy_config_paths",
    srcs = ["legacy_config_paths.cpp"],
    hdrs = [],
    copts = COMMON_COPTS,
    normal_hdrs = ["legacy_config_paths.h"],
    deps = QT_DEPS + [
        ":config_paths",
        "//src/backend/definitions:config_values",
    ],
)
