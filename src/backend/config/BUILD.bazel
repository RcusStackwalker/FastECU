load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = ["//bazel/layers:backend_and_above"])

cc_library(
    name = "config_paths",
    srcs = ["config_paths.cpp"],
    hdrs = ["config_paths.h"],
)

fastecu_portable_gtest(
    name = "config_paths_test",
    srcs = ["config_paths_test.cpp"],
    deps = [
        ":config_paths",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "provisioning",
    srcs = ["provisioning.cpp"],
    hdrs = ["provisioning.h"],
    deps = [
        ":config_paths",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "provisioning_test",
    srcs = ["provisioning_test.cpp"],
    deps = [
        ":provisioning",
        "//src/backend/ports/testing:in_memory_file_repository",
        "//src/backend/ports/testing:in_memory_file_system",
        "//src/backend/ports/testing:in_memory_resource_bundle",
        "//src/backend/ports/testing:recording_event_sink",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "app_config",
    srcs = ["app_config.cpp"],
    hdrs = ["app_config.h"],
    implementation_deps = ["@pugixml"],
    deps = [
        ":config_paths",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "app_config_test",
    srcs = ["app_config_test.cpp"],
    deps = [
        ":app_config",
        "//src/backend/ports/testing:in_memory_file_repository",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

# Shared by the two catalogs that load protocols.cfg; pugixml stays out of
# their public headers, so this target is package-private.
cc_library(
    name = "protocols_document",
    srcs = ["protocols_document.cpp"],
    hdrs = ["protocols_document.h"],
    visibility = ["//visibility:private"],
    deps = [
        ":config_paths",
        "//src/backend/ports",
        "@pugixml",
    ],
)

fastecu_portable_gtest(
    name = "protocols_document_test",
    srcs = ["protocols_document_test.cpp"],
    deps = [
        ":protocols_document",
        "//src/backend/ports/testing:in_memory_file_repository",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
        "@pugixml",
    ],
)

cc_library(
    name = "protocol_catalog",
    srcs = ["protocol_catalog.cpp"],
    hdrs = ["protocol_catalog.h"],
    implementation_deps = [
        ":protocols_document",
        "@pugixml",
    ],
    deps = [
        ":config_paths",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "protocol_catalog_test",
    srcs = ["protocol_catalog_test.cpp"],
    data = ["//resources/shared:config/protocols.cfg"],
    env = {
        "PROTOCOLS_CFG_PATH": "$(location //resources/shared:config/protocols.cfg)",
    },
    deps = [
        ":protocol_catalog",
        "//src/backend/ports/testing:in_memory_file_repository",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "car_model_catalog",
    srcs = ["car_model_catalog.cpp"],
    hdrs = ["car_model_catalog.h"],
    implementation_deps = [
        ":protocols_document",
        "@pugixml",
    ],
    deps = [
        ":config_paths",
        ":protocol_catalog",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "car_model_catalog_test",
    srcs = ["car_model_catalog_test.cpp"],
    data = ["//resources/shared:config/protocols.cfg"],
    env = {
        "PROTOCOLS_CFG_PATH": "$(location //resources/shared:config/protocols.cfg)",
    },
    deps = [
        ":car_model_catalog",
        "//src/backend/ports/testing:in_memory_file_repository",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "config_session",
    srcs = ["config_session.cpp"],
    hdrs = ["config_session.h"],
    implementation_deps = [":provisioning"],
    # The package default plus the composition root that owns the session.
    visibility = [
        "//bazel/layers:apps_desktop",
        "//bazel/layers:backend_and_above",
    ],
    deps = [
        ":app_config",
        ":catalog",
        ":config_paths",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "config_session_test",
    srcs = ["config_session_test.cpp"],
    deps = [
        ":builtin_catalog",
        ":config_session",
        "//src/backend/config/testing:config_session_fixture",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "catalog_test",
    srcs = ["catalog_test.cpp"],
    deps = [
        ":catalog",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "catalog",
    srcs = ["catalog.cpp"],
    hdrs = ["catalog.h"],
    # The package default plus the composition root, which hands a catalog
    # to the configuration session.
    visibility = [
        "//bazel/layers:apps_desktop",
        "//bazel/layers:backend_and_above",
    ],
)

cc_library(
    name = "builtin_catalog",
    srcs = ["builtin_catalog.cpp"],
    hdrs = ["builtin_catalog.h"],
    # Only the composition root hands the built-in catalog on; tests that
    # check it against other packages name it too.
    visibility = [
        "//bazel/layers:apps_desktop",
        "//bazel/layers:tests",
    ],
    deps = [":catalog"],
)

fastecu_portable_gtest(
    name = "builtin_catalog_test",
    srcs = ["builtin_catalog_test.cpp"],
    deps = [
        ":builtin_catalog",
        "@googletest//:gtest",
    ],
)

# Temporary: compares the catalog with the protocols.cfg it was generated from.
fastecu_portable_gtest(
    name = "builtin_catalog_parity_test",
    srcs = ["builtin_catalog_parity_test.cpp"],
    data = ["//resources/shared:config/protocols.cfg"],
    env = {
        "PROTOCOLS_CFG_PATH": "$(location //resources/shared:config/protocols.cfg)",
    },
    deps = [
        ":builtin_catalog",
        "@googletest//:gtest",
        "@pugixml",
    ],
)
