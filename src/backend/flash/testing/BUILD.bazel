load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//bazel/layers:apps_bench",
    "//bazel/layers:src",
])

cc_library(
    name = "scripted_flash_transports",
    testonly = True,
    hdrs = [
        "faulting_can_flash_transport.h",
        "faulting_kline_flash_transport.h",
        "scripted_can_flash_transport.h",
        "scripted_flash_transport_state.h",
        "scripted_kline_flash_transport.h",
        "scripted_mixed_can_flash_transport.h",
    ],
    deps = ["//src/backend/flash:flash_executor"],
)

fastecu_portable_gtest(
    name = "scripted_flash_transports_test",
    srcs = ["scripted_flash_transports_test.cpp"],
    deps = [
        ":scripted_flash_transports",
        "//src/algorithms/protocol/testing:byte_matchers",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "flash_printers",
