package(default_visibility = [
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

# root //:portable_closure reads this file as `data` to check that portable
# flash targets stay Qt-free; that reference is plumbing, not a layer
# dependency, so export it to the root package specifically rather than
# widen the package's general default_visibility.
exports_files(
    ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

# Portable. No Qt, no platform, no filesystem, no thread. Leaf types header
# with no dependency on flash_types.h/flash_plan.h -- flash_types.h includes
# these to assemble FamilyPlan, so the dependency only ever runs this way.
cc_library(
    name = "mitsu_colt_m32r_can_types",
    hdrs = ["mitsu_colt_m32r_can_types.h"],
    deps = ["//src/algorithms/protocol"],
)

