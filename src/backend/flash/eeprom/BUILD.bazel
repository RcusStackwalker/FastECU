fastecu_portable_gtest(
    name = "denso_sh705x_eeprom_can_executor_test",
    srcs = ["denso_sh705x_eeprom_can_executor_test.cpp"],
    deps = [
        ":denso_sh705x_eeprom_common",
        ":denso_sh705x_eeprom_can",
        "//src/backend/ports",
        "//tests:scripted_can_flash_transport",
        # For WrongConcreteTransportTypeReturnsInvalidConfigWithNoIo, which
        # deliberately passes a K-Line-shaped fake to prove the dynamic_cast
