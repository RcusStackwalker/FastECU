load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

# This package used to also host a legacy `eeprom` qt_cc_library target
# (built EepromEcuSubaruDensoSH705x{Kline,Can}Operation). Step 5c/Task 8
# deleted the K-Line operation file; this task (Task 9) deletes the last
# remaining source (the CAN operation), so the legacy target -- which would
# now glob zero sources -- has been removed entirely. This package is fully
# portable: no Qt, no platform, no filesystem, no thread in any target below.

# Portable. No Qt, no platform, no filesystem, no thread.
cc_library(
    name = "denso_sh705x_eeprom_common",
    srcs = ["denso_sh705x_eeprom_common.cpp"],
    hdrs = ["denso_sh705x_eeprom_common.h"],
    visibility = [
        "//src/backend/flash/eeprom:__subpackages__",
        "//src/platform:__subpackages__",
        "//tests:__pkg__",
    ],
    deps = [
        "//src/backend/flash:flash_plan",
        "//src/backend/flash:flash_types",
        "//src/backend/flash:flash_validation",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "denso_sh705x_eeprom_common_test",
    srcs = ["denso_sh705x_eeprom_common_test.cpp"],
    deps = [":denso_sh705x_eeprom_common"],
)

# Portable. No Qt, no platform, no filesystem, no thread.
cc_library(
    name = "denso_sh705x_eeprom_kline",
    srcs = ["denso_sh705x_eeprom_kline_executor.cpp"],
    hdrs = ["denso_sh705x_eeprom_kline_executor.h"],
    visibility = [
        "//src/platform:__subpackages__",
        # The rewritten K-Line EEPROM dialog (step 5c, Task 17) constructs
        # DensoSh705xEepromKlineExecutor directly for its FlashWorker.
        "//src/ui/desktop/flash/eeprom:__pkg__",
        "//tests:__pkg__",
    ],
    deps = [
        ":denso_sh705x_eeprom_common",
        "//src/algorithms/protocol/ssm",
        "//src/backend/flash:flash_executor",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "denso_sh705x_eeprom_kline_executor_test",
    srcs = ["denso_sh705x_eeprom_kline_executor_test.cpp"],
    deps = [
        ":denso_sh705x_eeprom_common",
        ":denso_sh705x_eeprom_kline",
        "//src/backend/ports",
        "//tests:scripted_kline_flash_transport",
    ],
)

# Portable. No Qt, no platform, no filesystem, no thread.
cc_library(
    name = "denso_sh705x_eeprom_can",
    srcs = ["denso_sh705x_eeprom_can_executor.cpp"],
    hdrs = ["denso_sh705x_eeprom_can_executor.h"],
    visibility = [
        "//src/platform:__subpackages__",
        # The rewritten CAN EEPROM dialog (step 5c, Task 17) constructs
        # DensoSh705xEepromCanExecutor directly for its FlashWorker.
        "//src/ui/desktop/flash/eeprom:__pkg__",
        "//tests:__pkg__",
    ],
    deps = [
        ":denso_sh705x_eeprom_common",
        "//src/algorithms/protocol/ssm",
