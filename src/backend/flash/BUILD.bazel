load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

# Portable. No Qt, no platform, no filesystem, no thread.
cc_library(
    name = "flash_types",
    hdrs = ["flash_types.h"],
    deps = [
        "//src/algorithms/protocol",
        "//src/backend/flash/ecu:mitsu_colt_m32r_can_types",
        "//src/backend/flash/ecu:subaru_denso_mc68hc16y5_02_types",
        "//src/backend/flash/ecu:subaru_denso_sh7055_02_types",
        "//src/backend/flash/ecu:subaru_hitachi_m32r_can_types",
        "//src/backend/flash/ecu:subaru_hitachi_m32r_kline_types",
        "//src/backend/flash/ecu:subaru_mitsu_m32r_kline_types",
        "//src/backend/flash/ecu:subaru_tcu_cvt_hitachi_m32r_can_types",
        "//src/backend/flash/ecu:subaru_tcu_cvt_mitsu_mh8104_can_types",
        "//src/backend/flash/ecu:subaru_tcu_cvt_mitsu_mh8111_can_types",
        "//src/backend/flash/eeprom:denso_sh705x_eeprom_types",
    ],
)

fastecu_portable_gtest(
    name = "flash_types_test",
    srcs = ["flash_types_test.cpp"],
    deps = [":flash_types"],
)

