load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "COMMON_INCLUDES", "PORTABLE_COPTS", "QT_DEPS", "qt_cc_library")

package(default_visibility = [
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

# Portable. No Qt, no platform, no filesystem, no thread.
cc_library(
    name = "flash_types",
    hdrs = ["flash_types.h"],
    copts = PORTABLE_COPTS,
    deps = ["//src/algorithms/protocol"],
)

fastecu_portable_gtest(
    name = "flash_types_test",
    srcs = ["flash_types_test.cpp"],
    deps = [":flash_types"],
)

# Portable. No Qt, no platform, no filesystem, no thread.
cc_library(
    name = "flash_plan",
    srcs = ["flash_plan.cpp"],
    hdrs = ["flash_plan.h"],
    copts = PORTABLE_COPTS,
    deps = [
        ":flash_types",
        "//src/backend/ports",
    ],
)

# Portable. No Qt, no platform, no filesystem, no thread.
cc_library(
    name = "flash_validation",
    srcs = ["flash_validation.cpp"],
    hdrs = ["flash_validation.h"],
    copts = PORTABLE_COPTS,
    deps = [
        ":flash_plan",
        ":flash_types",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "flash_validation_test",
    srcs = ["flash_validation_test.cpp"],
    deps = [":flash_validation"],
)

MOC_HDRS = ["flash_operation_worker.h"]

qt_cc_library(
    name = "flash",
    srcs = glob(["*.cpp"]),
    hdrs = MOC_HDRS,
    copts = COMMON_COPTS,
    includes = COMMON_INCLUDES,
    normal_hdrs = glob(
        ["*.h"],
        exclude = MOC_HDRS,
    ),
    deps = QT_DEPS + [
        "//src/algorithms/protocol",
        "//src/algorithms/protocol:qt_compat",
        "//src/backend/definitions:models",
        "//src/platform/desktop/common/serial:serial_qt_compat",
    ],
)
