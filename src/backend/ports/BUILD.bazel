load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//bazel/layers:apps_bench",
    # The desktop composition root's startup diagnostics present port errors.
    "//bazel/layers:apps_desktop",
    "//bazel/layers:backend_and_above",
])

cc_library(
    name = "ports",
    hdrs = [
        "atomic_file_writer.h",
        "cancellation.h",
        "clock.h",
        "duration_cast.h",
        "error.h",
        "event_sink.h",
        "file_repository.h",
        "file_system.h",
        "manual_cancellation_token.h",
        "resource_bundle.h",
        "result.h",
        "settings.h",
    ],
)

fastecu_portable_gtest(
    name = "result_test",
    srcs = ["result_test.cpp"],
    deps = [
        ":ports",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "manual_cancellation_token_test",
    srcs = ["manual_cancellation_token_test.cpp"],
    deps = [
        ":ports",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "duration_cast_test",
    srcs = ["duration_cast_test.cpp"],
    deps = [
        ":ports",
        "@googletest//:gtest",
    ],
)
