load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(
    default_testonly = True,
    default_visibility = [
        "//apps/bench:__pkg__",
        "//src:__subpackages__",
        "//tests:__pkg__",
    ],
)

cc_library(
    name = "fake_clock",
    hdrs = ["fake_clock.h"],
    deps = ["//src/backend/ports"],
)

