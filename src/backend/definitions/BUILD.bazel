load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "qt_cc_library")

package(default_visibility = [
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

MODEL_HDRS = [
    "kernelcomms.h",
    "kernelmemorymodels.h",
]

# ConfigValuesStructure, extracted out of FileActions (see config_values.h's
# comment). Kept out of `definitions`'s own normal_hdrs glob and given its
# own qt_cc_library, mirroring the MODEL_HDRS/`models` split above -- for the
# identical reason (avoiding a Bazel dependency cycle), this time with
# //src/backend/config:legacy_config_adapter rather than //src/backend/flash.
CONFIG_VALUES_HDRS = ["config_values.h"]

ECU_CAL_DEF_HDRS = ["ecu_cal_def.h"]

MOC_HDRS = ["file_actions.h"]

# root //:windows_preprocessor_guards reads this header directly as `data`;
# that reference is plumbing, not a layer dependency, so export it to the
# root package specifically rather than widen the package's general
# default_visibility.
exports_files(
    ["file_actions.h"],
    visibility = ["//:__pkg__"],
)

# Pure data headers, no project includes. Split out so that
# //src/backend/flash can depend on them without creating a
# definitions <-> flash cycle via flash_utils.h.
cc_library(
    name = "models",
    hdrs = MODEL_HDRS,
)

# Qt-typed (QString/QStringList/QDir members) but no QObject/Q_OBJECT, so
# (like legacy_config_adapter) it goes through normal_hdrs rather than hdrs.
qt_cc_library(
    name = "config_values",
    srcs = [],
    hdrs = [],
    copts = COMMON_COPTS,
    normal_hdrs = CONFIG_VALUES_HDRS,
    deps = QT_DEPS,
)

qt_cc_library(
    name = "ecu_cal_def",
    srcs = [],
    hdrs = [],
    copts = COMMON_COPTS,
    normal_hdrs = ECU_CAL_DEF_HDRS,
    deps = QT_DEPS,
)

qt_cc_library(
    name = "legacy_definition_columns",
    srcs = [],
    hdrs = [],
    copts = COMMON_COPTS,
    normal_hdrs = ["legacy_definition_columns.h"],
    visibility = [
        "//src/backend/definition:__pkg__",
        "//src/backend/definitions:__pkg__",
    ],
    deps = QT_DEPS + [":ecu_cal_def"],
)

qt_cc_library(
    name = "definitions",
    srcs = [
        "file_actions.cpp",
        "file_actions_ecuflash.cpp",
        "file_actions_romraider.cpp",
    ],
    hdrs = MOC_HDRS,
    copts = COMMON_COPTS,
    normal_hdrs = glob(
        ["*.h"],
        exclude = MOC_HDRS + MODEL_HDRS + CONFIG_VALUES_HDRS + ECU_CAL_DEF_HDRS,
    ),
    deps = QT_DEPS + [
        ":config_values",
        ":ecu_cal_def",
        ":legacy_definition_columns",
        ":models",
        "//resources/shared:config_resource",
        "//resources/shared:kernels_resource",
        # file_actions.cpp includes qt_dtc_parser.h/qt_nrc_parser.h directly
        # (its neg_rsp_codes/dtc_*_codes lookup tables are still QHash
        # statics defined in error_codes.h); not in the original plan's dep
        # list, added after checking the real #include graph (see
        # task-4-report.md, task-5-report.md).
        "//src/algorithms/diagnostics:qt_compat",
        "//src/algorithms/expression:qt_compat",
        "//src/backend/checksum:legacy_checksum_adapter",
        "//src/backend/checksum:flash_device_lookup",
        "//src/backend/config:legacy_config_adapter",
        "//src/backend/definition:definition_service",
        "//src/backend/definition:legacy_definition_adapter",
        "//src/backend/ports",
    ],
)
