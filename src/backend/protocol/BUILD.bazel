load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "protocol",
    srcs = [
        "imut_dma_init.cpp",
        "mitsu_colt_can_cdbg_driver.cpp",
        "mut_dma_driver.cpp",
    ],
    hdrs = [
        "ican_transport.h",
        "ikline_transport.h",
        "imut_dma_init.h",
        "issm_transport.h",
        "mitsu_colt_can_cdbg_driver.h",
        "mut_dma_driver.h",
        "transport_legacy_compat.h",
    ],
    deps = [
        ":cdbg_protocol_config",
        "//src/algorithms/protocol",
        "//src/algorithms/protocol/colt:mitsu_colt_can_cdbg_protocol",
        "//src/algorithms/protocol/mut_dma",
        "//src/backend/ports",
    ],
)

cc_library(
    name = "cdbg_protocol_config",
    srcs = ["cdbg_protocol_config.cpp"],
    hdrs = ["cdbg_protocol_config.h"],
    deps = [
        "//src/algorithms/protocol/colt:mitsu_colt_can_cdbg_protocol",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "cdbg_protocol_config_test",
    srcs = ["cdbg_protocol_config_test.cpp"],
    deps = [":cdbg_protocol_config"],
)

fastecu_portable_gtest(
    name = "test_init",
    srcs = ["init_test.cpp"],
    deps = [
        ":protocol",
        "//src/backend/protocol/testing:scripted_transports",
    ],
)

fastecu_portable_gtest(
    name = "test_driver",
    srcs = ["driver_test.cpp"],
    deps = [
        ":protocol",
        "//src/algorithms/protocol/mut_dma",
        "//src/algorithms/protocol/testing:byte_test_utils",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/backend/protocol/testing:scripted_transports",
    ],
)

fastecu_portable_gtest(
    name = "test_transport",
    srcs = ["transport_test.cpp"],
    deps = [
        ":protocol",
        "//src/algorithms/protocol/testing:byte_test_utils",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/backend/protocol/testing:scripted_transports",
    ],
)

fastecu_portable_gtest(
    name = "test_cdbg_driver",
    srcs = ["cdbg_driver_test.cpp"],
    deps = [
        ":cdbg_protocol_config",
        ":protocol",
        "//src/algorithms/protocol/testing:byte_test_utils",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/backend/protocol/testing:scripted_transports",
    ],
)
