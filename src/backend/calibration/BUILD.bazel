load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS_NO_WIDGETS", "fastecu_qttest", "qt_cc_library")

package(default_visibility = [
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "scaling_internal",
    srcs = ["scaling_internal.cpp"],
    hdrs = ["scaling_internal.h"],
    visibility = ["//src/backend/calibration:__pkg__"],
    deps = ["//src/algorithms/protocol"],
)

cc_library(
    name = "calibration_service",
    srcs = ["calibration_service.cpp"],
    hdrs = ["calibration_service.h"],
    deps = [
        ":scaling_internal",
        "//src/algorithms/expression",
        "//src/algorithms/protocol",
        "//src/backend/definition:definition_model",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "calibration_service_test",
    srcs = ["calibration_service_test.cpp"],
    deps = [
        ":calibration_service",
        "//src/backend/ports/testing:in_memory_file_repository",
    ],
)

cc_library(
    name = "map_edit",
    srcs = ["map_edit.cpp"],
    hdrs = ["map_edit.h"],
    deps = [
        ":scaling_internal",
        "//src/algorithms/expression",
        "//src/algorithms/protocol",
        "//src/backend/definition:definition_model",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "map_edit_test",
    srcs = ["map_edit_test.cpp"],
    deps = [":map_edit"],
)

# Qt-linked (EcuCalDefStructure/ConfigValuesStructure are Qt-typed). Explicit
# srcs so this neither collides with nor is swept into
# //src/backend/definitions:definitions's glob.
#
# Depends on the leaf :protocol_catalog/:car_model_catalog targets rather
# than a whole-package //src/backend/config label: no such default target
# exists in that package (only individually named leaf targets), confirmed
# via `bazel query '//src/backend/config:*'`.
qt_cc_library(
    name = "legacy_calibration_adapter",
    srcs = ["legacy_calibration_adapter.cpp"],
    hdrs = [],
    copts = COMMON_COPTS,
    normal_hdrs = ["legacy_calibration_adapter.h"],
    deps = QT_DEPS_NO_WIDGETS + [
        ":calibration_service",
        "//src/algorithms/protocol:qt_compat",
        "//src/backend/config:car_model_catalog",
        "//src/backend/config:config_paths",
        "//src/backend/config:legacy_config_paths",
        "//src/backend/config:protocol_catalog",
        "//src/backend/definition:definition_model",
        "//src/backend/definitions:config_values",
        "//src/backend/definitions:ecu_cal_def",
        "//src/backend/ports",
    ],
)

fastecu_qttest(
    name = "test_legacy_calibration_adapter",
    src = "legacy_calibration_adapter_test.cpp",
    deps = [
        ":legacy_calibration_adapter",
        "//src/backend/definition:definition_model",
        "//src/backend/ports/testing:in_memory_file_repository",
    ],
)
