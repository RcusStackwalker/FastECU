load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = ["//bazel/layers:backend_and_above"])

cc_library(
    name = "scaling_internal",
    srcs = ["scaling_internal.cpp"],
    hdrs = ["scaling_internal.h"],
    visibility = ["//src/backend/calibration:__pkg__"],
    deps = ["//src/algorithms/protocol"],
)

cc_library(
    name = "calibration_service",
    srcs = ["calibration_service.cpp"],
    hdrs = ["calibration_service.h"],
    implementation_deps = [
        ":scaling_internal",
        "//src/algorithms/expression",
    ],
    deps = [
        ":decoded_map",
        "//src/algorithms/protocol",
        "//src/backend/definition:definition_model",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "calibration_service_test",
    srcs = ["calibration_service_test.cpp"],
    deps = [
        ":calibration_service",
        "//src/backend/ports/testing:in_memory_file_repository",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "map_edit",
    srcs = ["map_edit.cpp"],
    hdrs = ["map_edit.h"],
    implementation_deps = [":scaling_internal"],
    deps = [
        "//src/algorithms/protocol",
        "//src/backend/definition:definition_model",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "map_edit_test",
    srcs = ["map_edit_test.cpp"],
    deps = [
        ":map_edit",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "decoded_map",
    hdrs = ["decoded_map.h"],
    deps = [
        "//src/algorithms/protocol",
        "//src/backend/ports",
    ],
)

cc_library(
    name = "numeric_map_edit",
    srcs = ["numeric_map_edit.cpp"],
    hdrs = ["numeric_map_edit.h"],
    implementation_deps = [
        ":scaling_internal",
        "//src/algorithms/expression",
    ],
    deps = [
        ":decoded_map",
        ":map_edit",
    ],
)

fastecu_portable_gtest(
    name = "numeric_map_edit_test",
    srcs = ["numeric_map_edit_test.cpp"],
    deps = [
        ":numeric_map_edit",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "map_placement",
    srcs = ["map_placement.cpp"],
    hdrs = ["map_placement.h"],
    implementation_deps = [":calibration_service"],
    deps = [
        "//src/algorithms/memory:memory_map",
        "//src/backend/definition:definition_model",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "map_placement_test",
    srcs = ["map_placement_test.cpp"],
    deps = [
        ":map_placement",
        "//src/algorithms/memory:address",
        "//src/algorithms/memory:memory_map",
        "//src/backend/definition:definition_model",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)
