load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//bazel/layers:apps_desktop",
    "//bazel/layers:backend_and_above",
])

cc_library(
    name = "definition_model",
    srcs = ["definition_model.cpp"],
    hdrs = ["definition_model.h"],
    deps = ["//src/backend/ports"],
)

cc_library(
    name = "text_format",
    hdrs = ["text_format.h"],
)

fastecu_portable_gtest(
    name = "text_format_test",
    srcs = ["text_format_test.cpp"],
    deps = [
        ":text_format",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "parser_utils",
    srcs = ["parser_utils.cpp"],
    hdrs = ["parser_utils.h"],
    implementation_deps = [":text_format"],
    deps = [
        ":definition_model",
        "//src/backend/ports",
        "@pugixml",
    ],
)

fastecu_portable_gtest(
    name = "parser_utils_test",
    srcs = ["parser_utils_test.cpp"],
    deps = [
        ":parser_utils",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "romraider_parser",
    srcs = ["romraider_parser.cpp"],
    hdrs = ["romraider_parser.h"],
    implementation_deps = [
        ":parser_utils",
        "//src/backend/ports",
        "@pugixml",
    ],
    deps = [":definition_model"],
)

cc_library(
    name = "ecuflash_parser",
    srcs = ["ecuflash_parser.cpp"],
    hdrs = ["ecuflash_parser.h"],
    implementation_deps = [
        ":parser_utils",
        "//src/backend/ports",
        "@pugixml",
    ],
    deps = [":definition_model"],
)

cc_library(
    name = "definition_resolver",
    srcs = ["definition_resolver.cpp"],
    hdrs = ["definition_resolver.h"],
    deps = [":definition_model"],
)

cc_library(
    name = "definition_service",
    srcs = ["definition_service.cpp"],
    hdrs = ["definition_service.h"],
    implementation_deps = [
        ":definition_resolver",
        ":ecuflash_parser",
        ":romraider_parser",
    ],
    deps = [
        ":definition_model",
        ":definition_writer",
        "//src/backend/ports",
    ],
)

cc_library(
    name = "definition_writer",
    srcs = ["definition_writer.cpp"],
    hdrs = ["definition_writer.h"],
    implementation_deps = [
        ":ecuflash_parser",
        ":text_format",
        "@pugixml",
    ],
    deps = [
        ":definition_model",
        "//src/backend/ports",
    ],
)

fastecu_portable_gtest(
    name = "definition_writer_test",
    srcs = ["definition_writer_test.cpp"],
    deps = [
        ":definition_writer",
        ":ecuflash_parser",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "definition_service_test",
    srcs = ["definition_service_test.cpp"],
    deps = [
        ":definition_service",
        "//src/backend/ports/testing:in_memory_atomic_file_writer",
        "//src/backend/ports/testing:in_memory_file_repository",
        "//src/backend/ports/testing:in_memory_file_system",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "definition_model_test",
    srcs = ["definition_model_test.cpp"],
    deps = [
        ":definition_model",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "romraider_parser_test",
    srcs = ["romraider_parser_test.cpp"],
    deps = [
        ":romraider_parser",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "ecuflash_parser_test",
    srcs = ["ecuflash_parser_test.cpp"],
    deps = [
        ":ecuflash_parser",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "definition_resolver_test",
    srcs = ["definition_resolver_test.cpp"],
    deps = [
        ":definition_resolver",
        ":ecuflash_parser",
        ":romraider_parser",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)
