load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "COMMON_COPTS", "QT_DEPS_NO_WIDGETS")

# The Qt-typed half of //src/backend/definition, in its own package so that
# one stays free of Qt by visibility rather than by a source scan -- see
# docs/adr/0016-enforce-qt-reachability-by-visibility.md. Visible only to
# packages that may themselves hold Qt.
package(default_visibility = ["//bazel/qt:qt_layer"])

cc_library(
    name = "legacy_definition_adapter",
    srcs = ["legacy_definition_adapter.cpp"],
    hdrs = ["legacy_definition_adapter.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS_NO_WIDGETS + [
        "//src/backend/definition:definition_service",
        "//src/backend/definition:text_format",
        "//src/backend/definitions:config_values",
        "//src/backend/definitions:ecu_cal_def",
        "//src/backend/definitions:legacy_definition_columns",
        "//src/backend/ports",
    ],
)

fastecu_gtest(
    name = "test_legacy_definition_adapter",
    srcs = ["legacy_definition_adapter_test.cpp"],
    copts = ["-I."],
    deps = [
        ":legacy_definition_adapter",
        "//src/backend/definitions:config_values",
        "//src/backend/definitions:ecu_cal_def",
        "//src/backend/ports",
        "//src/backend/ports/testing:in_memory_atomic_file_writer",
        "//src/backend/ports/testing:in_memory_file_repository",
        "//src/backend/ports/testing:in_memory_file_system",
    ],
)

# Pins the portable //src/backend/definition:text_format against the Qt call
# it replaced, so it links Qt and lives here rather than beside its subject.
fastecu_gtest(
    name = "test_hex_parse_qt_compat",
    srcs = ["hex_parse_qt_compat_test.cpp"],
    deps = ["//src/backend/definition:text_format"],
)
