    deps = [
        ":service_function_types",
        "//src/backend/ports",
        "//src/backend/protocol",
    ],
)

fastecu_portable_gtest(
    name = "service_function_types_test",
    srcs = ["service_function_types_test.cpp"],
    deps = [":service_function_types"],
)
