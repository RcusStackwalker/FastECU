load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = ["//bazel/layers:backend_and_above"])

fastecu_portable_gtest(
    name = "test_cdbg_logging_protocol",
    srcs = ["cdbg_logging_protocol_test.cpp"],
    deps = [
        ":protocols",
        "//src/algorithms/protocol/testing:byte_test_utils",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/backend/ports/testing:result_matchers",
        "//src/backend/protocol/testing:scripted_transports",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "test_mut_dma_logging_protocol",
    srcs = ["mut_dma_logging_protocol_test.cpp"],
    deps = [
        ":protocols",
        "//src/algorithms/protocol/mut_dma",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/backend/ports/testing:result_matchers",
        "//src/backend/protocol/testing:scripted_transports",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "test_ssm_logging_protocol",
    srcs = ["ssm_logging_protocol_test.cpp"],
    deps = [
        ":protocols",
        "//src/algorithms/protocol/ssm",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/backend/ports/testing:fake_clock",
        "//src/backend/ports/testing:result_matchers",
        "//src/backend/protocol/testing:scripted_transports",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "protocols",
    srcs = [
        "portable_cdbg_logging_protocol.cpp",
        "portable_mut_dma_logging_protocol.cpp",
        "portable_ssm_logging_protocol.cpp",
    ],
    hdrs = [
        "portable_cdbg_logging_protocol.h",
        "portable_mut_dma_logging_protocol.h",
        "portable_ssm_logging_protocol.h",
    ],
    implementation_deps = ["//src/algorithms/protocol/ssm"],
    deps = [
        "//src/algorithms/protocol",
        "//src/backend/logging:logging_use_case",
