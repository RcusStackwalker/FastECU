load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "logging_types",
    hdrs = ["logging_types.h"],
)

cc_library(
    name = "logger_definition_model",
    hdrs = ["logger_definition_model.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "logger_definition_parser",
    srcs = ["logger_definition_parser.cpp"],
    hdrs = ["logger_definition_parser.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":logger_definition_model",
        "//src/algorithms/protocol",
        "//src/backend/ports",
        "@pugixml",
    ],
)

fastecu_portable_gtest(
    name = "logger_definition_parser_test",
    srcs = ["logger_definition_parser_test.cpp"],
    deps = [":logger_definition_parser"],
)

cc_library(
    name = "logger_conf",
    srcs = ["logger_conf.cpp"],
    hdrs = ["logger_conf.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":logger_definition_model",
        "//src/algorithms/protocol",
        "//src/backend/ports",
        "@pugixml",
    ],
)

fastecu_portable_gtest(
    name = "logger_conf_test",
    srcs = ["logger_conf_test.cpp"],
    deps = [":logger_conf"],
)

cc_library(
    name = "logging_session",
    srcs = ["logging_session.cpp"],
    hdrs = ["logging_session.h"],
    deps = [
        ":logging_types",
        "//src/algorithms/expression",
        "//src/algorithms/protocol/colt",
        "//src/backend/ports",
    ],
