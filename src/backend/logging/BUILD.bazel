        "logging_event_sink.h",
        "logging_protocol.h",
        "logging_use_case.h",
    ],
    deps = [
        ":logging_conversion",
        ":logging_session",
        "//src/backend/ports",
    ],
)

cc_test(
    name = "logging_use_case_test",
    size = "small",
    srcs = ["logging_use_case_test.cpp"],
    deps = [
        ":logging_use_case",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/backend/ports/testing:recording_event_sink",
        "@googletest//:gtest_main",
