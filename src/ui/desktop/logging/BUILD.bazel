package(default_visibility = ["//bazel/layers:ui"])

cc_library(
    name = "logging_run_preparation",
    srcs = ["logging_run_preparation.cpp"],
    hdrs = ["logging_run_preparation.h"],
    deps = [
        "//src/backend/logging:logging_run_snapshot",
        "//src/backend/ports",
