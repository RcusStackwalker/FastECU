load("//bazel:gtest_targets.bzl", "fastecu_gtest")

# gazelle:map_kind cc_library qt_cc_library //bazel:qt_targets.bzl
load("//bazel:qt_targets.bzl", "qt_cc_library")

package(default_visibility = ["//bazel/layers:ui_and_composition_root"])

qt_cc_library(
    name = "qhexedit",
    srcs = [
        "chunks.cpp",
        "commands.cpp",
        "qhexedit.cpp",
    ],
    hdrs = [
        "chunks.h",
        "commands.h",
        "qhexedit.h",
    ],
    deps = [
        "//bazel/qt:core",
        "//bazel/qt:gui",
        "//bazel/qt:widgets",
    ],
)

fastecu_gtest(
    name = "qhexedit_test",
    srcs = ["qhexedit_test.cpp"],
    copts = ["-DQT_WIDGETS_LIB"],
    deps = [
        ":qhexedit",
        "//src/platform/desktop/common/testing:event_helpers",
        "//src/platform/desktop/common/testing:widgets_application_environment",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "qhexedit_keys_test",
    srcs = ["qhexedit_keys_test.cpp"],
    deps = [
        ":qhexedit",
        "//bazel/qt:gui",
        "//bazel/qt:widgets",
        "//src/platform/desktop/common/testing:widgets_application_environment",
        "@googletest//:gtest",
    ],
)
