load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "qt_cc_library", "qt_ui_basename_libraries")

package(default_visibility = ["//bazel/layers:ui_and_composition_root"])

FORMS = [
    "optionsdialog.ui",
    "searchdialog.ui",
]

qt_ui_basename_libraries(
    name = "hexedit_ui_libraries",
    forms = FORMS,
    deps = ["//bazel/qt:widgets"],
)

qt_cc_library(
    name = "hexedit",
    srcs = [
        "hexedit.cpp",
        "optionsdialog.cpp",
        "searchdialog.cpp",
    ],
    hdrs = [
        "hexedit.h",
        "optionsdialog.h",
        "searchdialog.h",
    ],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        "//resources/desktop:hexedit_resource",
        "//src/ui/desktop/hexedit/qhexedit",
    ] + [":ui_" + f.removesuffix(".ui") for f in FORMS],
)
