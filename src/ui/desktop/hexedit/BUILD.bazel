# gazelle:resolve cc ui_searchdialog.h :ui_searchdialog
# gazelle:resolve cc ui_optionsdialog.h :ui_optionsdialog
# gazelle:map_kind cc_library qt_cc_library //bazel:qt_targets.bzl
load("//bazel:qt_targets.bzl", "qt_cc_library", "qt_ui_basename_libraries")

package(default_visibility = ["//bazel/layers:ui_and_composition_root"])

FORMS = [
    "optionsdialog.ui",
    "searchdialog.ui",
]

qt_ui_basename_libraries(
    name = "hexedit_ui_libraries",
    forms = FORMS,
    deps = ["//bazel/qt:widgets"],
)

qt_cc_library(
    name = "hexedit",
    srcs = [
        "hexedit.cpp",
        "optionsdialog.cpp",
        "searchdialog.cpp",
    ],
    hdrs = [
        "hexedit.h",
        "optionsdialog.h",
        "searchdialog.h",
    ],
    implementation_deps = [
        "//src/ui/desktop/hexedit:ui_optionsdialog",
        "//src/ui/desktop/hexedit:ui_searchdialog",
    ],
    deps = [
        "//bazel/qt:core",
        "//bazel/qt:gui",
        "//bazel/qt:widgets",
        "//resources/desktop:hexedit_resource",  # keep: Qt resource registration has no include.
        "//src/ui/desktop/hexedit/qhexedit",
    ],
)
