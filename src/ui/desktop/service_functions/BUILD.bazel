load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_library")

package(default_visibility = [
    "//apps/desktop:__pkg__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

qt_cc_library(
    name = "service_function_dialog",
    srcs = ["service_function_dialog.cpp"],
    hdrs = ["service_function_dialog.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        "//src/backend/service_functions:read_parameters_session",
        "//src/backend/service_functions:relearn_session",
        "//src/backend/service_functions:service_function_types",
        "//src/backend/service_functions:set_parameters_session",
        "//src/backend/service_functions:tcu_parameter_table",
        "//src/platform/desktop/common/ports",
        "//src/platform/desktop/common/service_functions:service_function_worker",
        "//src/platform/desktop/common/transport",
    ],
)

fastecu_qttest(
    name = "test_service_function_dialog",
    src = "service_function_dialog_test.cpp",
    copts = ["-DQT_WIDGETS_LIB"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [":service_function_dialog"],
)
