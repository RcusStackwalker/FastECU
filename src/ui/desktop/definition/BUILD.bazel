load("@rules_cc//cc:cc_library.bzl", "cc_library")

# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS")

package(default_visibility = ["//bazel/layers:ui"])

# Qt-linked without Q_OBJECT, so use a plain library with shared compiler options.
cc_library(
    name = "definition_header_form",
    srcs = ["definition_header_form.cpp"],
    hdrs = ["definition_header_form.h"],
    copts = COMMON_COPTS,
    implementation_deps = ["//bazel/qt:xml"],
    deps = [
        "//bazel/qt:core",
        "//bazel/qt:widgets",
        "//src/backend/definition:definition_writer",
        "//src/backend/ports",
    ],
)

fastecu_gtest(
    name = "definition_header_form_test",
    srcs = ["definition_header_form_test.cpp"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [
        ":definition_header_form",
        "//bazel/qt:widgets",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)
