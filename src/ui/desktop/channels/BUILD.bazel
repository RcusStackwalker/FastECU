# The channel header declares Q_OBJECT; generated hdrs must run through moc.
# gazelle:map_kind cc_library qt_cc_library //bazel:qt_targets.bzl
load("//bazel:qt_targets.bzl", "qt_cc_library")

# A signal-only endpoint through which the UI reaches desktop services it does
# not name. apps/desktop's composition root connects it to the platform
# objects; the UI connects to it. It holds no logic.
package(default_visibility = [
    "//bazel/layers:apps_desktop",
    "//src/ui/desktop:__subpackages__",
])

qt_cc_library(
    name = "log_channel",
    # The Qt macro requires srcs even for a header-only moc library.
    hdrs = ["log_channel.h"],
    deps = ["//bazel/qt:core"],
)
