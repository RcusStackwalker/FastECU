load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "qt_cc_library")

package(default_visibility = [
    "//apps/desktop:__pkg__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

qt_cc_library(
    name = "tcu",
    srcs = [
        "flash_tcu_subaru_denso_sh705x_can.cpp",
        "flash_tcu_subaru_hitachi_m32r_can.cpp",
        "flash_tcu_subaru_hitachi_m32r_kline.cpp",
    ],
    hdrs = [
        "flash_tcu_subaru_denso_sh705x_can.h",
        "flash_tcu_subaru_hitachi_m32r_can.h",
        "flash_tcu_subaru_hitachi_m32r_kline.h",
    ],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        # Full :definitions (not :models) because file_actions.h -- part of
        # the moc'd :definitions target, not the header-only :models split
        # -- is included directly; see task-4-report.md.
        "//src/backend/definitions",
        "//src/platform/desktop/common/flash/legacy:legacy_flash_operations",
        "//src/platform/desktop/common/serial:serial_qt_compat",
        # Every dialog header in this package includes ui_ecu_operations.h,
        # the generated form owned by the top-level desktop package.
        "//src/ui/desktop:ui_ecu_operations",
    ],
)
