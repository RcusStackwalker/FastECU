load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "qt_cc_library")

package(default_visibility = [
    "//apps/desktop:__pkg__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

qt_cc_library(
    name = "eeprom",
    srcs = glob(["*.cpp"]),
    hdrs = glob(["*.h"]),
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        # Full :definitions (not :models) because file_actions.h -- part of
        # the moc'd :definitions target, not the header-only :models split
        # -- is included directly; see task-4-report.md.
        "//src/backend/config:config_paths",
        "//src/backend/definitions",
        "//src/backend/flash:flash_executor",
        "//src/backend/flash:flash_plan",
        "//src/backend/flash/eeprom:denso_sh705x_eeprom_can",
        "//src/backend/flash/eeprom:denso_sh705x_eeprom_kline",
        "//src/backend/ports",
        # One-attempt-per-mode orchestration (step 5c, Task 17): each dialog
        # drives a FlashWorker per EEPROM read mode, built from
        # LegacyFlashSnapshotAdapter over a real QtFileRepository/QtClock and
        # a DesktopKline/CanFlashTransport wrapping the (non-owned) serial
        # connection MainWindow passes in.
        "//src/platform/desktop/common/flash:flash_snapshot_adapter",
        "//src/platform/desktop/common/flash:flash_worker",
        "//src/platform/desktop/common/ports",
        "//src/platform/desktop/common/serial:serial_qt_compat",
        "//src/platform/desktop/common/transport:flash_transports",
        # Both dialog headers in this package include ui_ecu_operations.h,
        # the generated form owned by the top-level desktop package.
        "//src/ui/desktop:ui_ecu_operations",
    ],
)
