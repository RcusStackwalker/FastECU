# Single moc library per package: every generated hdrs entry declares Q_OBJECT.
# gazelle:map_kind cc_library qt_cc_library //bazel:qt_targets.bzl
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "qt_cc_library")

package(default_visibility = ["//bazel/layers:ui_desktop"])

# Runs one flash operation for MainWindow: Denso TCU service routing,
# portable workflow creation, the FlashDialog, and the unknown-protocol
# warning. It only passes SerialPortActions* through, so it needs no facade
# dependency.
qt_cc_library(
    name = "flash_operation_controller",
    srcs = ["flash_operation_controller.cpp"],
    hdrs = ["flash_operation_controller.h"],
    implementation_deps = [
        "//bazel/qt:widgets",
        "//src/backend/flash:flash_operation_request",
        "//src/platform/desktop/common/flash:flash_workflow",
        "//src/ui/desktop/flash/common:flash_dialog",
        "//src/ui/desktop/service_functions:denso_tcu_read_preflight",
    ],
    deps = [
        "//bazel/qt:core",
        "//src/algorithms/protocol",
        "//src/backend/config:config_paths",
        "//src/backend/flash:flash_types",
    ],
)

fastecu_gtest(
    name = "flash_operation_controller_test",
    size = "small",
    srcs = ["flash_operation_controller_test.cpp"],
    copts = ["-DQT_WIDGETS_LIB"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [
        ":flash_operation_controller",
        "//bazel/qt:core",
        "//bazel/qt:widgets",
        "//src/platform/desktop/common/connection/testing:adapter_connection_harness",
        "//src/platform/desktop/common/testing:widgets_application_environment",
        "@googletest//:gtest",
    ],
)
