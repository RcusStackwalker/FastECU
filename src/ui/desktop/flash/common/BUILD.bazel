# Single moc library per package: every generated hdrs entry declares Q_OBJECT.
# gazelle:map_kind cc_library qt_cc_library //bazel:qt_targets.bzl
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "qt_cc_library")

package(default_visibility = [
    "//bazel/layers:apps_desktop",
    "//bazel/layers:ui",
])

qt_cc_library(
    name = "flash_dialog",
    srcs = ["flash_dialog.cpp"],
    hdrs = ["flash_dialog.h"],
    implementation_deps = ["//bazel/qt:core"],
    deps = [
        "//bazel/qt:widgets",
        "//src/platform/desktop/common/flash:flash_workflow",
        "//src/platform/desktop/common/flash/worker:flash_worker",
        "//src/ui/desktop:ui_ecu_operations",
    ],
)

fastecu_gtest(
    name = "test_flash_dialog",
    srcs = ["flash_dialog_test.cpp"],
    copts = ["-DQT_WIDGETS_LIB"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [
        ":flash_dialog",
        "//bazel/qt:core",
        "//src/backend/flash/ecu:subaru_unisia_jecs_m32r_kline_plan",
        "//src/backend/ports/testing:fake_clock",
        "//src/platform/desktop/common/testing:widgets_application_environment",
        "@googletest//:gtest",
    ],
)
