load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_library")

package(default_visibility = [
    "//apps/desktop:__pkg__",
    "//src/ui:__subpackages__",
])

qt_cc_library(
    name = "flash_dialog",
    srcs = ["flash_dialog.cpp"],
    hdrs = ["flash_dialog.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        "//src/backend/ports",
        "//src/platform/desktop/common/flash:flash_worker",
        "//src/ui/desktop:ui_ecu_operations",
    ],
)

fastecu_qttest(
    name = "test_flash_dialog",
    src = "flash_dialog_test.cpp",
    copts = ["-DQT_WIDGETS_LIB"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [":flash_dialog"],
)
