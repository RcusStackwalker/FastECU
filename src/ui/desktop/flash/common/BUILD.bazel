load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "QT_DEPS", "qt_cc_library")

package(default_visibility = [
    "//bazel/layers:apps_desktop",
    "//bazel/layers:ui",
])

# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "flash_dialog",
    srcs = ["flash_dialog.cpp"],
    hdrs = ["flash_dialog.h"],
    deps = QT_DEPS + [
        "//src/backend/ports",
        "//src/platform/desktop/common/flash:flash_worker",
        "//src/ui/desktop:ui_ecu_operations",
    ],
)

fastecu_gtest(
    name = "test_flash_dialog",
    srcs = ["flash_dialog_test.cpp"],
    copts = ["-DQT_WIDGETS_LIB"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [
        "//bazel/qt:core",
        "//src/backend/flash/ecu:subaru_unisia_jecs_m32r_kline_plan",
        "//src/backend/ports/testing:fake_clock",
        "//src/platform/desktop/common/testing:widgets_application_environment",
        "//src/ui/desktop/flash/common:flash_dialog",
        "@googletest//:gtest",
    ],
)
