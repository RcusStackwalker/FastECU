# Designer forms and their generation stay in this package; the widgets that
# consume the generated ui_*.h headers live in //src/ui/desktop/widgets, which
# resolves each header to the form's library.
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "qt_ui_basename_libraries")

package(default_visibility = ["//bazel/layers:ui_and_composition_root"])

FORMS = [
    "calibration_map_table.ui",
    "data_terminal.ui",
    "definition_file_convert.ui",
    "dtc_operations.ui",
    "ecu_operations.ui",
    "mainwindow.ui",
    "protocol_select.ui",
    "settings.ui",
    "vehicle_select.ui",
]

# Designer-form generation is hand-owned: Gazelle cannot see the generated
# ui_*.h headers, which the widgets package resolves to these libraries.
qt_ui_basename_libraries(
    name = "desktop_ui_libraries",
    forms = FORMS,
    deps = ["//bazel/qt:widgets"],
)

# Forward declarations only; no Qt include.
cc_library(
    name = "main_window_services",
    hdrs = ["main_window_services.h"],
    copts = COMMON_COPTS,
)

# Display helpers over the configuration session's std::string records.
cc_library(
    name = "config_fields",
    srcs = ["config_fields.cpp"],
    hdrs = ["config_fields.h"],
    copts = COMMON_COPTS,
    implementation_deps = ["//src/backend/config:config_session"],
    deps = [
        "//bazel/qt:core",
        "//src/backend/config:car_model_catalog",
        "//src/backend/config:protocol_catalog",
    ],
)

fastecu_gtest(
    name = "config_fields_test",
    size = "small",
    srcs = ["config_fields_test.cpp"],
    deps = [
        ":config_fields",
        "//src/backend/config/testing:config_session_fixture",
        "@googletest//:gtest",
    ],
)

# QByteArray boundary for the synchronous diagnostic dialogs.
cc_library(
    name = "diagnostic_link_io",
    hdrs = ["diagnostic_link_io.h"],
    copts = COMMON_COPTS,
    deps = [
        "//bazel/qt:core",
        "//src/backend/ports",
        "//src/backend/protocol",
        "//src/platform/desktop/common/bytes:qt_bytes",
    ],
)
