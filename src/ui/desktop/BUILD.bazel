load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_library", "qt_ui_basename_libraries")

package(default_visibility = [
    "//apps/desktop:__pkg__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

FORMS = [
    "calibration_map_table.ui",
    "data_terminal.ui",
    "definition_file_convert.ui",
    "dtc_operations.ui",
    "ecu_operations.ui",
    "mainwindow.ui",
    "protocol_select.ui",
    "settings.ui",
    "vehicle_select.ui",
]

qt_ui_basename_libraries(
    name = "desktop_ui_libraries",
    forms = FORMS,
    deps = ["//bazel/qt:widgets"],
)

# Forward declarations only; no Qt include, so a plain cc_library.
cc_library(
    name = "main_window_services",
    hdrs = ["main_window_services.h"],
)

# Display helpers over the configuration session's std::string records.
qt_cc_library(
    name = "config_fields",
    srcs = ["config_fields.cpp"],
    hdrs = [],
    copts = COMMON_COPTS,
    normal_hdrs = ["config_fields.h"],
    deps = QT_DEPS + [
        "//src/backend/config:car_model_catalog",
        "//src/backend/config:config_session",
        "//src/backend/config:protocol_catalog",
        "//src/backend/logging:logger_definition_service",
        "//src/backend/logging:logger_model",
    ],
)

fastecu_gtest(
    name = "config_fields_test",
    size = "small",
    srcs = ["config_fields_test.cpp"],
    deps = [
        ":config_fields",
        "//src/backend/config/testing:config_session_fixture",
    ],
)

# QByteArray boundary for the synchronous diagnostic dialogs.
qt_cc_library(
    name = "diagnostic_link_io",
    srcs = [],
    hdrs = [],
    copts = COMMON_COPTS,
    normal_hdrs = ["diagnostic_link_io.h"],
    deps = QT_DEPS + [
        "//src/algorithms/protocol",
        "//src/algorithms/protocol/qt_compat",
        "//src/backend/ports",
        "//src/backend/protocol",
    ],
)

qt_cc_library(
    name = "dtc_operations",
    srcs = ["dtc_operations.cpp"],
    hdrs = ["dtc_operations.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        ":ui_dtc_operations",
        "//src/backend/diagnostics:dtc_session",
        "//src/backend/ports",
        "//src/backend/protocol",
        "//src/platform/desktop/common/diagnostics:dtc_worker",
        "//src/platform/desktop/common/ports",
    ],
)

fastecu_qttest(
    name = "dtc_operations_test",
    src = "dtc_operations_test.cpp",
    copts = ["-DQT_WIDGETS_LIB"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [
        ":dtc_operations",
        "//src/backend/protocol/testing:fake_diagnostic_link",
    ],
)

qt_cc_library(
    name = "desktop",
    srcs = [
        "calibration_maps.cpp",
        "calibration_treewidget.cpp",
        "dataterminal.cpp",
        "definition_file_convert.cpp",
        "get_key_operations_subaru.cpp",
        "log_operations_ssm.cpp",
        "logbox.cpp",
        "logvalues.cpp",
        "mainwindow.cpp",
        "menu_actions.cpp",
        "protocol_select.cpp",
        "settings.cpp",
        "vehicle_select.cpp",
        "verticallabel.cpp",
    ],
    hdrs = [
        "calibration_maps.h",
        "calibration_treewidget.h",
        "dataterminal.h",
        "definition_file_convert.h",
        "get_key_operations_subaru.h",
        "logbox.h",
        "mainwindow.h",
        "protocol_select.h",
        "settings.h",
        "vehicle_select.h",
        "verticallabel.h",
    ],
    copts = COMMON_COPTS,
    linkopts = select({
        "@platforms//os:windows": [
            "opengl32.lib",
            "setupapi.lib",
        ],
        "//conditions:default": [],
    }),
    deps = QT_DEPS + [
        ":diagnostic_link_io",
        ":dtc_operations",
        ":main_window_services",
        "//resources/desktop:font_resource",
        "//resources/desktop:icons_resource",
        "//resources/desktop:images_resource",
        "//src/algorithms/checksum",
        "//src/algorithms/diagnostics",
        "//src/algorithms/menu",
        "//src/algorithms/protocol",
        "//src/algorithms/protocol/qt_compat",
        "//src/backend/calibration:map_edit",
        "//src/backend/checksum:checksum_selection",
        ":config_fields",
        "//src/backend/config:config_session",
        "//src/backend/logging:logger_model",
        "//src/backend/logging:logger_definition_service",
        "//src/backend/config:menu_definition",
        "//src/backend/definitions",
        "//src/backend/flash:flash_device_lookup",
        "//src/backend/flash:flash_operation_request",
        "//src/backend/ports",
        # Not included directly by mainwindow.h/.cpp any more; needed
        # transitively for idiagnostic_link.h, which biu_operations_subaru.h,
        # dataterminal.h, and serial_diagnostic_link.h (used by
        # menu_actions.cpp) each include.
        "//src/backend/protocol",
        "//src/backend/diagnostics:ssm_identify",
        "//src/platform/desktop/common/diagnostics:ssm_identify_worker",
        "//src/platform/desktop/common/connection:adapter_connection",
        "//src/platform/desktop/common/diagnostics:serial_diagnostic_link",
        # mainwindow.cpp calls portableImageForOperation directly.
        "//src/platform/desktop/common/flash:flash_worker",
        "//src/platform/desktop/common/logging:logging_adapters",
        "//src/platform/desktop/common/logging:logging_runtime",
        "//src/platform/desktop/common/ports",
        "//src/platform/desktop/common/serial:serial_idle",
        "//src/ui/desktop/biu",
        "//src/backend/calibration/session:calibration_workspace",
        "//src/ui/desktop/calibration:calibration_view_state",
        "//src/ui/desktop/calibration:legacy_calibration_view",
        "//src/ui/desktop/calibration:rom_info",
        "//src/ui/desktop/calibration:session_key",
        "//src/ui/desktop/calibration:map_edit_adapter",
        "//src/ui/desktop/channels:log_channel",
        "//src/ui/desktop/channels:remote_peer",
        "//src/ui/desktop/checksum:checksum_correction_command",
        "//src/ui/desktop/definition:definition_authoring_dialog",
        "//src/ui/desktop/flash/operation:flash_operation_controller",
        "//src/ui/desktop/hexedit",
        "//src/ui/desktop/menu:menu_builder",
    ] + [":ui_" + f.removesuffix(".ui") for f in FORMS],
)

