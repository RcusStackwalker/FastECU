load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_library", "qt_ui_basename_libraries")

package(default_visibility = [
    "//apps/desktop:__pkg__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

FORMS = [
    "calibration_map_table.ui",
    "data_terminal.ui",
    "definition_file_convert.ui",
    "dtc_operations.ui",
    "ecu_operations.ui",
    "logvalues.ui",
    "mainwindow.ui",
    "protocol_select.ui",
    "settings.ui",
    "vehicle_select.ui",
]

qt_ui_basename_libraries(
    name = "desktop_ui_libraries",
    forms = FORMS,
    deps = ["//bazel/qt:widgets"],
)

# Forward declarations only; no Qt include, so a plain cc_library.
cc_library(
    name = "main_window_services",
    hdrs = ["main_window_services.h"],
)

qt_cc_library(
    name = "desktop",
    # hexcommander.cpp is deliberately omitted: dead code, never in
    # APP_COMMON_SRCS or the legacy FastECU.pro, and its header (also omitted
    # below) declares Q_OBJECT but isn't in hdrs below -- adding it here would
    # bring it into the build for the first time and fail to link.
    srcs = [
        "calibration_maps.cpp",
        "calibration_treewidget.cpp",
        "dataterminal.cpp",
        "definition_file_convert.cpp",
        "dtc_operations.cpp",
        "get_key_operations_subaru.cpp",
        "log_operations_ssm.cpp",
        "logbox.cpp",
        "logvalues.cpp",
        "mainwindow.cpp",
        "menu_actions.cpp",
        "protocol_select.cpp",
        "settings.cpp",
        "vehicle_select.cpp",
        "verticallabel.cpp",
    ],
    hdrs = [
        "calibration_maps.h",
        "calibration_treewidget.h",
        "dataterminal.h",
        "definition_file_convert.h",
        "dtc_operations.h",
        "get_key_operations_subaru.h",
        "logbox.h",
        "logvalues.h",
        "mainwindow.h",
        "protocol_select.h",
        "settings.h",
        "vehicle_select.h",
        "verticallabel.h",
    ],
    copts = COMMON_COPTS,
    linkopts = select({
        "@platforms//os:windows": [
            "opengl32.lib",
            "setupapi.lib",
        ],
        "//conditions:default": [],
    }),
    deps = QT_DEPS + [
        ":main_window_services",
        "//resources/desktop:font_resource",
        "//resources/desktop:icons_resource",
        "//resources/desktop:images_resource",
        "//src/algorithms/checksum",
        "//src/algorithms/diagnostics",
        "//src/algorithms/menu",
        "//src/algorithms/protocol",
        "//src/algorithms/protocol/qt_compat",
        "//src/backend/calibration:map_edit",
        "//src/backend/checksum:checksum_selection",
        "//src/backend/config/legacy:legacy_config_paths",
        "//src/backend/config:menu_definition",
        "//src/backend/definitions",
        "//src/backend/flash:flash_device_lookup",
        "//src/backend/logging/protocols",
        "//src/backend/ports",
        # mainwindow.h includes imut_dma_init.h, mitsu_colt_can_cdbg_driver.h
        # and mut_dma_driver.h directly.
        "//src/backend/protocol",
        "//src/platform/desktop/common/logging",
        "//src/platform/desktop/common/logging:logging_adapters",
        "//src/platform/desktop/common/logging:logging_runtime",
        "//src/platform/desktop/common/ports",
        "//src/platform/desktop/common/remote_utility",
        "//src/platform/desktop/common/serial:serial_qt_compat",
        "//src/platform/desktop/common/transport",
        "//src/ui/desktop/biu",
        "//src/ui/desktop/calibration:map_edit_adapter",
        "//src/ui/desktop/checksum:checksum_correction_command",
        "//src/ui/desktop/definition:definition_authoring_dialog",
        "//src/ui/desktop/flash/common:flash_dialog",
        "//src/ui/desktop/hexedit",
        "//src/ui/desktop/menu:menu_builder",
        "//src/ui/desktop/service_functions:denso_tcu_read_preflight",
    ] + [":ui_" + f.removesuffix(".ui") for f in FORMS],
)

fastecu_qttest(
    name = "test_mainwindow",
    size = "medium",
    src = "mainwindow_test.cpp",
    copts = ["-DQT_WIDGETS_LIB"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    # cc_test defaults to linkstatic = 0, which links :desktop as a shared
    # library wherever the toolchain supports it -- Linux and Windows, but not
    # macOS, which is why this target passes there either way. Both shared
    # builds fail: on Linux the .so must resolve every symbol, and moc_logvalues
    # references a LogValues class that logvalues.h declares but nothing
    # defines; on Windows the DLL's import library does not carry
    # MainWindow::start_ecu_operations, which this test calls. Linking
    # statically, the way //:fastecu already does, leaves the unreferenced moc
    # object out of the link on every platform and keeps MainWindow's own
    # symbols reachable.
    linkstatic = True,
    deps = [
        ":desktop",
        "//src/platform/desktop/common/logging",
        "//src/platform/desktop/common/logging:logging_runtime",
        "//src/platform/desktop/common/ports",
        "//src/platform/desktop/common/remote_utility",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
    ],
)

fastecu_qttest(
    name = "test_settings",
    size = "small",
    src = "settings_test.cpp",
    copts = ["-DQT_WIDGETS_LIB"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    # Static for the same reason as test_mainwindow above.
    linkstatic = True,
    deps = [":desktop"],
)
