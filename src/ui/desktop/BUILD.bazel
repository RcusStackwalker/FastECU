# Designer forms are generated here by convention: ui_<name>.h resolves to this
# package's ui_<name> target unless a child package owns its own forms.
# gazelle:resolve_regexp cc ^ui_(.*)\.h$ //src/ui/desktop:ui_$1
# Designer forms stay in this package; consumers such as //src/ui/desktop/widgets
# reach each generated ui_*.h through the resolve_regexp above.
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "qt_ui_basename_libraries")

package(default_visibility = ["//bazel/layers:ui_and_composition_root"])

# Every *.ui file gets a ui_<name> library; Gazelle cannot see the generated
# headers, so consumers resolve them through the resolve_regexp above.
FORMS = [
    "calibration_map_table.ui",
    "data_terminal.ui",
    "definition_file_convert.ui",
    "dtc_operations.ui",
    "ecu_operations.ui",
    "mainwindow.ui",
    "protocol_select.ui",
    "settings.ui",
    "vehicle_select.ui",
]

qt_ui_basename_libraries(
    name = "desktop_ui_libraries",
    forms = FORMS,
    deps = ["//bazel/qt:widgets"],
)

# Forward declarations only; no Qt include.
cc_library(
    name = "main_window_services",
    hdrs = ["main_window_services.h"],
    copts = COMMON_COPTS,
)

# Display helpers over the catalog's protocol and vehicle records.
cc_library(
    name = "config_fields",
    srcs = ["config_fields.cpp"],
    hdrs = ["config_fields.h"],
    copts = COMMON_COPTS,
    deps = [
        "//bazel/qt:core",
        "//src/backend/config:catalog",
    ],
)

fastecu_gtest(
    name = "config_fields_test",
    size = "small",
    srcs = ["config_fields_test.cpp"],
    deps = [
        ":config_fields",
        "//src/backend/config/testing:config_session_fixture",
        "@googletest//:gtest",
    ],
)

# QByteArray boundary for the synchronous diagnostic dialogs.
cc_library(
    name = "diagnostic_link_io",
    hdrs = ["diagnostic_link_io.h"],
    copts = COMMON_COPTS,
    deps = [
        "//bazel/qt:core",
        "//src/backend/ports",
        "//src/backend/protocol",
        "//src/platform/desktop/common/bytes:qt_bytes",
    ],
)
