load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "COMMON_COPTS")

package(default_visibility = ["//bazel/layers:ui"])

# Qt-linked (QMessageBox/QString) but no QObject/Q_OBJECT, so a plain
# cc_library suffices.
# checksum_result.h is included directly by this command's header; its
# generated dependencies name the owner instead of relying on an adapter.
cc_library(
    name = "checksum_correction_command",
    srcs = ["checksum_correction_command.cpp"],
    hdrs = ["checksum_correction_command.h"],
    copts = COMMON_COPTS,
    implementation_deps = [
        "//bazel/qt:core",
        "//bazel/qt:widgets",
        "//src/backend/checksum:dispatch",
        "//src/backend/flash:flash_device_lookup",
    ],
    deps = [
        ":checksum_correction_result",
        "//src/algorithms/checksum",
        "//src/algorithms/memory:memory_image",
        "//src/backend/checksum:checksum_selection",
    ],
)

fastecu_gtest(
    name = "checksum_correction_command_test",
    srcs = ["checksum_correction_command_test.cpp"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [
        ":checksum_correction_command",
        "//bazel/qt:widgets",
        "//src/algorithms/memory:memory_image",
        "//src/algorithms/memory:memory_map",
        "//src/algorithms/memory/testing:memory_views",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "checksum_correction_result",
    hdrs = ["checksum_correction_result.h"],
    deps = ["//src/algorithms/protocol"],
)
