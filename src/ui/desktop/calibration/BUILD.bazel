load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "QT_DEPS", "qt_cc_library")

package(default_visibility = ["//bazel/layers:ui"])

# Session edit adapter reads QTableWidget/QMdiSubWindow selection state.
# Declares no QObject of its own, so the header goes through normal_hdrs.
qt_cc_library(
    name = "map_edit_adapter",
    srcs = ["map_edit_adapter.cpp"],
    normal_hdrs = ["map_edit_adapter.h"],
    deps = QT_DEPS + [
        ":session_key",
        "//src/algorithms/protocol/qt_compat",
        "//src/backend/calibration:map_edit",
        "//src/backend/calibration/session:calibration_session",
    ],
)

fastecu_gtest(
    name = "map_edit_adapter_test",
    srcs = ["map_edit_adapter_test.cpp"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [":map_edit_adapter"],
)

qt_cc_library(
    name = "session_key",
    srcs = ["session_key.cpp"],
    normal_hdrs = ["session_key.h"],
    deps = QT_DEPS + ["//src/backend/calibration/session:calibration_session"],
)

fastecu_gtest(
    name = "session_key_test",
    srcs = ["session_key_test.cpp"],
    deps = [":session_key"],
)

qt_cc_library(
    name = "rom_info",
    srcs = ["rom_info.cpp"],
    normal_hdrs = ["rom_info.h"],
    deps = QT_DEPS + ["//src/backend/calibration/session:calibration_session"],
)

# Header-only: UI presentation state of one open calibration.
cc_library(
    name = "calibration_view_state",
    hdrs = ["calibration_view_state.h"],
    deps = QT_DEPS,
)

qt_cc_library(
    name = "map_presentation",
    srcs = ["map_presentation.cpp"],
    normal_hdrs = ["map_presentation.h"],
    deps = QT_DEPS + ["//src/backend/calibration/session:calibration_session"],
)

fastecu_gtest(
    name = "map_presentation_test",
    srcs = ["map_presentation_test.cpp"],
    deps = [":map_presentation"],
)

fastecu_gtest(
    name = "rom_info_test",
    srcs = ["rom_info_test.cpp"],
    deps = [":rom_info"],
)

fastecu_gtest(
    name = "hex_parse_qt_compat_test",
    srcs = ["hex_parse_qt_compat_test.cpp"],
    deps = ["//src/backend/definition:text_format"],
)
