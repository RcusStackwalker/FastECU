load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "COMMON_COPTS")

package(default_visibility = ["//bazel/layers:ui"])

# Session edit adapter reads QTableWidget/QMdiSubWindow selection state.
# Declares no QObject of its own, so a plain cc_library suffices.
cc_library(
    name = "map_edit_adapter",
    srcs = ["map_edit_adapter.cpp"],
    hdrs = ["map_edit_adapter.h"],
    copts = COMMON_COPTS,
    implementation_deps = ["//bazel/qt:widgets"],
    deps = [
        ":session_key",
        "//bazel/qt:core",
        "//src/backend/calibration:map_edit",
        "//src/backend/calibration/session:calibration_session",
    ],
)

fastecu_gtest(
    name = "map_edit_adapter_test",
    srcs = ["map_edit_adapter_test.cpp"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [
        ":map_edit_adapter",
        "//bazel/qt:core",
        "//bazel/qt:widgets",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "session_key",
    srcs = ["session_key.cpp"],
    hdrs = ["session_key.h"],
    copts = COMMON_COPTS,
    deps = [
        "//bazel/qt:core",
        "//src/backend/calibration/session:calibration_session",
    ],
)

fastecu_gtest(
    name = "session_key_test",
    srcs = ["session_key_test.cpp"],
    deps = [
        ":session_key",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "rom_info",
    srcs = ["rom_info.cpp"],
    hdrs = ["rom_info.h"],
    copts = COMMON_COPTS,
    deps = [
        "//bazel/qt:core",
        "//src/backend/calibration/session:calibration_session",
    ],
)

# Header-only: UI presentation state of one open calibration.
cc_library(
    name = "calibration_view_state",
    hdrs = ["calibration_view_state.h"],
    deps = ["//bazel/qt:core"],
)

cc_library(
    name = "map_presentation",
    srcs = ["map_presentation.cpp"],
    hdrs = ["map_presentation.h"],
    copts = COMMON_COPTS,
    deps = [
        "//bazel/qt:core",
        "//bazel/qt:gui",
        "//src/backend/calibration/session:calibration_session",
    ],
)

fastecu_gtest(
    name = "map_presentation_test",
    srcs = ["map_presentation_test.cpp"],
    deps = [
        ":map_presentation",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "rom_info_test",
    srcs = ["rom_info_test.cpp"],
    deps = [
        ":rom_info",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "hex_parse_qt_compat_test",
    srcs = ["hex_parse_qt_compat_test.cpp"],
    deps = [
        "//bazel/qt:core",
        "//src/backend/definition:text_format",
        "@googletest//:gtest",
    ],
)
