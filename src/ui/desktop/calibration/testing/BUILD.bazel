    default_visibility = ["//bazel/layers:ui"],
)

cc_library(
    name = "mock_calibration_interaction",
    hdrs = ["mock_calibration_interaction.h"],
    deps = [
        "//src/ui/desktop/calibration:calibration_interaction",
        "@googletest//:gtest",
