load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "COMMON_COPTS")

package(default_visibility = ["//bazel/layers:ui"])

# Qt-linked (QMenuBar/QToolBar/QSignalMapper) but declares no QObject of its
# own, so a plain cc_library suffices -- matching
# //src/ui/desktop/checksum:checksum_correction_command.
cc_library(
    name = "menu_builder",
    srcs = ["menu_builder.cpp"],
    hdrs = ["menu_builder.h"],
    copts = COMMON_COPTS,
    implementation_deps = ["//bazel/qt:gui"],
    deps = [
        "//bazel/qt:core",
        "//bazel/qt:widgets",
        "//src/backend/config:menu_definition",
    ],
)

fastecu_gtest(
    name = "menu_builder_test",
    srcs = ["menu_builder_test.cpp"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [
        ":menu_builder",
        "//bazel/qt:core",
        "//bazel/qt:gui",
        "//bazel/qt:widgets",
        "@googletest//:gtest",
    ],
)
