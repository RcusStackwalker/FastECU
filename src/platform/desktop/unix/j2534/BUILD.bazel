# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS")

package(default_visibility = ["//bazel/layers:platform_and_composition_root"])

# Publishes this platform's J2534 API at the shared path
# src/platform/desktop/j2534/j2534_api.h; see j2534_api.h.
cc_library(
    name = "j2534_api",
    hdrs = ["j2534_api.h"],
    # Shared API path selects the OS-specific implementation.
    include_prefix = "src/platform/desktop/j2534",  # keep
    strip_include_prefix = "/src/platform/desktop/unix/j2534",  # keep
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["//src/platform/desktop/unix/j2534/driver:j2534"],
)

cc_library(
    name = "serial_byte_buffer",
    srcs = ["serial_byte_buffer.cpp"],
    hdrs = ["serial_byte_buffer.h"],
    copts = COMMON_COPTS,
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["//bazel/qt:core"],
)

fastecu_gtest(
    name = "serial_byte_buffer_test",
    srcs = ["serial_byte_buffer_test.cpp"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":serial_byte_buffer",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "j2534_types",
    hdrs = ["J2534_tactrix_unix.h"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//src/backend/protocol/j2534:j2534_constants",
        "//src/backend/protocol/j2534:tactrix_constants",
    ],
)
