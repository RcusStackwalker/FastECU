load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_library")

package(default_visibility = [
    "//apps/desktop:__pkg__",
    "//src/platform:__subpackages__",
    "//tests:__pkg__",
])

qt_cc_library(
    name = "j2534",
    srcs = ["J2534_unix.cpp"],
    hdrs = ["J2534_unix.h"],
    copts = COMMON_COPTS,
    normal_hdrs = ["J2534_tactrix_unix.h"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = QT_DEPS + [":serial_byte_buffer"],
)

qt_cc_library(
    name = "serial_byte_buffer",
    srcs = ["serial_byte_buffer.cpp"],
    hdrs = ["serial_byte_buffer.h"],
    copts = COMMON_COPTS,
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = QT_DEPS,
)

fastecu_gtest(
    name = "serial_byte_buffer_test",
    srcs = ["serial_byte_buffer_test.cpp"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":serial_byte_buffer"],
)

# Real pseudo-terminal probe of PassThruReadMsgs's byte-oriented frame parser
# (cpp:S5276 msg_byte_cnt narrowing regression coverage).
fastecu_qttest(
    name = "j2534_unix_test",
    src = "J2534_unix_test.cpp",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":j2534"],
)
