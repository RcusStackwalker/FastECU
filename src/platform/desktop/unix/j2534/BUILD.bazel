# gazelle:alias_kind qt_cc_library cc_library
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "qt_cc_library")

package(default_visibility = ["//bazel/layers:platform_and_composition_root"])

# Publishes this platform's J2534 API at the shared path
# src/platform/desktop/j2534/j2534_api.h; see j2534_api.h.
cc_library(
    name = "j2534_api",
    hdrs = ["j2534_api.h"],
    # Shared API path selects the OS-specific implementation.
    include_prefix = "src/platform/desktop/j2534",  # keep
    strip_include_prefix = "/src/platform/desktop/unix/j2534",  # keep
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":j2534"],
)

# Temporarily hand-owned: pinned alias_kind merging preserves existing attributes.
# See ADR 0017; plain libraries and tests in this package regenerate normally.
# keep
qt_cc_library(
    name = "j2534",
    srcs = ["J2534_unix.cpp"],
    hdrs = ["J2534_unix.h"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":j2534_types",
        ":serial_byte_buffer",
        "//bazel/qt:core",
        "//bazel/qt:serial_port",
    ],
)

cc_library(
    name = "serial_byte_buffer",
    srcs = ["serial_byte_buffer.cpp"],
    hdrs = ["serial_byte_buffer.h"],
    copts = COMMON_COPTS,
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["//bazel/qt:core"],
)

fastecu_gtest(
    name = "serial_byte_buffer_test",
    srcs = ["serial_byte_buffer_test.cpp"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":serial_byte_buffer",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "j2534_types",
    hdrs = ["J2534_tactrix_unix.h"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
