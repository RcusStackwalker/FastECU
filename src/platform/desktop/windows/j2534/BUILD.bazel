load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qt_common.bzl", "COMMON_COPTS")

package(default_visibility = ["//bazel/layers:platform_and_composition_root"])

WINDOWS_ONLY = select({
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Publishes this platform's J2534 API at the shared path
# src/platform/desktop/j2534/j2534_api.h; see j2534_api.h.
cc_library(
    name = "j2534_api",
    hdrs = ["j2534_api.h"],
    # Shared API path selects the OS-specific implementation.
    include_prefix = "src/platform/desktop/j2534",  # keep
    strip_include_prefix = "/src/platform/desktop/windows/j2534",  # keep
    target_compatible_with = WINDOWS_ONLY,
    deps = [":j2534"],
)

cc_library(
    name = "j2534",
    srcs = ["J2534_win.cpp"],
    hdrs = ["J2534_win.h"],
    copts = COMMON_COPTS,
    implementation_deps = [":pe_bitness"],
    target_compatible_with = WINDOWS_ONLY,
    deps = [
        ":j2534_bridge_client",
        ":j2534_bridge_protocol",
    ],
)

cc_library(
    name = "j2534_bridge_protocol",
    srcs = ["j2534_bridge_protocol.cpp"],
    hdrs = [
        "J2534_tactrix_win.h",
        "j2534_bridge_protocol.h",
    ],
    includes = ["."],
    target_compatible_with = WINDOWS_ONLY,
    deps = [
        "//src/backend/protocol/j2534:j2534_constants",
        "//src/backend/protocol/j2534:tactrix_constants",
    ],
)

cc_library(
    name = "pe_bitness",
    srcs = ["pe_bitness.cpp"],
    hdrs = ["pe_bitness.h"],
    includes = ["."],
    target_compatible_with = WINDOWS_ONLY,
)

cc_library(
    name = "j2534_bridge_client",
    srcs = ["j2534_bridge_client.cpp"],
    hdrs = ["j2534_bridge_client.h"],
    includes = ["."],
    target_compatible_with = WINDOWS_ONLY,
    deps = [":j2534_bridge_protocol"],
)

# Externally sourced x64 PE fixture has no local source for Gazelle to discover.
# keep
cc_binary(
    name = "pe_bitness_x64_fixture",
    srcs = ["//bazel/platforms:x86_smoke_test.cc"],
    target_compatible_with = WINDOWS_ONLY,
)
