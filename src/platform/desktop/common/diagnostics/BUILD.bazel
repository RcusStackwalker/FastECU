# The serial facade is still hand-owned in its package.
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
# gazelle:resolve cc src/platform/desktop/common/serial/serial_facade_codes.h //src/platform/desktop/common/serial:serial_port_actions
# gazelle:resolve cc src/platform/desktop/common/serial/serial_port_actions.h //src/platform/desktop/common/serial:serial_port_actions
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "COMMON_COPTS")

package(default_visibility = [
    "//bazel/layers:platform_and_composition_root",
    "//bazel/layers:ui",
])

# IDiagnosticLink over the serial facade. The header forward-declares
# SerialPortActions, so UI callers never see the facade header.
cc_library(
    name = "serial_diagnostic_link",
    srcs = ["serial_diagnostic_link.cpp"],
    hdrs = ["serial_diagnostic_link.h"],
    copts = COMMON_COPTS,
    implementation_deps = [
        "//bazel/qt:core",
        "//bazel/qt:serial_port",
        "//src/backend/ports",
        "//src/platform/desktop/common/bytes:qt_bytes",
        "//src/platform/desktop/common/serial:serial_port_actions",
    ],
    deps = ["//src/backend/protocol"],
)

fastecu_gtest(
    name = "serial_diagnostic_link_test",
    srcs = ["serial_diagnostic_link_test.cpp"],
    deps = [
        ":serial_diagnostic_link",
        "//bazel/qt:core",
        "//bazel/qt:serial_port",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/platform/desktop/common/serial:serial_port_actions",
        "//src/platform/desktop/common/serial/testing:fake_backed_serial",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)
