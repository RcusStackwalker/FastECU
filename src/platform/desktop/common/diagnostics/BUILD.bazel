load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "QT_DEPS", "qt_cc_library")

package(default_visibility = [
    "//bazel/layers:platform_and_composition_root",
    "//bazel/layers:ui",
])

# IDiagnosticLink over the serial facade. The header forward-declares
# SerialPortActions, so UI callers never see the facade header.
# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "serial_diagnostic_link",
    srcs = ["serial_diagnostic_link.cpp"],
    implementation_deps = ["//src/platform/desktop/common/serial:serial_port_actions"],
    normal_hdrs = ["serial_diagnostic_link.h"],
    deps = QT_DEPS + [
        "//src/algorithms/protocol",
        "//src/backend/ports",
        "//src/backend/protocol",
        "//src/platform/desktop/common/bytes:qt_bytes",
    ],
)

fastecu_gtest(
    name = "serial_diagnostic_link_test",
    srcs = ["serial_diagnostic_link_test.cpp"],
    use_gtest_main = False,
    deps = [
        ":serial_diagnostic_link",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/platform/desktop/common/serial/testing:fake_backed_serial",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
        "//src/platform/desktop/common/testing:core_application_environment",
    ],
)

# Runs run_dtc_session on its own thread. Mirrors ServiceFunctionWorker
# without the operator gate: a DTC read/clear has no confirmation step.
# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "dtc_worker",
    srcs = ["dtc_worker.cpp"],
    hdrs = ["dtc_worker.h"],
    deps = QT_DEPS + [
        "//src/backend/diagnostics:dtc_session",
        "//src/backend/ports",
        "//src/backend/protocol",
        "//src/platform/desktop/common/ports",
    ],
)

fastecu_gtest(
    name = "dtc_worker_test",
    srcs = ["dtc_worker_test.cpp"],
    deps = [
        ":serial_diagnostic_link_test",
        "//bazel/qt:core",
        "//src/backend/ports/testing:fake_clock",
        "//src/backend/protocol/testing:fake_diagnostic_link",
        "//src/platform/desktop/common/diagnostics:dtc_worker",
        "//src/platform/desktop/common/testing:event_helpers",
        "//src/platform/desktop/common/testing:signal_recorder",
        "//src/platform/desktop/common/testing:widgets_application_environment",
        "@googletest//:gtest",
    ],
)

# Runs the connect-time SSM identification retry loop on its own thread,
# shaped like DtcWorker.
# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "ssm_identify_worker",
    srcs = ["ssm_identify_worker.cpp"],
    hdrs = ["ssm_identify_worker.h"],
    deps = QT_DEPS + [
        "//src/algorithms/protocol",
        "//src/backend/diagnostics:ssm_identify",
        "//src/backend/ports",
        "//src/backend/protocol",
        "//src/platform/desktop/common/bytes:qt_bytes",
    ],
)

fastecu_gtest(
    name = "ssm_identify_worker_test",
    srcs = ["ssm_identify_worker_test.cpp"],
    deps = [
        ":serial_diagnostic_link_test",
        "//bazel/qt:core",
        "//src/backend/ports/testing:fake_clock",
        "//src/backend/protocol/testing:fake_diagnostic_link",
        "//src/platform/desktop/common/diagnostics:ssm_identify_worker",
        "//src/platform/desktop/common/testing:event_helpers",
        "//src/platform/desktop/common/testing:signal_recorder",
        "//src/platform/desktop/common/testing:widgets_application_environment",
        "@googletest//:gtest",
    ],
)
