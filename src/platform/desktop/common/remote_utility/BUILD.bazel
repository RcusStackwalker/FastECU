load("//bazel:qt_remote_objects.bzl", "qt_replica_library")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "qt_cc_library")

package(default_visibility = ["//bazel/layers:platform_and_composition_root"])

qt_replica_library(
    name = "remote_utility_replicas",
    reps = ["remote_utility.rep"],
    deps = QT_DEPS,
)

qt_cc_library(
    name = "remote_utility",
    srcs = ["remote_utility.cpp"],
    hdrs = ["remote_utility.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        ":remote_utility_replicas",
        # remote_utility.h includes websocketiodevice.h and qtrohelper.hpp.
        "//src/platform/desktop/common/serial:websocket_io",
    ],
)
