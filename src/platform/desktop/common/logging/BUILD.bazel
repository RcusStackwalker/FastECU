load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "QT_DEPS", "qt_cc_library")

package(default_visibility = ["//bazel/layers:platform_and_composition_root"])

# UI-facing adapters, as connection:adapter_connection is: MainWindow holds the
# LoggingEngine and builds its snapshots and values through these adapters.
UI_FACING_VISIBILITY = [
    "//bazel/layers:platform_and_composition_root",
    "//bazel/layers:ui_desktop",
]

# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "logging",
    srcs = ["systemlogger.cpp"],
    hdrs = ["systemlogger.h"],
    deps = QT_DEPS,
)

fastecu_gtest(
    name = "test_logging_adapters",
    srcs = ["logging_adapters_test.cpp"],
    deps = [
        "//src/backend/ports/testing:result_matchers",
        "//src/platform/desktop/common/logging:logging_adapters",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "test_logging_engine",
    srcs = ["logging_engine_test.cpp"],
    deps = [
        "//src/backend/logging/testing:scripted_logging_protocol",
        "//src/platform/desktop/common/logging:logging_runtime",
        "//src/platform/desktop/common/testing:core_application_environment",
        "//src/platform/desktop/common/testing:event_helpers",
        "//src/platform/desktop/common/testing:signal_recorder",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "test_logging_worker",
    srcs = ["logging_worker_test.cpp"],
    deps = [
        "//bazel/qt:core",
        "//src/backend/logging/testing:scripted_logging_protocol",
        "//src/platform/desktop/common/logging:logging_runtime",
        "//src/platform/desktop/common/testing:core_application_environment",
        "//src/platform/desktop/common/testing:event_helpers",
        "//src/platform/desktop/common/testing:signal_recorder",
        "@googletest//:gtest",
    ],
)

# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "logging_runtime",
    srcs = [
        "cdbg_serial_setup.cpp",
        "logging_engine.cpp",
        "logging_worker.cpp",
    ],
    hdrs = [
        "logging_engine.h",
        "logging_worker.h",
    ],
    normal_hdrs = [
        "cdbg_serial_setup.h",
    ],
    visibility = UI_FACING_VISIBILITY,
    deps = QT_DEPS + [
        ":logging_adapters",
        "//src/backend/logging:logging_use_case",
        "//src/backend/ports",
        "//src/platform/desktop/common/ports",
    ],
)

# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "logging_adapters",
    srcs = [
        "logging_snapshot_adapter.cpp",
        "logging_value_adapter.cpp",
    ],
    normal_hdrs = [
        "logging_snapshot_adapter.h",
        "logging_value_adapter.h",
    ],
    visibility = UI_FACING_VISIBILITY,
    deps = QT_DEPS + [
        "//src/backend/logging:logger_model",
        "//src/backend/logging:logging_session",
        "//src/backend/ports",
    ],
)
