load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_library")

package(default_visibility = [
    "//apps/desktop:__pkg__",
    "//src/platform:__subpackages__",
    "//tests:__pkg__",
    # GRANDFATHERED (Task 5 human decision): //src/ui/desktop includes
    # systemlogger.h directly (mainwindow.h:95). This is a real ui ->
    # platform edge the modularization plan has not yet removed.
    "//src/ui/desktop:__pkg__",
])

qt_cc_library(
    name = "logging",
    srcs = ["systemlogger.cpp"],
    hdrs = ["systemlogger.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS,
)

fastecu_gtest(
    name = "test_logging_adapters",
    srcs = ["logging_adapters_test.cpp"],
    deps = [
        ":logging_adapters",
        "//src/backend/logging:logger_definition_model",
    ],
)

fastecu_qttest(
    name = "test_logging_engine",
    src = "logging_engine_test.cpp",
    deps = [
        ":logging_runtime",
        "//src/backend/logging/testing:scripted_logging_protocol",
    ],
)

fastecu_qttest(
    name = "test_logging_worker",
    src = "logging_worker_test.cpp",
    deps = [
        ":logging_runtime",
        "//src/backend/logging/testing:scripted_logging_protocol",
    ],
)

qt_cc_library(
    name = "logging_runtime",
    srcs = [
        "logging_engine.cpp",
        "logging_worker.cpp",
    ],
    hdrs = [
        "logging_engine.h",
        "logging_worker.h",
    ],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        "//src/backend/logging:logging_use_case",
        "//src/backend/ports",
        "//src/platform/desktop/common/ports",
    ],
)

qt_cc_library(
    name = "logging_adapters",
    srcs = [
        "logging_snapshot_adapter.cpp",
        "logging_value_adapter.cpp",
    ],
    hdrs = [],
    copts = COMMON_COPTS,
    normal_hdrs = [
        "logging_snapshot_adapter.h",
        "logging_value_adapter.h",
    ],
    deps = QT_DEPS + [
        "//src/backend/definitions",
        "//src/backend/logging:logging_session",
        "//src/backend/ports",
    ],
)
