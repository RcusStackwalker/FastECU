load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "QT_DEPS", "qt_cc_library")

package(default_visibility = [
    "//bazel/layers:platform_and_composition_root",
    "//bazel/layers:ui",
])

# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "service_function_worker",
    srcs = [
        "serial_facade_configurator.cpp",
        "service_function_worker.cpp",
    ],
    hdrs = [
        "service_function_worker.h",
    ],
    implementation_deps = ["//src/platform/desktop/common/serial:serial_port_actions"],
    normal_hdrs = [
        "serial_facade_configurator.h",
    ],
    deps = QT_DEPS + [
        "//src/backend/ports",
        "//src/backend/protocol",
        "//src/backend/service_functions:service_function_session",
        "//src/platform/desktop/common/ports",
    ],
)

fastecu_gtest(
    name = "test_serial_facade_configurator",
    srcs = ["serial_facade_configurator_test.cpp"],
    deps = [
        "//bazel/qt:core",
        "//src/platform/desktop/common/serial:serial_port_actions",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
        "//src/platform/desktop/common/service_functions:service_function_worker",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "test_service_function_worker",
    srcs = ["service_function_worker_test.cpp"],
    deps = [
        "//bazel/qt:core",
        "//src/backend/ports/testing:fake_clock",
        "//src/backend/protocol/testing:scripted_transports",
        "//src/platform/desktop/common/service_functions:service_function_worker",
        "//src/platform/desktop/common/testing:core_application_environment",
        "//src/platform/desktop/common/testing:event_helpers",
        "//src/platform/desktop/common/testing:signal_recorder",
        "@googletest//:gtest",
    ],
)
