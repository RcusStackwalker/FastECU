# The only library declares Q_OBJECT; generated hdrs must run through moc.
# gazelle:map_kind cc_library qt_cc_library //bazel:qt_targets.bzl
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
# The serial facade is still hand-owned in its package.
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "qt_cc_library")

package(default_visibility = [
    "//bazel/layers:platform_and_composition_root",
    "//bazel/layers:ui_desktop",
])

# MainWindow's connection handling over the serial facade. The header
# forward-declares SerialPortActions, so the UI never includes the facade
# header through it.
qt_cc_library(
    name = "adapter_connection",
    srcs = ["adapter_connection.cpp"],
    hdrs = ["adapter_connection.h"],
    implementation_deps = [
        "//bazel/qt:serial_port",
        "//src/platform/desktop/common/serial/facade:serial_port_actions",
    ],
    deps = [
        "//bazel/qt:core",
        "//bazel/qt:remote_objects",
    ],
)

fastecu_gtest(
    name = "adapter_connection_test",
    srcs = ["adapter_connection_test.cpp"],
    deps = [
        ":adapter_connection",
        "//bazel/qt:core",
        "//bazel/qt:serial_port",
        "//src/platform/desktop/common/serial/testing:fake_backed_serial",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
        "//src/platform/desktop/common/testing:core_application_environment",
        "//src/platform/desktop/common/testing:event_helpers",
        "//src/platform/desktop/common/testing:signal_recorder",
        "@googletest//:gtest",
    ],
)
