# Tests regenerate; production sources and helper binaries retain existing owners.
# gazelle:exclude core_application_environment.h
# gazelle:exclude event_helpers.h
# gazelle:exclude signal_recorder.h
# gazelle:exclude widgets_application_environment.h
# gazelle:resolve cc src/platform/desktop/common/testing/core_application_environment.h //src/platform/desktop/common/testing:core_application_environment
# gazelle:resolve cc src/platform/desktop/common/testing/event_helpers.h //src/platform/desktop/common/testing:event_helpers
# gazelle:resolve cc src/platform/desktop/common/testing/signal_recorder.h //src/platform/desktop/common/testing:signal_recorder
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")

# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
package(default_visibility = [
    "//bazel/layers:apps",
    "//bazel/layers:platform",
    "//bazel/layers:tests",
    "//bazel/layers:ui",
])

# Production and runtime helper ownership is deferred by ADR 0017.
# keep
cc_library(
    name = "core_application_environment",
    testonly = True,
    hdrs = ["core_application_environment.h"],
    deps = [
        "//bazel/qt:core",
        "@googletest//:gtest",
    ],
)

# Production and runtime helper ownership is deferred by ADR 0017.
# keep
cc_library(
    name = "event_helpers",
    testonly = True,
    hdrs = ["event_helpers.h"],
    deps = ["//bazel/qt:core"],
)

# Production and runtime helper ownership is deferred by ADR 0017.
# keep
cc_library(
    name = "signal_recorder",
    testonly = True,
    hdrs = ["signal_recorder.h"],
    deps = ["//bazel/qt:core"],
)

fastecu_gtest(
    name = "qt_test_support_test",
    srcs = ["qt_test_support_test.cpp"],
    deps = [
        "//bazel/qt:core",
        "//src/platform/desktop/common/testing:core_application_environment",
        "//src/platform/desktop/common/testing:event_helpers",
        "//src/platform/desktop/common/testing:signal_recorder",
        "@googletest//:gtest",
    ],
)

# Production and runtime helper ownership is deferred by ADR 0017.
# keep
cc_library(
    name = "widgets_application_environment",
    testonly = True,
    hdrs = ["widgets_application_environment.h"],
    deps = [
        ":core_application_environment",
        "//bazel/qt:widgets",
    ],
)
