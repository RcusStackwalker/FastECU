# Tests regenerate; production sources and helper binaries retain existing owners.
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
# gazelle:exclude fake_backed_serial.h
# gazelle:exclude fake_backend.h
# gazelle:resolve cc src/platform/desktop/common/serial/serial_port_actions.h //src/platform/desktop/common/serial:serial_port_actions
# gazelle:resolve cc src/platform/desktop/common/serial/testing/fake_backed_serial.h //src/platform/desktop/common/serial/testing:fake_backed_serial
# gazelle:resolve cc src/platform/desktop/common/serial/testing/fake_backend.h //src/platform/desktop/common/serial/testing:fake_serial_backend
# gazelle:resolve cc src/platform/desktop/common/testing/core_application_environment.h //src/platform/desktop/common/testing:core_application_environment
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "QT_DEPS", "qt_cc_library")

package(default_visibility = ["//bazel/layers:src"])

# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "fake_serial_backend",
    testonly = True,
    srcs = [],
    hdrs = ["fake_backend.h"],
    deps = QT_DEPS + [
        # FakeBackend derives from SerialPortActionsDirect
        # (serial_port_actions_direct.h), owned by the platform's direct
        # backend; :direct_serial_backend_for_tests is its testonly alias.
        "//src/platform/desktop/common/serial:direct_serial_backend_for_tests",
        "//src/platform/desktop/common/serial:serial_port_actions",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "fake_backend_test",
    srcs = ["fake_backend_test.cpp"],
    use_gtest_main = False,
    deps = [
        "//bazel/qt:core",
        "//src/platform/desktop/common/serial:serial_port_actions",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)

# A SerialPortActions facade over a Google Mock FakeBackend.
# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "fake_backed_serial",
    testonly = True,
    srcs = [],
    # Header-only class template, no Q_OBJECT: normal_hdrs, not hdrs, so moc
    # does not run over it.
    normal_hdrs = ["fake_backed_serial.h"],
    deps = QT_DEPS + [
        ":fake_serial_backend",
        "//src/platform/desktop/common/serial:serial_port_actions",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "test_fake_backed_serial",
    srcs = ["fake_backed_serial_test.cpp"],
    use_gtest_main = False,
    deps = [
        "//bazel/qt:core",
        "//src/platform/desktop/common/serial/testing:fake_backed_serial",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)
