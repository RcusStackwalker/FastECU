# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "COMMON_COPTS")

package(default_visibility = ["//bazel/layers:src"])

cc_library(
    name = "fake_serial_backend",
    testonly = True,
    hdrs = ["fake_backend.h"],
    copts = COMMON_COPTS,
    deps = [
        "//src/platform/desktop/common/serial:direct_serial_backend_for_tests",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "fake_backend_test",
    srcs = ["fake_backend_test.cpp"],
    deps = [
        ":fake_serial_backend",
        "//bazel/qt:core",
        "//src/platform/desktop/common/serial/facade:serial_port_actions",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)

# A SerialPortActions facade over a Google Mock FakeBackend.
cc_library(
    name = "fake_backed_serial",
    testonly = True,
    hdrs = ["fake_backed_serial.h"],
    copts = COMMON_COPTS,
    deps = [
        ":fake_serial_backend",
        "//src/platform/desktop/common/serial/facade:serial_port_actions",
    ],
)

fastecu_gtest(
    name = "test_fake_backed_serial",
    srcs = ["fake_backed_serial_test.cpp"],
    deps = [
        ":fake_backed_serial",
        "//bazel/qt:core",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)
