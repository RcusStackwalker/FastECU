load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_library")

package(default_visibility = ["//src:__subpackages__"])

qt_cc_library(
    name = "fake_serial_backend",
    testonly = True,
    srcs = [],
    hdrs = ["fake_backend.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        # FakeBackend derives from SerialPortActionsDirect
        # (serial_port_actions_direct.h), which serial_platform_api's wrapped
        # target (serial_qt_compat) no longer carries after the direct/remote
        # backend split (step 6e-1 task 5) -- depend on the owning target
        # directly.
        "//src/platform/desktop/common/serial:direct_serial_backend",
        "//src/platform/desktop/common/serial:serial_platform_api",
        "@googletest//:gtest",
    ],
)

fastecu_qttest(
    name = "fake_backend_test",
    src = "fake_backend_test.cpp",
    deps = [
        ":fake_serial_backend",
        "//src/platform/desktop/common/serial:serial_platform_api",
    ],
)
