# The remote backend declares Q_OBJECT; generated hdrs must run through moc.
# gazelle:map_kind cc_library qt_cc_library //bazel:qt_targets.bzl
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
# gazelle:resolve cc QWebSocket //bazel/qt:web_sockets
# The replica header is generated by the parent package's hand-owned replica
# library, which Gazelle cannot see.
# gazelle:resolve cc rep_serial_port_actions_replica.h //src/platform/desktop/common/serial:serial_replicas
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "qt_cc_library")

package(default_visibility = ["//src/platform/desktop/common/serial:__pkg__"])

# The remote backend (Qt Remote Objects over a websocket).
qt_cc_library(
    name = "remote_serial_backend",
    srcs = ["remote_serial_backend.cpp"],
    hdrs = ["remote_serial_backend.h"],
    implementation_deps = [
        "//bazel/qt:web_sockets",
        "//src/platform/desktop/common/serial:qtrohelper",
        "//src/platform/desktop/common/serial:serial_replicas",
    ],
    deps = [
        "//bazel/qt:core",
        "//bazel/qt:remote_objects",
        "//src/platform/desktop/common/serial:serial_backend",
        "//src/platform/desktop/common/serial/websocket:websocket_io",
    ],
)

fastecu_gtest(
    name = "test_remote_backend_smoke",
    size = "small",
    srcs = ["remote_backend_smoke_test.cpp"],
    deps = [
        ":remote_serial_backend",
        "//bazel/qt:core",
        "//bazel/qt:web_sockets",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)
