# The device declares Q_OBJECT; generated hdrs must run through moc.
# gazelle:map_kind cc_library qt_cc_library //bazel:qt_targets.bzl
load("//bazel:qt_targets.bzl", "qt_cc_library")

package(
    default_visibility = [
        "//src/platform/desktop/common/remote_utility:__pkg__",
        "//src/platform/desktop/common/serial/remote:__pkg__",
    ],
)

# The QIODevice-over-websocket adapter, shared by the remote serial backend and
# remote_utility. Carries no facade header, so remote_utility (and the UI above
# it) does not reach the facade.
qt_cc_library(
    name = "websocket_io",
    srcs = ["websocketiodevice.cpp"],
    hdrs = ["websocketiodevice.h"],
    deps = [
        "//bazel/qt:core",
        "//bazel/qt:web_sockets",
    ],
)
