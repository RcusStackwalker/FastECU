# The J2534 driver-selection sources are chosen per platform by the library's
# own select(), so discovery must not treat either as a package source.
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
# gazelle:resolve cc QRemoteObjectPendingCallWatcher //bazel/qt:remote_objects
# gazelle:exclude j2534_driver_selection_unix.cpp
# gazelle:exclude j2534_driver_selection_windows.cpp
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "COMMON_COPTS")
load("//bazel:qt_remote_objects.bzl", "qt_replica_library")
load("//bazel:qt_targets.bzl", "QT_DEPS")

package(default_visibility = ["//bazel/layers:platform_and_composition_root"])

# Qt Remote Objects replica generated from serial_port_actions.rep. Replica
# generation is hand-owned: Gazelle cannot see the generated header, so the
# remote package resolves its `rep_serial_port_actions_replica.h` include to
# this target.
qt_replica_library(
    name = "serial_replicas",
    reps = ["serial_port_actions.rep"],
    deps = QT_DEPS,
)

# The interface the facade and its two backends implement. The facade itself
# lives in //src/platform/desktop/common/serial/facade; adapters whose public
# headers forward-declare SerialPortActions take it as implementation_deps so
# its headers stay out of their dependents' compile inputs.
cc_library(
    name = "serial_backend",
    hdrs = ["serial_backend.h"],
    copts = COMMON_COPTS,
    visibility = [
        "//bazel/layers:tests",
        "//src/platform/desktop:__subpackages__",
    ],
    deps = ["//bazel/qt:core"],
)

cc_library(
    name = "serial_facade_codes",
    hdrs = ["serial_facade_codes.h"],
    copts = COMMON_COPTS,
    visibility = [
        "//bazel/layers:tests",
        "//src/platform/desktop:__subpackages__",
    ],
)

cc_library(
    name = "serial_backend_host",
    srcs = ["serial_backend_host.cpp"],
    hdrs = ["serial_backend_host.h"],
    copts = COMMON_COPTS,
    implementation_deps = [":serial_backend"],
    visibility = ["//src/platform/desktop/common/serial/facade:__pkg__"],
    deps = ["//bazel/qt:core"],
)

# The Qt Remote Objects synchronous-call helper shared by the remote backend
# and remote_utility. It carries no facade header.
cc_library(
    name = "qtrohelper",
    hdrs = ["qtrohelper.hpp"],
    copts = COMMON_COPTS,
    visibility = [
        "//src/platform/desktop/common/remote_utility:__pkg__",
        "//src/platform/desktop/common/serial/remote:__pkg__",
    ],
    deps = ["//bazel/qt:remote_objects"],
)

# isJ2534CapableEntry and the J2534 driver-registry helpers. Shared by the
# direct backend and the desktop CAN transport factory. The platform
# implementation is chosen by select(); no include expresses that choice, so
# `srcs` is an explained keep.
cc_library(
    name = "j2534_driver_selection",
    srcs = select({
        "@platforms//os:windows": ["j2534_driver_selection_windows.cpp"],
        "//conditions:default": ["j2534_driver_selection_unix.cpp"],
    }),  # keep
    hdrs = ["j2534_driver_selection.h"],
    copts = COMMON_COPTS,
    visibility = [
        "//src/platform/desktop/common/serial:__subpackages__",
        "//src/platform/desktop/common/transport:__pkg__",
    ],
    deps = ["//bazel/qt:core"],
)

fastecu_gtest(
    name = "j2534_driver_selection_unix_test",
    size = "small",
    srcs = ["j2534_driver_selection_unix_test.cpp"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":j2534_driver_selection",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "j2534_driver_selection_windows_test",
    size = "small",
    srcs = ["j2534_driver_selection_windows_test.cpp"],
    target_compatible_with = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":j2534_driver_selection",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)

# make_direct_serial_backend(), declared without an implementation. A binary
# links exactly one of the platform hook libraries beside it; the binary's own
# select() names the platform.
cc_library(
    name = "direct_serial_backend",
    hdrs = ["direct_serial_backend.h"],
    copts = COMMON_COPTS,
    visibility = [
        "//bazel/layers:tests",
        "//src/platform/desktop/common/serial:__subpackages__",
    ],
)

# For tests that drive the real direct backend. Production binaries select
# the implementation themselves (apps/desktop, apps/bench).
alias(
    name = "direct_serial_backend_for_tests",
    testonly = True,
    actual = select({
        "@platforms//os:windows": "//src/platform/desktop/common/serial/direct/windows:serial_port_actions_direct_windows",
        "//conditions:default": "//src/platform/desktop/common/serial/direct/unix:serial_port_actions_direct_unix",
    }),
    visibility = [
        "//src/platform/desktop/common/serial:__subpackages__",
        "//tests:__pkg__",
    ],
)

# Constructor-only entry point to SerialPortActions for the composition
# roots: they own the facade without seeing its API. Its include of
# direct_serial_backend.h resolves to the declaration-only API library, never
# to the test alias.
cc_library(
    name = "desktop_serial_factory",
    srcs = ["desktop_serial_factory.cpp"],
    hdrs = ["desktop_serial_factory.h"],
    copts = COMMON_COPTS,
    implementation_deps = [
        ":direct_serial_backend",
        "//src/platform/desktop/common/serial/facade:serial_port_actions",
        "//src/platform/desktop/common/serial/remote:remote_serial_backend",
    ],
    visibility = [
        "//bazel/layers:apps_bench",
        "//bazel/layers:apps_desktop",
    ],
    deps = ["//bazel/qt:core"],
)

fastecu_gtest(
    name = "desktop_serial_factory_test",
    size = "small",
    srcs = ["desktop_serial_factory_test.cpp"],
    deps = [
        # The test drives the real direct backend the factory selects at runtime.
        ":direct_serial_backend_for_tests",  # keep
        ":desktop_serial_factory",
        "//bazel/qt:core",
        "//src/platform/desktop/common/serial/direct:serial_port_actions_direct",
        "//src/platform/desktop/common/serial/facade:serial_port_actions",
        "//src/platform/desktop/common/serial/remote:remote_serial_backend",
        "//src/platform/desktop/common/serial/testing/log_sink:recording_log_sink",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)

# The idle line state MainWindow restores before and after every ECU
# operation. It calls the facade, so it lives beside it.
cc_library(
    name = "serial_idle",
    srcs = ["serial_idle.cpp"],
    hdrs = ["serial_idle.h"],
    copts = COMMON_COPTS,
    implementation_deps = [
        "//bazel/qt:serial_port",
        "//src/platform/desktop/common/serial/facade:serial_port_actions",
    ],
    visibility = ["//bazel/layers:ui_desktop"],
)

fastecu_gtest(
    name = "serial_idle_test",
    size = "small",
    srcs = ["serial_idle_test.cpp"],
    deps = [
        ":serial_idle",
        "//bazel/qt:core",
        "//bazel/qt:serial_port",
        "//src/platform/desktop/common/serial/facade:serial_port_actions",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)
