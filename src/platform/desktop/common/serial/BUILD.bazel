load("//bazel:qt_remote_objects.bzl", "qt_replica_library")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_library", "qt_cc_test", "qt_cpp_moc_headers")

package(default_visibility = ["//bazel/layers:platform_and_composition_root"])

# root //:windows_preprocessor_guards reads serial_port_actions_direct.h as
# `data`; that reference is plumbing, not a layer dependency, so export it to
# the root package specifically rather than widen the package's general
# default_visibility.
exports_files(
    ["serial_port_actions_direct.h"],
    visibility = ["//:__pkg__"],
)

qt_replica_library(
    name = "serial_replicas",
    reps = ["serial_port_actions.rep"],
    deps = QT_DEPS,
)

# The SerialPortActions facade and the SerialBackend seam its two backends
# implement. Platform-only: backend and UI code reach serial I/O through
# backend ports and the platform adapters that implement them, never through
# this target. Adapters whose public headers forward-declare
# SerialPortActions take it as implementation_deps so its headers stay out
# of their dependents' compile inputs.
qt_cc_library(
    name = "serial_port_actions",
    srcs = [
        "serial_backend_host.cpp",
        "serial_port_actions.cpp",
    ],
    hdrs = ["serial_port_actions.h"],
    normal_hdrs = [
        "serial_backend.h",
        "serial_backend_host.h",
        "serial_facade_codes.h",
    ],
    visibility = [
        "//bazel/layers:tests",
        "//src/platform/desktop:__subpackages__",
    ],
    deps = QT_DEPS + [
        "//src/algorithms/protocol",
        "//src/algorithms/protocol/qt_compat",
    ],
)

# isJ2534CapableEntry and the J2534 driver-registry helpers. Shared by the
# direct backend and the desktop CAN transport factory.
qt_cc_library(
    name = "j2534_driver_selection",
    srcs = select({
        "@platforms//os:windows": ["j2534_driver_selection_windows.cpp"],
        "//conditions:default": ["j2534_driver_selection_unix.cpp"],
    }),
    normal_hdrs = ["j2534_driver_selection.h"],
    visibility = [
        "//src/platform/desktop/common/serial:__pkg__",
        "//src/platform/desktop/common/transport:__pkg__",
    ],
    deps = QT_DEPS,
)

fastecu_qttest(
    name = "j2534_driver_selection_unix_test",
    size = "small",
    src = "j2534_driver_selection_unix_test.cpp",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":j2534_driver_selection"],
)

fastecu_qttest(
    name = "j2534_driver_selection_windows_test",
    size = "small",
    src = "j2534_driver_selection_windows_test.cpp",
    target_compatible_with = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":j2534_driver_selection"],
)

# make_direct_serial_backend(), declared without an implementation. A binary
# links exactly one of :direct_serial_backend_unix / _windows beside it; the
# binary's own select() names the platform.
qt_cc_library(
    name = "direct_serial_backend_api",
    srcs = [],
    normal_hdrs = ["direct_serial_backend.h"],
    visibility = ["//src/platform/desktop/common/serial:__pkg__"],
    deps = QT_DEPS,
)

DIRECT_SERIAL_BACKEND_VISIBILITY = [
    "//bazel/layers:apps_bench",
    "//bazel/layers:apps_desktop",
    "//bazel/layers:tests",
    "//src/platform/desktop/common/serial:__pkg__",
]

# qt_cc_library names its generated moc genrule after the header's basename
# alone (moc_serial_port_actions_direct), not after the calling target, so two
# targets in one package cannot both list serial_port_actions_direct.h in
# `hdrs`: the package fails to load on every platform, regardless of
# target_compatible_with. Moc it once here and have both platform targets
# depend on the result (see "One header cannot be moc'd by two targets" in
# docs/design-notes.md). This avoids touching the vendored moc macro in
# third_party/qt/qt.bzl.
qt_cc_library(
    name = "serial_port_actions_direct_moc",
    srcs = [],
    hdrs = ["serial_port_actions_direct.h"],
    visibility = ["//visibility:private"],
    deps = QT_DEPS + [
        ":serial_port_actions",
        "//src/algorithms/protocol",
        "//src/algorithms/protocol/qt_compat",
    ] + select({
        "@platforms//os:windows": ["//src/platform/desktop/windows/j2534:j2534_api"],
        "//conditions:default": ["//src/platform/desktop/unix/j2534:j2534_api"],
    }),
)

qt_cc_library(
    name = "direct_serial_backend_unix",
    srcs = [
        "direct_serial_backend.cpp",
        "serial_port_actions_direct.cpp",
        "serial_port_actions_direct_unix.cpp",
    ],
    normal_hdrs = [
        "direct_serial_backend.h",
        "serial_port_actions_direct.h",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = DIRECT_SERIAL_BACKEND_VISIBILITY,
    deps = QT_DEPS + [
        ":j2534_driver_selection",
        ":serial_port_actions",
        ":serial_port_actions_direct_moc",
        "//src/algorithms/protocol",
        "//src/algorithms/protocol/qt_compat",
        "//src/platform/desktop/unix/j2534:j2534_api",
    ],
    # Composition roots link the selected implementation beside a
    # declaration-only factory dependency, so its entry point must survive
    # archive ordering.
    alwayslink = True,
)

# Windows compiles only in CI; kept textually symmetric with the Unix target
# above rather than factored, so a CI-only compile failure is easy to
# correlate with its Unix counterpart.
qt_cc_library(
    name = "direct_serial_backend_windows",
    srcs = [
        "direct_serial_backend.cpp",
        "serial_port_actions_direct.cpp",
        "serial_port_actions_direct_windows.cpp",
    ],
    normal_hdrs = [
        "direct_serial_backend.h",
        "serial_port_actions_direct.h",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = DIRECT_SERIAL_BACKEND_VISIBILITY,
    deps = QT_DEPS + [
        ":j2534_driver_selection",
        ":serial_port_actions",
        ":serial_port_actions_direct_moc",
        "//src/algorithms/protocol",
        "//src/algorithms/protocol/qt_compat",
        "//src/platform/desktop/windows/j2534:j2534_api",
    ],
    alwayslink = True,
)

# For tests that drive the real direct backend. Production binaries select
# the implementation themselves (apps/desktop, apps/bench).
alias(
    name = "direct_serial_backend_for_tests",
    testonly = True,
    actual = select({
        "@platforms//os:windows": ":direct_serial_backend_windows",
        "//conditions:default": ":direct_serial_backend_unix",
    }),
    visibility = [
        "//src/platform/desktop/common/serial:__pkg__",
        # testing/fake_backend.h derives FakeBackend from
        # SerialPortActionsDirect, a real same-layer consumer of the header
        # this target's underlying implementation owns.
        "//src/platform/desktop/common/serial/testing:__pkg__",
        "//tests:__pkg__",
    ],
)

fastecu_qttest(
    name = "direct_backend_hooks_unix_test",
    size = "small",
    src = "direct_backend_hooks_unix_test.cpp",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":direct_serial_backend_for_tests"],
)

fastecu_qttest(
    name = "direct_backend_hooks_windows_test",
    size = "small",
    src = "direct_backend_hooks_windows_test.cpp",
    target_compatible_with = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":direct_serial_backend_for_tests"],
)

# The QIODevice-over-websocket adapter and the Qt Remote Objects helper,
# shared by the remote serial backend and remote_utility. Carries no facade
# header, so remote_utility (and the UI above it) does not reach the facade.
qt_cc_library(
    name = "websocket_io",
    srcs = ["websocketiodevice.cpp"],
    hdrs = ["websocketiodevice.h"],
    normal_hdrs = ["qtrohelper.hpp"],
    visibility = [
        "//src/platform/desktop/common/remote_utility:__pkg__",
        "//src/platform/desktop/common/serial:__pkg__",
    ],
    deps = QT_DEPS,
)

# The remote backend (Qt Remote Objects over a websocket).
qt_cc_library(
    name = "remote_serial_backend",
    srcs = ["remote_serial_backend.cpp"],
    hdrs = ["remote_serial_backend.h"],
    visibility = ["//src/platform/desktop/common/serial:__pkg__"],
    deps = QT_DEPS + [
        ":serial_port_actions",
        ":serial_replicas",
        ":websocket_io",
    ],
)

# Constructor-only entry point to SerialPortActions for the composition
# roots: they own the facade without seeing its API.
qt_cc_library(
    name = "desktop_serial_factory",
    srcs = ["desktop_serial_factory.cpp"],
    implementation_deps = [":serial_port_actions"],
    normal_hdrs = ["desktop_serial_factory.h"],
    visibility = [
        "//bazel/layers:apps_bench",
        "//bazel/layers:apps_desktop",
    ],
    deps = QT_DEPS + [
        ":direct_serial_backend_api",
        ":remote_serial_backend",
    ],
)

fastecu_qttest(
    name = "desktop_serial_factory_test",
    size = "small",
    src = "desktop_serial_factory_test.cpp",
    deps = [
        ":desktop_serial_factory",
        ":direct_serial_backend_for_tests",
        ":remote_serial_backend",
        ":serial_port_actions",
    ],
)

