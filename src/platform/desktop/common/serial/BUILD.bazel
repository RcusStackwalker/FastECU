# The direct backend and the J2534 selector keep hand-owned rules until they
# migrate; their sources are excluded from discovery and their headers resolved
# to those rules below.
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
# gazelle:resolve cc QRemoteObjectPendingCallWatcher //bazel/qt:remote_objects
# gazelle:exclude direct_serial_backend.cpp
# gazelle:exclude direct_serial_backend.h
# gazelle:exclude j2534_driver_selection.h
# gazelle:exclude j2534_driver_selection_unix.cpp
# gazelle:exclude j2534_driver_selection_windows.cpp
# gazelle:exclude serial_port_actions_direct.cpp
# gazelle:exclude serial_port_actions_direct.h
# gazelle:exclude serial_port_actions_direct_unix.cpp
# gazelle:exclude serial_port_actions_direct_windows.cpp
# gazelle:resolve cc src/platform/desktop/common/serial/direct_serial_backend.h //src/platform/desktop/common/serial:direct_serial_backend_api
# gazelle:resolve cc src/platform/desktop/common/serial/j2534_driver_selection.h //src/platform/desktop/common/serial:j2534_driver_selection
# gazelle:resolve cc src/platform/desktop/common/serial/serial_port_actions_direct.h //src/platform/desktop/common/serial:direct_serial_backend_for_tests
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "COMMON_COPTS")
load("//bazel:qt_remote_objects.bzl", "qt_replica_library")
load("//bazel:qt_targets.bzl", "QT_DEPS", "qt_cc_library")

package(default_visibility = ["//bazel/layers:platform_and_composition_root"])

# root //:windows_preprocessor_guards reads serial_port_actions_direct.h as
# `data`; that reference is plumbing, not a layer dependency, so export it to
# the root package specifically rather than widen the package's general
# default_visibility.
exports_files(
    ["serial_port_actions_direct.h"],
    visibility = ["//:__pkg__"],
)

# Qt Remote Objects replica generated from serial_port_actions.rep. Replica
# generation is hand-owned: Gazelle cannot see the generated header, so the
# remote package resolves its `rep_serial_port_actions_replica.h` include to
# this target.
qt_replica_library(
    name = "serial_replicas",
    reps = ["serial_port_actions.rep"],
    deps = QT_DEPS,
)

# The interface the facade and its two backends implement. The facade itself
# lives in //src/platform/desktop/common/serial/facade; adapters whose public
# headers forward-declare SerialPortActions take it as implementation_deps so
# its headers stay out of their dependents' compile inputs.
cc_library(
    name = "serial_backend",
    hdrs = ["serial_backend.h"],
    copts = COMMON_COPTS,
    visibility = [
        "//bazel/layers:tests",
        "//src/platform/desktop:__subpackages__",
    ],
    deps = ["//bazel/qt:core"],
)

cc_library(
    name = "serial_facade_codes",
    hdrs = ["serial_facade_codes.h"],
    copts = COMMON_COPTS,
    visibility = [
        "//bazel/layers:tests",
        "//src/platform/desktop:__subpackages__",
    ],
)

cc_library(
    name = "serial_backend_host",
    srcs = ["serial_backend_host.cpp"],
    hdrs = ["serial_backend_host.h"],
    copts = COMMON_COPTS,
    implementation_deps = [":serial_backend"],
    visibility = ["//src/platform/desktop/common/serial/facade:__pkg__"],
    deps = ["//bazel/qt:core"],
)

# The Qt Remote Objects synchronous-call helper shared by the remote backend
# and remote_utility. It carries no facade header.
cc_library(
    name = "qtrohelper",
    hdrs = ["qtrohelper.hpp"],
    copts = COMMON_COPTS,
    visibility = [
        "//src/platform/desktop/common/remote_utility:__pkg__",
        "//src/platform/desktop/common/serial/remote:__pkg__",
    ],
    deps = ["//bazel/qt:remote_objects"],
)

# isJ2534CapableEntry and the J2534 driver-registry helpers. Shared by the
# direct backend and the desktop CAN transport factory.
# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "j2534_driver_selection",
    srcs = select({
        "@platforms//os:windows": ["j2534_driver_selection_windows.cpp"],
        "//conditions:default": ["j2534_driver_selection_unix.cpp"],
    }),
    normal_hdrs = ["j2534_driver_selection.h"],
    visibility = [
        "//src/platform/desktop/common/serial:__pkg__",
        "//src/platform/desktop/common/transport:__pkg__",
    ],
    deps = QT_DEPS,
)

fastecu_gtest(
