# make_direct_serial_backend(), declared without an implementation. A binary
# links exactly one of :direct_serial_backend_unix / _windows beside it; the
# binary's own select() names the platform.
# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "direct_serial_backend_api",
    srcs = [],
    normal_hdrs = ["direct_serial_backend.h"],
    visibility = ["//src/platform/desktop/common/serial:__pkg__"],
    deps = QT_DEPS,
)

DIRECT_SERIAL_BACKEND_VISIBILITY = [
    "//bazel/layers:apps_bench",
    "//bazel/layers:apps_desktop",
    "//bazel/layers:tests",
    "//src/platform/desktop/common/serial:__pkg__",
]

# qt_cc_library names its generated moc genrule after the header's basename
# alone (moc_serial_port_actions_direct), not after the calling target, so two
# targets in one package cannot both list serial_port_actions_direct.h in
# `hdrs`: the package fails to load on every platform, regardless of
# target_compatible_with. Moc it once here and have both platform targets
# depend on the result (see "One header cannot be moc'd by two targets" in
# docs/design-notes.md). This avoids touching the vendored moc macro in
# third_party/qt/qt.bzl.
# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "serial_port_actions_direct_moc",
    srcs = [],
    hdrs = ["serial_port_actions_direct.h"],
    visibility = ["//visibility:private"],
    deps = QT_DEPS + [
        ":serial_port_actions",
        "//src/algorithms/protocol",
        "//src/platform/desktop/common/bytes:qt_bytes",
    ] + select({
        "@platforms//os:windows": ["//src/platform/desktop/windows/j2534:j2534_api"],
        "//conditions:default": ["//src/platform/desktop/unix/j2534:j2534_api"],
    }),
)

# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "direct_serial_backend_unix",
    srcs = [
        "direct_serial_backend.cpp",
        "serial_port_actions_direct.cpp",
        "serial_port_actions_direct_unix.cpp",
    ],
    normal_hdrs = [
        "direct_serial_backend.h",
        "serial_port_actions_direct.h",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = DIRECT_SERIAL_BACKEND_VISIBILITY,
    deps = QT_DEPS + [
        ":j2534_driver_selection",
        ":serial_port_actions",
        ":serial_port_actions_direct_moc",
        "//src/algorithms/protocol",
        "//src/platform/desktop/common/bytes:qt_bytes",
        "//src/platform/desktop/unix/j2534:j2534_api",
    ],
    # Composition roots link the selected implementation beside a
    # declaration-only factory dependency, so its entry point must survive
    # archive ordering.
    alwayslink = True,
)

# Windows compiles only in CI; kept textually symmetric with the Unix target
# above rather than factored, so a CI-only compile failure is easy to
# correlate with its Unix counterpart.
# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "direct_serial_backend_windows",
    srcs = [
        "direct_serial_backend.cpp",
        "serial_port_actions_direct.cpp",
        "serial_port_actions_direct_windows.cpp",
    ],
    normal_hdrs = [
        "direct_serial_backend.h",
        "serial_port_actions_direct.h",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = DIRECT_SERIAL_BACKEND_VISIBILITY,
    deps = QT_DEPS + [
        ":j2534_driver_selection",
        ":serial_port_actions",
        ":serial_port_actions_direct_moc",
        "//src/algorithms/protocol",
        "//src/platform/desktop/common/bytes:qt_bytes",
        "//src/platform/desktop/windows/j2534:j2534_api",
    ],
    alwayslink = True,
)

