load("//bazel:qt_remote_objects.bzl", "qt_replica_library")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_library", "qt_cc_test", "qt_cpp_moc_headers")

package(default_visibility = [
    "//apps/desktop:__pkg__",
    "//src/platform:__subpackages__",
    "//tests:__pkg__",
])

filegroup(
    name = "test_cpp_sources",
    testonly = True,
    srcs = glob(["*_test.cpp"]),
    visibility = ["//:__pkg__"],
)

# root //:serial_compat_allowlist reads BUILD.bazel, and root
# //:windows_preprocessor_guards reads serial_port_actions_direct.h, both as
# `data`; those references are plumbing, not a layer dependency, so export
# them to the root package specifically rather than widen the package's
# general default_visibility.
exports_files(
    [
        "BUILD.bazel",
        "serial_port_actions_direct.h",
    ],
    visibility = ["//:__pkg__"],
)

qt_replica_library(
    name = "serial_replicas",
    reps = ["serial_port_actions.rep"],
    deps = QT_DEPS,
)

MOC_HDRS = [
    "remote_serial_backend.h",
    "serial_port_actions.h",
    "serial_port_actions_direct.h",
    "websocketiodevice.h",
]

# TRANSITIONAL. Carries serial_port_actions.h to its backend and UI
# callers, all of which are layering violations that step 5 (backend)
# and step 6 (ui) remove. Task 8 replaces the public visibility below
# with an enumerated allowlist frozen by
# scripts/check-serial-compat-allowlist.py. Do not add new callers.
qt_cc_library(
    name = "serial_qt_compat",
    srcs = glob(
        ["*.cpp"],
        exclude = [
            "*_main.cpp",
            "*_test.cpp",
        ],
    ),
    hdrs = MOC_HDRS,
    copts = COMMON_COPTS,
    # *.hpp because qtrohelper.hpp (included by remote_serial_backend.cpp
    # in this package, and by remote_utility.h in the sibling package) is
    # not matched by *.h alone.
    normal_hdrs = glob(
        [
            "*.h",
            "*.hpp",
        ],
        exclude = MOC_HDRS,
    ),
    visibility = [
        # Legitimate platform-internal edge, NOT part of the debt frozen
        # below: remote_utility.h #includes websocketiodevice.h and
        # qtrohelper.hpp, both owned by this package (see the normal_hdrs
        # comment above). Same-layer sibling dependency, not a layering
        # violation, so it is not expected to shrink.
        "//src/platform/desktop/common/remote_utility:__pkg__",
        # TRANSITIONAL. Every entry below is a layering violation removed by
        # step 5 (backend) or step 6 (ui). Frozen by
        # scripts/check-serial-compat-allowlist.py -- this list may
        # shrink, never grow.
        # TRANSITIONAL, step 5e. Replaces the //src/backend/flash entry, which
        # existed only because the 27 legacy operation classes reached
        # serial_port_actions.h *through* backend/flash's flash_utils target --
        # a backend -> platform layer inversion used as a visibility channel.
        # This is the same debt, correctly attributed: a platform -> platform
        # sibling edge, which the layering rules do not prohibit. Drained by
        # the step-5 tail as each flash family migrates off the full facade.
        "//src/platform/desktop/common/flash/legacy:__pkg__",
        "//src/platform/desktop/common/serial:__pkg__",
        "//src/platform/desktop/common/transport:__pkg__",
        "//src/ui/desktop:__pkg__",
        "//src/ui/desktop/biu:__pkg__",
        "//src/ui/desktop/flash/bdm:__pkg__",
        "//src/ui/desktop/flash/bootmode:__pkg__",
        "//src/ui/desktop/flash/ecu:__pkg__",
        "//src/ui/desktop/flash/eeprom:__pkg__",
        "//src/ui/desktop/flash/jtag:__pkg__",
        "//src/ui/desktop/flash/tcu:__pkg__",
        "//tests:__pkg__",
    ],
    deps = QT_DEPS + [
        ":serial_replicas",
        "//src/algorithms/protocol",
        "//src/algorithms/protocol:qt_compat",
    ] + select({
        # serial_port_actions_direct.h #includes J2534_unix.h or J2534_win.h
        # behind a Q_OS_UNIX/Q_OS_WIN32 guard; the header must be a declared
        # input on whichever platform is actually compiling it.
        "@platforms//os:windows": ["//src/platform/desktop/windows/j2534"],
        "//conditions:default": ["//src/platform/desktop/unix/j2534"],
    }),
)

fastecu_qttest(
    name = "test_direct_backend",
    size = "small",
    src = "direct_backend_test.cpp",
    deps = [
        ":serial_qt_compat",
        "//src/platform/desktop/common/transport",
    ],
)

fastecu_qttest(
    name = "test_remote_backend_smoke",
    size = "small",
    src = "remote_backend_smoke_test.cpp",
    deps = [":serial_qt_compat"],
)

fastecu_qttest(
    name = "test_direct_backend_pty",
    size = "small",
    src = "direct_backend_pty_test.cpp",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":serial_qt_compat",
        "//src/platform/desktop/unix/j2534/testing:mock_openport",
    ],
)

qt_cpp_moc_headers(
    name = "facade_threading_test_moc",
    srcs = ["facade_threading_test.cpp"],
    deps = QT_DEPS,
)

# Custom main is retained: it dispatches child-process mode and makes crash
# diagnostics unbuffered before Qt starts, behavior gtest/QtTest mains cannot
# express through fixtures or Bazel environment variables.
qt_cc_test(
    name = "test_facade_threading",
    size = "small",
    srcs = [
        "facade_threading_main.cpp",
        "facade_threading_test.cpp",
    ],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        ":facade_threading_test_moc",
        ":serial_qt_compat",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
        "//src/platform/desktop/common/transport",
    ],
)

# Same-layer facade over serial_qt_compat's transitional debt target, for
# platform packages (e.g. src/platform/desktop/common/flash/legacy) that need
# an explicit, non-debt handle to depend on instead of reaching directly into
# the frozen serial_qt_compat allowlist above. Wraps the existing
# implementation without changing it.
qt_cc_library(
    name = "serial_platform_api",
    srcs = [],
    hdrs = [],
    copts = COMMON_COPTS,
    visibility = ["//src/platform:__subpackages__"],
    deps = [":serial_qt_compat"],
)
