# Only the parent package's header-only library declares Q_OBJECT; everything
# here is ordinary code, so the inherited moc mapping is undone.
# gazelle:map_kind cc_library cc_library @rules_cc//cc:cc_library.bzl
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "COMMON_COPTS")

package(
    default_visibility = [
        "//bazel/layers:apps_bench",
        "//bazel/layers:apps_desktop",
        "//bazel/layers:tests",
        "//src/platform/desktop/common/serial:__subpackages__",
    ],
)

UNIX_ONLY = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Unix hook implementations of SerialPortActionsDirect. A binary links exactly
# one of this and the Windows counterpart; alwayslink keeps the hooks alive
# regardless of archive ordering.
cc_library(
    name = "serial_port_actions_direct_unix",
    srcs = ["serial_port_actions_direct_unix.cpp"],
    copts = COMMON_COPTS,
    implementation_deps = [
        "//src/platform/desktop/common/serial:j2534_driver_selection",
        "//src/platform/desktop/common/serial/direct:serial_port_actions_direct",
    ],
    target_compatible_with = UNIX_ONLY,
    deps = [
        # Linking a hook library must also link the shared implementation it
        # completes; no include names it.
        "//src/platform/desktop/common/serial/direct/common:direct_serial_backend",  # keep
    ],
    alwayslink = True,
)

fastecu_gtest(
    name = "direct_backend_hooks_unix_test",
    size = "small",
    srcs = ["direct_backend_hooks_unix_test.cpp"],
    target_compatible_with = UNIX_ONLY,
    deps = [
        # The hooks under test are linked, not included.
        ":serial_port_actions_direct_unix",  # keep
        "//src/platform/desktop/common/serial/direct:serial_port_actions_direct",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "test_direct_backend_pty",
    size = "small",
    srcs = ["direct_backend_pty_test.cpp"],
    target_compatible_with = UNIX_ONLY,
    deps = [
        # The test drives the real backend over a pseudo-terminal.
        ":serial_port_actions_direct_unix",  # keep
        "//bazel/qt:core",
        "//bazel/qt:serial_port",
        "//src/platform/desktop/common/serial/direct:serial_port_actions_direct",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)
