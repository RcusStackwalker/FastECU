])

# Production and runtime helper ownership is deferred by ADR 0017.
# keep
qt_cc_library(
    name = "transport",
    srcs = [
        "fastecu_can_transport.cpp",
        "fastecu_kline_transport.cpp",
        "fastecu_ssm_transport.cpp",
