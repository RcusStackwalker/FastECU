load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_library")

package(default_visibility = [
    "//apps/bench:__pkg__",
    "//apps/desktop:__pkg__",
    "//src/platform:__subpackages__",
    "//tests:__pkg__",
    # GRANDFATHERED (Task 5 human decision): //src/ui/desktop includes the
    # three fastecu_*_transport.h headers directly (mainwindow.h:101,104,109).
    # This is a real ui -> platform edge the modularization plan has not yet
    # removed.
    "//src/ui/desktop:__pkg__",
    # Task 7's desktop dialog owns the existing SSM transport adapter passed
    # into ServiceFunctionWorker; this does not grow serial_qt_compat's frozen
    # direct-consumer allowlist.
    "//src/ui/desktop/service_functions:__pkg__",
])

qt_cc_library(
    name = "transport",
    srcs = [
        "fastecu_can_transport.cpp",
        "fastecu_kline_transport.cpp",
        "fastecu_ssm_transport.cpp",
    ],
    hdrs = [],
    copts = COMMON_COPTS,
    normal_hdrs = [
        "fastecu_can_transport.h",
        "fastecu_kline_transport.h",
        "fastecu_ssm_transport.h",
    ],
    deps = QT_DEPS + [
        "//src/algorithms/protocol",
        "//src/algorithms/protocol/qt_compat",
        "//src/backend/protocol",
        "//src/platform/desktop/common/serial:serial_qt_compat",
    ],
)

# Test fixture pairing a SerialPortActions facade with a Google Mock backend.
# It lives in this package rather than beside fake_backend.h in
# //src/platform/desktop/common/serial/testing because it needs
# serial_port_actions.h, and serial_qt_compat's visibility list is frozen by
# //:serial_compat_allowlist -- that list may shrink, never grow, and this
# package is already on it.
qt_cc_library(
    name = "fake_backed_serial",
    testonly = True,
    srcs = [],
    hdrs = [],
    copts = COMMON_COPTS,
    # Header-only class template, no Q_OBJECT: normal_hdrs, not hdrs, so moc
    # does not run over it -- same convention as `transport` below.
    normal_hdrs = ["fake_backed_serial.h"],
    deps = QT_DEPS + [
        "//src/platform/desktop/common/serial:serial_qt_compat",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
        "@googletest//:gtest",
    ],
)

fastecu_qttest(
    name = "test_fake_backed_serial",
    src = "fake_backed_serial_test.cpp",
    deps = [":fake_backed_serial"],
)

# Google Mock cardinality helper shared by the two flash-transport suites,
# which run the same data-driven "fails at each setter in turn" test. Qt-free
# and independent of the fixture above, hence a plain cc_library.
cc_library(
    name = "setter_sequence_expectations",
    testonly = True,
    hdrs = ["setter_sequence_expectations.h"],
    deps = ["@googletest//:gtest"],
)

fastecu_qttest(
    name = "test_desktop_kline_flash_transport",
    src = "desktop_kline_flash_transport_test.cpp",
    deps = [
        ":fake_backed_serial",
        ":flash_transports",
        ":setter_sequence_expectations",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
    ],
)

fastecu_qttest(
    name = "test_desktop_can_flash_transport",
    src = "desktop_can_flash_transport_test.cpp",
    deps = [
        ":fake_backed_serial",
        ":flash_transports",
        ":setter_sequence_expectations",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
    ],
)

fastecu_qttest(
    name = "test_desktop_mixed_can_flash_transport",
    src = "desktop_mixed_can_flash_transport_test.cpp",
    deps = [
        ":flash_transports",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
    ],
)

fastecu_qttest(
    name = "test_desktop_transport_factory",
    src = "desktop_transport_factory_test.cpp",
    deps = [
        ":flash_transports",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
    ],
)

# Desktop K-Line/CAN flash transport adapters (step 5c, Task 12): a
# separate target from `transport` above because these implement
# fastecu::flash::{IKlineFlashTransport, ICanFlashTransport} (Task 5) for
# FlashWorker, a different consumer set than the mutdma/cdbg/ssm logging
# adapters in `transport` -- kept out of that target's srcs/normal_hdrs
# above to avoid compiling them twice under two separate library targets.
qt_cc_library(
    name = "flash_transports",
    srcs = [
        "desktop_can_flash_transport.cpp",
        "desktop_kline_flash_transport.cpp",
        "desktop_mixed_can_flash_transport.cpp",
        "desktop_transport_factory.cpp",
    ],
    hdrs = [],
    copts = COMMON_COPTS,
    # Neither adapter derives from QObject (no Q_OBJECT, no signals/slots),
    # so their headers go through normal_hdrs rather than hdrs (which would
    # run every header through moc unconditionally) -- same convention as
    # `transport` above.
    normal_hdrs = [
        "desktop_can_flash_transport.h",
        "desktop_kline_flash_transport.h",
        "desktop_mixed_can_flash_transport.h",
        "desktop_transport_factory.h",
    ],
    deps = QT_DEPS + [
        "//src/algorithms/protocol",
        "//src/algorithms/protocol/qt_compat",
        "//src/backend/flash:flash_executor",
        "//src/platform/desktop/common/serial:serial_qt_compat",
    ],
)
