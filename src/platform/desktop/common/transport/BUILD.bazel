load("@rules_cc//cc:cc_library.bzl", "cc_library")

# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
# The driver-selection header is an excluded selector source in the serial package.
# gazelle:resolve cc src/platform/desktop/common/serial/j2534_driver_selection.h //src/platform/desktop/common/serial:j2534_driver_selection
# Serial facade and logging runtime are still hand-owned in their packages.
# gazelle:resolve cc src/platform/desktop/common/serial/serial_port_actions.h //src/platform/desktop/common/serial:serial_port_actions
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "COMMON_COPTS")

package(default_visibility = [
    "//bazel/layers:apps_bench",
    "//bazel/layers:platform_and_composition_root",
    # The service-function dialog owns the SSM transport adapter it passes
    # into ServiceFunctionWorker.
    "//bazel/layers:ui_service_functions",
])

cc_library(
    name = "transport",
    srcs = [
        "fastecu_can_transport.cpp",
        "fastecu_kline_transport.cpp",
        "fastecu_ssm_transport.cpp",
    ],
    hdrs = [
        "fastecu_can_transport.h",
        "fastecu_kline_transport.h",
        "fastecu_ssm_transport.h",
    ],
    copts = COMMON_COPTS,
    implementation_deps = [
        "//src/backend/ports",
        "//src/platform/desktop/common/bytes:qt_bytes",
        "//src/platform/desktop/common/serial:serial_port_actions",
    ],
    deps = ["//src/backend/protocol"],
)

# Google Mock cardinality helper shared by the two flash-transport suites,
# which run the same data-driven "fails at each setter in turn" test. Qt-free
# and independent of the fixture above, hence a plain cc_library.
cc_library(
    name = "setter_sequence_expectations",
    testonly = True,
    hdrs = ["setter_sequence_expectations.h"],
    deps = ["@googletest//:gtest"],
)

fastecu_gtest(
    name = "test_desktop_kline_flash_transport",
    srcs = ["desktop_kline_flash_transport_test.cpp"],
    deps = [
        ":flash_transports",
        ":setter_sequence_expectations",
        "//bazel/qt:core",
        "//bazel/qt:serial_port",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/platform/desktop/common/serial/testing:fake_backed_serial",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
        "//src/platform/desktop/common/testing:core_application_environment",
        "//src/platform/desktop/common/testing:event_helpers",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "test_desktop_can_flash_transport",
    srcs = ["desktop_can_flash_transport_test.cpp"],
    deps = [
        ":flash_transports",
        ":setter_sequence_expectations",
        "//bazel/qt:core",
        "//src/backend/ports/testing:fake_cancellation_token",
        "//src/platform/desktop/common/serial/testing:fake_backed_serial",
