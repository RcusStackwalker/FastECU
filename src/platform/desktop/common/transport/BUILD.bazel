load("//bazel:qt_targets.bzl", "COMMON_COPTS", "COMMON_INCLUDES", "QT_DEPS", "qt_cc_library")

package(default_visibility = [
    "//apps/desktop:__pkg__",
    "//src/platform:__subpackages__",
    "//tests:__pkg__",
    # GRANDFATHERED (Task 5 human decision): //src/ui/desktop includes the
    # three fastecu_*_transport.h headers directly (mainwindow.h:101,104,109).
    # This is a real ui -> platform edge the modularization plan has not yet
    # removed.
    "//src/ui/desktop:__pkg__",
    # The rewritten EEPROM dialogs (step 5c, Task 17) construct
    # DesktopKlineFlashTransport/DesktopCanFlashTransport directly (via the
    # non-owning SerialPortActions* constructor) to drive their FlashWorker
    # attempts.
    "//src/ui/desktop/flash/eeprom:__pkg__",
])

# Desktop K-Line/CAN flash transport adapters (step 5c, Task 12): a
# separate target from `transport` above rather than folding into its glob,
# because these implement fastecu::flash::{IKlineFlashTransport,
# ICanFlashTransport} (Task 5) for FlashWorker, a different consumer set
# than the mutdma/cdbg/ssm logging adapters in `transport` -- excluded from
# that target's globs below to avoid compiling them twice under two
# separate library targets.
_FLASH_TRANSPORT_SRCS = [
    "desktop_can_flash_transport.cpp",
    "desktop_kline_flash_transport.cpp",
]

_FLASH_TRANSPORT_HDRS = [
    "desktop_can_flash_transport.h",
    "desktop_kline_flash_transport.h",
]

qt_cc_library(
    name = "transport",
    srcs = glob(
        ["*.cpp"],
        exclude = _FLASH_TRANSPORT_SRCS,
    ),
    hdrs = [],
    copts = COMMON_COPTS,
    includes = COMMON_INCLUDES,
    normal_hdrs = glob(
        ["*.h"],
        exclude = _FLASH_TRANSPORT_HDRS,
    ),
    deps = QT_DEPS + [
        "//src/algorithms/protocol",
        "//src/algorithms/protocol:qt_compat",
        "//src/backend/protocol",
        "//src/platform/desktop/common/serial:serial_qt_compat",
    ],
)

qt_cc_library(
    name = "flash_transports",
    srcs = _FLASH_TRANSPORT_SRCS,
    hdrs = [],
    copts = COMMON_COPTS,
    includes = COMMON_INCLUDES,
    # Neither adapter derives from QObject (no Q_OBJECT, no signals/slots),
    # so their headers go through normal_hdrs rather than hdrs (which would
    # run every header through moc unconditionally) -- same convention as
    # `transport` above.
    normal_hdrs = _FLASH_TRANSPORT_HDRS,
    deps = QT_DEPS + [
        "//src/algorithms/protocol",
        "//src/algorithms/protocol:qt_compat",
        "//src/backend/flash:flash_executor",
        "//src/platform/desktop/common/serial:serial_qt_compat",
    ],
)
