load("@rules_cc//cc:cc_library.bzl", "cc_library")

# gazelle:alias_kind qt_cc_library cc_library
# gazelle:map_kind cc_test fastecu_gtest //bazel:gtest_targets.bzl
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "qt_cc_library")

package(default_visibility = [
    "//bazel/layers:apps",
    "//bazel/layers:platform",
    "//bazel/layers:tests",
    "//bazel/layers:ui",
])

cc_library(
    name = "ports",
    srcs = [
        "qt_atomic_file_writer.cpp",
        "qt_clock.cpp",
        "qt_file_repository.cpp",
        "qt_file_system.cpp",
        "qt_resource_bundle.cpp",
        "qt_settings.cpp",
    ],
    hdrs = [
        "qt_atomic_file_writer.h",
        "qt_clock.h",
        "qt_file_repository.h",
        "qt_file_system.h",
        "qt_resource_bundle.h",
        "qt_settings.h",
    ],
    copts = COMMON_COPTS,
    implementation_deps = ["//bazel/qt:core"],
    deps = [
        # Re-export the signal endpoint through the stable public ports label.
        ":qt_event_sink",  # keep
        "//src/backend/ports",
    ],
)

fastecu_gtest(
    name = "qt_atomic_file_writer_test",
    srcs = ["qt_atomic_file_writer_test.cpp"],
    deps = [
        ":ports",
        "//bazel/qt:core",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "test_qt_port_adapters",
    size = "small",
    srcs = ["qt_port_adapters_test.cpp"],
    deps = [
        ":ports",
        ":qt_event_sink",
        "//bazel/qt:core",
        "//bazel/qt:test",
        "//src/backend/ports",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "test_qt_resource_bundle",
    srcs = ["qt_resource_bundle_test.cpp"],
    deps = [
        # Resource registration is linked without a C++ include.
        "//resources/shared:config_resource",  # keep
        "//resources/shared:kernels_resource",  # keep
        ":ports",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

fastecu_gtest(
    name = "qt_file_system_test",
    srcs = ["qt_file_system_test.cpp"],
    deps = [
        ":ports",
        "//bazel/qt:core",
        "//src/backend/ports/testing:result_matchers",
        "@googletest//:gtest",
    ],
)

# Temporarily hand-owned: pinned alias_kind merging preserves existing attributes.
# See ADR 0017; plain libraries and tests in this package regenerate normally.
# keep
qt_cc_library(
    name = "qt_event_sink",
    srcs = ["qt_event_sink.cpp"],
    hdrs = ["qt_event_sink.h"],
    visibility = ["//visibility:private"],
    deps = [
        "//bazel/qt:core",
        "//src/backend/ports",
    ],
)
