load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "qt_cc_library")

package(default_visibility = [
    "//apps:__subpackages__",
    "//src/backend/definitions:__pkg__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

qt_cc_library(
    name = "ports",
    srcs =
        [
            "qt_atomic_file_writer.cpp",
            "qt_clock.cpp",
            "qt_event_sink.cpp",
            "qt_file_repository.cpp",
            "qt_file_system.cpp",
            "qt_resource_bundle.cpp",
            "qt_settings.cpp",
        ],
    hdrs = ["qt_event_sink.h"],  # MOC header
    copts = COMMON_COPTS,
    normal_hdrs =
        [
            "qt_atomic_file_writer.h",
            "qt_cancellation_token.h",
            "qt_clock.h",
            "qt_file_repository.h",
            "qt_file_system.h",
            "qt_resource_bundle.h",
            "qt_settings.h",
        ],
    deps = [
        "//src/backend/ports",
        "@rules_qt//:qt_core",
    ],
)

fastecu_gtest(
    name = "qt_atomic_file_writer_test",
    srcs = ["qt_atomic_file_writer_test.cpp"],
    deps = [
        ":ports",
        "//src/backend/ports",
    ],
)

fastecu_gtest(
    name = "test_qt_port_adapters",
    srcs = ["qt_port_adapters_test.cpp"],
    deps = [
        ":ports",
        "//src/backend/ports",
    ],
)

fastecu_gtest(
    name = "test_qt_resource_bundle",
    srcs = ["qt_resource_bundle_test.cpp"],
    deps = [
        ":ports",
        "//resources/shared:config_resource",
        "//resources/shared:kernels_resource",
        "//src/backend/ports",
    ],
)

fastecu_gtest(
    name = "qt_file_system_test",
    srcs = ["qt_file_system_test.cpp"],
    deps = [
        ":ports",
        "//src/backend/ports",
    ],
)
