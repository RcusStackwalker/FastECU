load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_library")

package(default_visibility = [
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

qt_cc_library(
    name = "legacy_flash_operations",
    srcs = [
        "bdm/flash_ecu_subaru_denso_mc68hc16y5_02_bdm_operation.cpp",
        "bootmode/flash_ecu_subaru_unisia_jecs_m32r_bootmode_operation.cpp",
        "ecu/flash_ecu_subaru_denso_1n83m_4m_can_operation.cpp",
        "ecu/flash_ecu_subaru_denso_sh7058_can_diesel_operation.cpp",
        "ecu/flash_ecu_subaru_denso_sh7058_can_operation.cpp",
        "ecu/flash_ecu_subaru_denso_sh705x_densocan_operation.cpp",
        "ecu/flash_ecu_subaru_denso_sh705x_kline_operation.cpp",
        "ecu/flash_ecu_subaru_denso_sh72543_can_diesel_operation.cpp",
        "ecu/flash_ecu_subaru_hitachi_sh7058_can_operation.cpp",
        "ecu/flash_ecu_subaru_hitachi_sh72543r_can_operation.cpp",
        "ecu/flash_ecu_subaru_unisia_jecs_m32r_operation.cpp",
        "ecu/flash_ecu_subaru_unisia_jecs_operation.cpp",
        "flash_operation_worker.cpp",
        "jtag/flash_ecu_subaru_hitachi_m32r_jtag_operation.cpp",
        "legacy_flash_utils.cpp",
        "tcu/flash_tcu_subaru_denso_sh705x_can_operation.cpp",
        "tcu/flash_tcu_subaru_hitachi_m32r_can_operation.cpp",
        "tcu/flash_tcu_subaru_hitachi_m32r_kline_operation.cpp",
    ],
    # FlashOperationWorker (the shared QThread base) and the bdm/bootmode/ecu/
    # jtag/tcu legacy Qt operation classes, relocated together from
    # //src/backend/flash (step 5c, Task 15) -- backend owns no thread, and
    # FlashOperationWorker was the last QThread-derived class left there.
    # Every *_operation.h in the five family subdirectories declares Q_OBJECT.
    hdrs = [
        "bdm/flash_ecu_subaru_denso_mc68hc16y5_02_bdm_operation.h",
        "bootmode/flash_ecu_subaru_unisia_jecs_m32r_bootmode_operation.h",
        "ecu/flash_ecu_subaru_denso_1n83m_4m_can_operation.h",
        "ecu/flash_ecu_subaru_denso_sh7058_can_diesel_operation.h",
        "ecu/flash_ecu_subaru_denso_sh7058_can_operation.h",
        "ecu/flash_ecu_subaru_denso_sh705x_densocan_operation.h",
        "ecu/flash_ecu_subaru_denso_sh705x_kline_operation.h",
        "ecu/flash_ecu_subaru_denso_sh72543_can_diesel_operation.h",
        "ecu/flash_ecu_subaru_hitachi_sh7058_can_operation.h",
        "ecu/flash_ecu_subaru_hitachi_sh72543r_can_operation.h",
        "ecu/flash_ecu_subaru_unisia_jecs_m32r_operation.h",
        "ecu/flash_ecu_subaru_unisia_jecs_operation.h",
        "flash_operation_worker.h",
        "jtag/flash_ecu_subaru_hitachi_m32r_jtag_operation.h",
        "tcu/flash_tcu_subaru_denso_sh705x_can_operation.h",
        "tcu/flash_tcu_subaru_hitachi_m32r_can_operation.h",
        "tcu/flash_tcu_subaru_hitachi_m32r_kline_operation.h",
    ],
    copts = COMMON_COPTS,
    # Every *.h in the six directories (root + five families) is in
    # hdrs above except this one -- matches prior glob behavior.
    normal_hdrs = ["legacy_flash_utils.h"],
    deps = QT_DEPS + [
        "//src/algorithms/checksum",
        "//src/algorithms/diagnostics",
        # qt_bytes.h is included directly by files in this glob; before step
        # 5e it arrived via //src/backend/flash, which 5e deleted, so declare
        # it rather than inherit it through the ssm :qt_compat target.
        "//src/algorithms/protocol:qt_compat",
        "//src/algorithms/protocol/ssm:qt_compat",
        # Full :definitions (not :models) because file_actions.h -- part of
        # the moc'd :definitions target, not the header-only :models split
        # -- is included directly; see task-4-report.md.
        "//src/backend/definitions",
        "//src/backend/flash:flash_device_lookup",
        "//src/platform/desktop/common/serial:serial_qt_compat",
    ],
)

fastecu_qttest(
    name = "test_flash_operation_worker",
    src = "flash_operation_worker_test.cpp",
    copts = ["-DQT_WIDGETS_LIB"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    deps = [":legacy_flash_operations"],
)

fastecu_qttest(
    name = "test_legacy_flash_utils",
    src = "legacy_flash_utils_test.cpp",
    deps = [
        ":legacy_flash_operations",
        "//src/platform/desktop/common/serial/testing:fake_serial_backend",
    ],
)

# root //:legacy_flash_drain reads these as `data`: a glob in the root
# BUILD.bazel cannot cross into this package's own boundary, so the ratchet
# needs its inputs exported from here instead. Deliberately still a glob,
# unlike srcs/normal_hdrs above: check-legacy-flash-drain.py rglobs this
# package at runtime looking for files NOT in its REMAINING allowlist, so
# the filegroup must keep tracking whatever .cpp files actually exist here
# -- an explicit list could silently omit a newly (mis)added file from the
# check it exists to catch.
filegroup(
    name = "family_operation_sources",
    srcs = glob([
        "*.cpp",
        "bdm/*.cpp",
        "bootmode/*.cpp",
        "ecu/*.cpp",
        "jtag/*.cpp",
        "tcu/*.cpp",
    ]),
    visibility = ["//:__pkg__"],
)
