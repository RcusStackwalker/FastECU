load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_common.bzl", "COMMON_COPTS")

package(default_visibility = [
    "//bazel/layers:platform",
    "//bazel/layers:tests",
    "//bazel/layers:ui",
])

cc_library(
    name = "desktop_flash_workflow_ports",
    srcs = ["desktop_flash_workflow_ports.cpp"],
    hdrs = ["desktop_flash_workflow_ports.h"],
    copts = COMMON_COPTS,
    implementation_deps = [
        "//src/platform/desktop/common/ports",
        "//src/platform/desktop/common/transport:flash_transports",
    ],
    deps = ["//src/backend/flash/workflow:flash_workflow"],
)

fastecu_gtest(
    name = "builtin_catalog_capability_test",
    srcs = ["builtin_catalog_capability_test.cpp"],
    data = ["//resources/shared:kernel_files"],
    env = {"KERNEL_FILES": "$(locations //resources/shared:kernel_files)"},
    deps = [
        ":desktop_flash_workflow_ports",
        "//bazel/qt:core",
        "//src/backend/config:builtin_catalog",
        "//src/backend/flash:flash_device_lookup",
        "//src/backend/flash/workflow:flash_workflow",
        "//src/platform/desktop/common/testing:core_application_environment",
        "@googletest//:gtest",
    ],
)
