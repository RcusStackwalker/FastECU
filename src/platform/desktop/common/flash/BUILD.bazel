load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS", "fastecu_qttest", "qt_cc_library")

package(default_visibility = [
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

qt_cc_library(
    name = "flash_worker",
    srcs = ["flash_worker.cpp"],
    hdrs = ["flash_worker.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        "//src/backend/flash:flash_executor",
        "//src/backend/flash:flash_plan",
        "//src/backend/ports",
        "//src/platform/desktop/common/ports",
    ],
)

fastecu_qttest(
    name = "test_flash_worker",
    src = "flash_worker_test.cpp",
    deps = [
        ":flash_worker",
        "//src/algorithms/protocol/ssm",
        "//src/backend/flash/eeprom:denso_sh705x_eeprom_common",
        "//src/backend/flash/eeprom:denso_sh705x_eeprom_kline",
        "//src/backend/flash/testing:scripted_flash_transports",
        "//src/backend/ports/testing:fake_clock",
    ],
)

filegroup(
    name = "test_layout_cpp_sources",
    testonly = True,
    srcs = glob(["*test*.cpp"]),
    visibility = ["//:__pkg__"],
)
