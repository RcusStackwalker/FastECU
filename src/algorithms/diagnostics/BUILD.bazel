load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//src/algorithms:__subpackages__",
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

cc_library(
    name = "diagnostics",
    srcs = [
        "dtc_parser.cpp",
        "dtc_tables.cpp",
        "nrc_parser.cpp",
    ],
    hdrs = [
        "dtc_parser.h",
        "dtc_tables.h",
        "nrc_parser.h",
    ],
    deps = ["//src/algorithms/protocol"],
)

fastecu_portable_gtest(
    name = "diagnostics_test",
    srcs = ["diagnostics_test.cpp"],
    deps = [":diagnostics"],
)

fastecu_portable_gtest(
    name = "dtc_tables_test",
    srcs = ["dtc_tables_test.cpp"],
    deps = [":diagnostics"],
)
