load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//src/algorithms:__subpackages__",
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

# root //:portable_closure reads this file as `data` to check that portable
# algorithms targets stay Qt-free; that reference is plumbing, not a layer
# dependency, so export it to the root package specifically rather than
# widen the package's general default_visibility.
exports_files(
    ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "checksum",
    srcs = [
        "checksum_ecu_subaru_denso_sh705x_diesel.cpp",
        "checksum_ecu_subaru_denso_sh7xxx.cpp",
        "checksum_ecu_subaru_hitachi_m32r_can.cpp",
        "checksum_ecu_subaru_hitachi_m32r_kline.cpp",
        "checksum_ecu_subaru_hitachi_sh7058.cpp",
        "checksum_ecu_subaru_hitachi_sh72543r.cpp",
        "checksum_primitives.cpp",
        "checksum_tcu_mitsu_mh8104_can.cpp",
        "checksum_tcu_subaru_denso_sh7055.cpp",
        "checksum_tcu_subaru_hitachi_m32r_can.cpp",
        "denso_checksum_table.cpp",
    ],
    hdrs = [
        "checksum_ecu_subaru_denso_sh705x_diesel.h",
        "checksum_ecu_subaru_denso_sh7xxx.h",
        "checksum_ecu_subaru_hitachi_m32r_can.h",
        "checksum_ecu_subaru_hitachi_m32r_kline.h",
        "checksum_ecu_subaru_hitachi_sh7058.h",
        "checksum_ecu_subaru_hitachi_sh72543r.h",
        "checksum_primitives.h",
        "checksum_result.h",
        "checksum_tcu_mitsu_mh8104_can.h",
        "checksum_tcu_subaru_denso_sh7055.h",
        "checksum_tcu_subaru_hitachi_m32r_can.h",
        "denso_checksum_table.h",
    ],
    deps = ["//src/algorithms/protocol"],
)

fastecu_portable_gtest(
    name = "checksum_test",
    srcs = ["checksum_test.cpp"],
    deps = [":checksum"],
)

fastecu_portable_gtest(
    name = "checksum_primitives_test",
    srcs = ["checksum_primitives_test.cpp"],
    deps = [":checksum"],
)

fastecu_portable_gtest(
    name = "denso_checksum_table_test",
    srcs = ["denso_checksum_table_test.cpp"],
    deps = [":checksum"],
)
