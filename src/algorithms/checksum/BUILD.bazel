load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS")

package(default_visibility = [
    "//src/algorithms:__subpackages__",
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

# root //:portable_closure reads this file as `data` to check that portable
# algorithms targets stay Qt-free; that reference is plumbing, not a layer
# dependency, so export it to the root package specifically rather than
# widen the package's general default_visibility.
exports_files(
    ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "checksum",
    srcs = glob(
        ["*.cpp"],
        exclude = [
            "*_test.cpp",
            "qt_*.cpp",
        ],
    ),
    hdrs = glob(
        ["*.h"],
        exclude = [
            "*_test.h",
            "qt_*.h",
        ],
    ),
    deps = ["//src/algorithms/protocol"],
)

# TRANSITIONAL Qt shim: QByteArray overload of checksum8 delegating to :checksum.
cc_library(
    name = "qt_compat",
    srcs = ["qt_checksum.cpp"],
    hdrs = ["qt_checksum.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        ":checksum",
        "//src/algorithms/protocol:qt_compat",
    ],
)

cc_test(
    name = "checksum_test",
    size = "small",
    srcs = ["checksum_test.cpp"],
    deps = [
        ":checksum",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "checksum_primitives_test",
    size = "small",
    srcs = ["checksum_primitives_test.cpp"],
    deps = [
        ":checksum",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "denso_checksum_table_test",
    size = "small",
    srcs = ["denso_checksum_table_test.cpp"],
    deps = [
        ":checksum",
        "@googletest//:gtest_main",
    ],
)

fastecu_gtest(
    name = "test_qt_checksum",
    srcs = ["qt_checksum_test.cpp"],
    deps = [
        ":qt_compat",
    ],
)
