load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:gtest_targets.bzl", "fastecu_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS")

package(default_visibility = [
    "//src/algorithms:__subpackages__",
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

# root //:portable_closure reads this file as `data` to check that portable
# algorithms targets stay Qt-free; that reference is plumbing, not a layer
# dependency, so export it to the root package specifically rather than
# widen the package's general default_visibility.
exports_files(
    ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "colt",
    srcs = glob(
        ["*.cpp"],
        exclude = [
            "*_test.cpp",
            "qt_*.cpp",
        ],
    ),
    hdrs = glob(
        ["*.h"],
        exclude = [
            "*_test.h",
            "qt_*.h",
        ],
    ),
    deps = ["//src/algorithms/protocol"],
)

# TRANSITIONAL Qt shim: QByteArray/QVector overloads delegating to :colt, kept
# alive by this package's own :test_mitsu_colt_can_protocol,
# :test_mitsu_colt_can_vendor_ext_protocol, and :test_mitsu_colt_can_cdbg_protocol,
# which still assert against the QByteArray-based wrappers below.
cc_library(
    name = "qt_compat",
    hdrs = ["qt_colt.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [
        ":colt",
        "//src/algorithms/protocol:qt_compat",
    ],
)

cc_test(
    name = "colt_test",
    size = "small",
    srcs = ["colt_test.cpp"],
    deps = [
        ":colt",
        "@googletest//:gtest_main",
    ],
)

fastecu_gtest(
    name = "test_mitsu_colt_can_protocol",
    srcs = ["mitsu_colt_can_protocol_test.cpp"],
    deps = [
        ":qt_compat",
        "//src/algorithms/protocol/testing:byte_test_utils",
    ],
)

fastecu_gtest(
    name = "test_mitsu_colt_can_vendor_ext_protocol",
    srcs = ["mitsu_colt_can_vendor_ext_protocol_test.cpp"],
    deps = [
        ":qt_compat",
        "//src/algorithms/protocol/testing:byte_test_utils",
    ],
)

fastecu_gtest(
    name = "test_mitsu_colt_can_cdbg_protocol",
    srcs = ["mitsu_colt_can_cdbg_protocol_test.cpp"],
    deps = [":qt_compat"],
)
