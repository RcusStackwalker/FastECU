load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//bazel/layers:algorithms_and_above",
    "//bazel/layers:apps_bench",
])

cc_library(
    name = "mitsu_colt_can_protocol",
    srcs = ["mitsu_colt_can_protocol.cpp"],
    hdrs = ["mitsu_colt_can_protocol.h"],
    deps = [
        "//src/algorithms/protocol",
        "//src/algorithms/protocol/uds",
    ],
)

cc_library(
    name = "mitsu_colt_can_vendor_ext_protocol",
    srcs = ["mitsu_colt_can_vendor_ext_protocol.cpp"],
    hdrs = ["mitsu_colt_can_vendor_ext_protocol.h"],
    deps = [
        "//src/algorithms/protocol",
        "//src/algorithms/protocol/uds",
    ],
)

cc_library(
    name = "mitsu_colt_can_cdbg_protocol",
    srcs = ["mitsu_colt_can_cdbg_protocol.cpp"],
    hdrs = ["mitsu_colt_can_cdbg_protocol.h"],
    deps = ["//src/algorithms/protocol"],
)

fastecu_portable_gtest(
    name = "test_mitsu_colt_can_protocol",
    srcs = ["mitsu_colt_can_protocol_test.cpp"],
    deps = [
        ":mitsu_colt_can_protocol",
        "//src/algorithms/protocol/testing:byte_test_utils",
    ],
)

fastecu_portable_gtest(
    name = "test_mitsu_colt_can_vendor_ext_protocol",
    srcs = ["mitsu_colt_can_vendor_ext_protocol_test.cpp"],
    deps = [
        ":mitsu_colt_can_vendor_ext_protocol",
        "//src/algorithms/protocol/testing:byte_test_utils",
    ],
)

fastecu_portable_gtest(
    name = "test_mitsu_colt_can_cdbg_protocol",
    srcs = ["mitsu_colt_can_cdbg_protocol_test.cpp"],
    deps = [":mitsu_colt_can_cdbg_protocol"],
)
