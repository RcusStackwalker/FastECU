load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = ["//bazel/layers:algorithms_and_above"])

cc_library(
    name = "mut_dma",
    srcs =
        [
            "mut_dma_codec.cpp",
            "mut_dma_freeform.cpp",
            "mut_dma_memory.cpp",
        ],
    hdrs =
        [
            "mut_dma_codec.h",
            "mut_dma_freeform.h",
            "mut_dma_memory.h",
        ],
    deps = ["//src/algorithms/protocol"],
)

fastecu_portable_gtest(
    name = "mut_dma_test",
    srcs = ["mut_dma_test.cpp"],
    deps = [
        ":mut_dma",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "test_codec",
    srcs = ["codec_test.cpp"],
    deps = [
        ":mut_dma",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "test_freeform",
    srcs = ["freeform_test.cpp"],
    deps = [
        ":mut_dma",
        "@googletest//:gtest",
    ],
)

fastecu_portable_gtest(
    name = "test_memory",
    srcs = ["memory_test.cpp"],
    deps = [
        ":mut_dma",
        "@googletest//:gtest",
    ],
)
