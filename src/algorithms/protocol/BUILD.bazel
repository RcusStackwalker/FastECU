load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_gtest", "fastecu_portable_gtest")
load("//bazel:qt_targets.bzl", "COMMON_COPTS", "QT_DEPS")

package(default_visibility = [
    "//src/algorithms:__subpackages__",
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

# root //:portable_closure reads this file as `data` to check that portable
# algorithms targets stay Qt-free; that reference is plumbing, not a layer
# dependency, so export it to the root package specifically rather than
# widen the package's general default_visibility.
exports_files(
    ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "protocol",
    hdrs = [
        "bytes.h",
        "bytes_compose.h",
    ],
)

# TRANSITIONAL Qt shim. Converts between Qt containers and bytes:: types.
# Shrinks as steps 5 and 6 move callers onto the portable types.
cc_library(
    name = "qt_compat",
    hdrs = ["qt_bytes.h"],
    copts = COMMON_COPTS,
    deps = QT_DEPS + [":protocol"],
)

fastecu_portable_gtest(
    name = "bytes_test",
    srcs = ["bytes_test.cpp"],
    deps = [":protocol"],
)

fastecu_portable_gtest(
    name = "bytes_compose_test",
    srcs = ["bytes_compose_test.cpp"],
    deps = [":protocol"],
)

fastecu_gtest(
    name = "test_bytes",
    srcs = ["bytes_qt_compat_test.cpp"],
    deps = [
        ":protocol",
        ":qt_compat",
    ],
)
