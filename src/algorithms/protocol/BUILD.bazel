load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//apps/bench:__pkg__",
    "//src/algorithms:__subpackages__",
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

cc_library(
    name = "protocol",
    hdrs = [
        "bytes.h",
        "bytes_compose.h",
        "fixed_buffer.h",
    ],
)

fastecu_portable_gtest(
    name = "bytes_test",
    srcs = ["bytes_test.cpp"],
    deps = [":protocol"],
)

fastecu_portable_gtest(
    name = "fixed_buffer_test",
    srcs = ["fixed_buffer_test.cpp"],
    deps = [":protocol"],
)

fastecu_portable_gtest(
    name = "bytes_compose_test",
    srcs = ["bytes_compose_test.cpp"],
    deps = [":protocol"],
)
