load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:gtest_targets.bzl", "fastecu_portable_gtest")

package(default_visibility = [
    "//src/algorithms:__subpackages__",
    "//src/backend:__subpackages__",
    "//src/platform:__subpackages__",
    "//src/ui:__subpackages__",
    "//tests:__pkg__",
])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "uds",
    srcs = [
        "uds_pdu.cpp",
        "uds_response.cpp",
    ],
    hdrs = [
        "uds_pdu.h",
        "uds_response.h",
    ],
    deps = [
        "//src/algorithms/diagnostics",
        "//src/algorithms/protocol",
    ],
)

fastecu_portable_gtest(
    name = "uds_pdu_test",
    srcs = ["uds_pdu_test.cpp"],
    deps = [":uds"],
)

fastecu_portable_gtest(
    name = "uds_response_test",
    srcs = ["uds_response_test.cpp"],
    deps = [":uds"],
)

# Header-only. Named bytes shared by the Subaru CAN and K-Line bootloader/
# kernel executors -- see the header for the ISO 14229/SAE J1979/vendor-
# specific split. No deps on uds_pdu/uds_response so K-Line executors (which
# don't parse UDS PDUs at all) don't pull that logic in just for these
# constants.
cc_library(
    name = "uds_service_ids",
    hdrs = ["uds_service_ids.h"],
    deps = ["//src/algorithms/protocol"],
)
