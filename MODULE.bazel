module(name = "fastecu")

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(name = "fastecu_qt", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "pugixml", version = "1.15")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.14")
python.toolchain(python_version = "3.14")
use_repo(python, "python_3_14")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "python_deps",
    python_version = "3.14",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "python_deps")

# rules_qt is a dependency of //third_party/qt, not of this module -- only the
# root module's overrides are honoured, and an override needs no bazel_dep.
single_version_override(
    module_name = "rules_qt",
    patch_strip = 1,
    patches = ["//bazel/patches:rules_qt_windows_addons.patch"],
)

msvc_sysroot = use_extension("//bazel/toolchains:msvc_sysroot_ext.bzl", "msvc_sysroot")
use_repo(msvc_sysroot, "msvc_sysroot")

register_toolchains("//bazel/toolchains/windows_x86_msvc:windows_x86_msvc_toolchain")

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)

# Upstream HEAD still calls native.py_binary / native cc_binary, both removed in
# Bazel 9. Pin the commit + integrity via archive_override (it carries the patch
# hermetically) and patch hedron to load py_binary / cc_binary from
# rules_python / rules_cc. Bump the commit deliberately.
archive_override(
    module_name = "hedron_compile_commands",
    integrity = "sha256-Gwir/7++ifbb7mpbM3U3kugAT2o283wPchFb7IbmhyQ=",
    patch_strip = 1,
    patches = ["//bazel/patches:hedron_bazel9_py_binary.patch"],
    strip_prefix = "bazel-compile-commands-extractor-abb61a688167623088f8768cc9264798df6a9d10",
    urls = ["https://github.com/hedronvision/bazel-compile-commands-extractor/archive/abb61a688167623088f8768cc9264798df6a9d10.tar.gz"],
)

# Fixes a warning for mixing different character types https://github.com/google/googletest/commit/fa8438ae6b70c57010177de47a9f13d7041a6328
local_path_override(
    module_name = "fastecu_qt",
    path = "third_party/qt",
)

single_version_override(
    module_name = "googletest",
    patches = [
        "//bazel/patches:googletest_char8_conversion.patch",
    ],
    version = "1.17.0.bcr.2",
)
