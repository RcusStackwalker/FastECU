module(name = "fastecu")

bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_python", version = "2.4.2")
bazel_dep(name = "fastecu_qt", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "pugixml", version = "1.15")

# The NDK already emits -fPIC unconditionally, but 0.1.5 does not declare
# the pic feature, so rules_cc rejects --force_pic during toolchain analysis.
# Keep its existing compiler flags and advertise the mode they implement.
single_version_override(
    module_name = "rules_android_ndk",
    patch_strip = 1,
    patches = ["//bazel/patches:rules_android_ndk_pic.patch"],
)

# The Windows clang-tidy host links LLVM's static libraries, whose compression
# dependencies are not shipped in the official development archive.
bazel_dep(name = "zlib", version = "1.3.2.bcr.2", dev_dependency = True)
bazel_dep(name = "zstd", version = "1.5.7.bcr.3", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.54.0", dev_dependency = True)
bazel_dep(name = "gazelle_cc", version = "0.6.0", dev_dependency = True)

# Runs clang-tidy through the configured Bazel C++ graph.
bazel_dep(name = "aspect_rules_lint", version = "2.9.1", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)

# Adds `plugins` (an action input and a -load= argument each) and `config_chains` (per-source
# .clang-tidy inputs) to lint_clang_tidy_aspect, and a `rules_lint_fixes` output group of
# --export-fixes files, Windows execution and configured dependency traversal.
# Intended for upstreaming.
single_version_override(
    module_name = "aspect_rules_lint",
    patch_strip = 1,
    patches = [
        "//bazel/patches:rules_lint_clang_tidy_plugins.patch",
        "//bazel/patches:rules_lint_clang_tidy_config_chains.patch",
        "//bazel/patches:rules_lint_clang_tidy_export_fixes.patch",
        "//bazel/patches:rules_lint_clang_tidy_msvc_standard.patch",
        "//bazel/patches:rules_lint_clang_tidy_windows_wrapper.patch",
        "//bazel/patches:rules_lint_clang_tidy_transitions.patch",
    ],
)

# Fuzz harnesses only; their targets build solely under --config=asan and
# --config=fuzztest (bazel/fuzz.bazelrc), so other builds never fetch this graph.
bazel_dep(name = "fuzztest", version = "20260629.0", dev_dependency = True)

# Micro-benchmarks; their targets are tagged manual and run with `bazel run -c opt`.
bazel_dep(name = "google_benchmark", version = "1.9.5", dev_dependency = True)

# Minimum versions for Bazel 9 compatibility in FuzzTest's transitive graph.
# Ordinary dev dependencies let minimal version selection raise these versions
# when another dependency needs more, without exact-version overrides.
# On a FuzzTest bump, drop each floor that
# `bazel build --config=asan //src/algorithms/...` no longer needs.
bazel_dep(name = "rules_foreign_cc", version = "0.16.0", dev_dependency = True)
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", dev_dependency = True)
bazel_dep(name = "aspect_rules_esbuild", version = "0.27.1", dev_dependency = True)
bazel_dep(name = "flatbuffers", version = "25.12.19.bcr.1", dev_dependency = True)
bazel_dep(name = "brotli", version = "1.2.0.bcr.3", dev_dependency = True)
bazel_dep(name = "highwayhash", version = "0.0.0-20240305-5ad3bf8.bcr.1", dev_dependency = True)
bazel_dep(name = "snappy", version = "1.2.2.bcr.3", dev_dependency = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.14")
python.toolchain(python_version = "3.14")
use_repo(python, "python_3_14")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "python_deps",
    python_version = "3.14",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "python_deps")

# rules_qt is a dependency of //third_party/qt, not of this module -- only the
# root module's overrides are honoured, and an override needs no bazel_dep.
#
# drop_intel_mac removes the ":osx_x86_64" branch from @rules_qt//:qt_*, which
# names a @qt_mac_x86_64 repo this project never fetches. Ordinary analysis
# never takes that branch, but a genquery scope resolves every branch of a
# select, so without this //:portable_backend_closure fails with an
# unresolved-repo error the moment anything Qt-bearing enters the closure --
# exactly when it has something to report.
#
# mac_single_rpath gives every Qt module's framework rpath to one shared
# library, so Apple's ld sees it once per link instead of warning on each repeat.
#
# windows_addons adds the Qt addon modules (charts, serialport) rules_qt does
# not list for Windows 6.8.3, each with its pinned sha256 so Bazel's remote
# downloader can serve it from BuildBuddy's CAS.
single_version_override(
    module_name = "rules_qt",
    patch_strip = 1,
    patches = [
        "//bazel/patches:rules_qt_drop_intel_mac.patch",
        "//bazel/patches:rules_qt_mac_single_rpath.patch",
        "//bazel/patches:rules_qt_windows_addons.patch",
    ],
)

msvc_sysroot = use_extension("//bazel/toolchains:msvc_sysroot_ext.bzl", "msvc_sysroot")
use_repo(msvc_sysroot, "msvc_sysroot")

register_toolchains("//bazel/toolchains/windows_x86_msvc:windows_x86_msvc_toolchain")

# Android NDK for the step-7 cross-compile spike. Not registered here: the
# toolchains are selected only by `--config=android` (bazel/android.bazelrc), so
# desktop builds never need an NDK. The extension reads ANDROID_NDK_HOME lazily.
android_ndk = use_extension("@rules_android_ndk//:extension.bzl", "android_ndk_repository_extension")
use_repo(android_ndk, "androidndk")

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)

# Upstream HEAD still calls native.py_binary / native cc_binary, both removed in
# Bazel 9. Pin the commit + integrity via archive_override (it carries the patch
# hermetically) and patch hedron to load py_binary / cc_binary from
# rules_python / rules_cc. Bump the commit deliberately.
archive_override(
    module_name = "hedron_compile_commands",
    integrity = "sha256-Gwir/7++ifbb7mpbM3U3kugAT2o283wPchFb7IbmhyQ=",
    patch_strip = 1,
    patches = ["//bazel/patches:hedron_bazel9_py_binary.patch"],
    strip_prefix = "bazel-compile-commands-extractor-abb61a688167623088f8768cc9264798df6a9d10",
    urls = ["https://github.com/hedronvision/bazel-compile-commands-extractor/archive/abb61a688167623088f8768cc9264798df6a9d10.tar.gz"],
)

# The Qt module wrappers live in-tree; see third_party/qt/MODULE.bazel.
local_path_override(
    module_name = "fastecu_qt",
    path = "third_party/qt",
)

# Headers of the system LLVM, for the clang-tidy plugin (tools/clang-tidy/plugin).
local_llvm = use_repo_rule("//bazel:llvm.bzl", "local_llvm")

local_llvm(name = "local_llvm")

# LLVM's test helper and FileCheck driver, unchanged from the analysis release.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "llvm_check_clang_tidy",
    downloaded_file_path = "check_clang_tidy.py",
    sha256 = "600ef62079184920c07f52a7fd564d361ba2fdc414bb69a2490658abf519ff69",
    urls = ["https://raw.githubusercontent.com/llvm/llvm-project/llvmorg-23.1.2/clang-tools-extra/test/clang-tidy/check_clang_tidy.py"],
)

http_file(
    name = "llvm_filecheck_driver",
    downloaded_file_path = "FileCheck.cpp",
    sha256 = "3c6568b68c5c6d6ec8b9a2acb378a6949c9f5004ae009d2597b7f760f944f320",
    urls = ["https://raw.githubusercontent.com/llvm/llvm-project/llvmorg-23.1.2/llvm/utils/FileCheck/FileCheck.cpp"],
)

# The SonarCloud scanner, with its bundled JRE, run by //tools/sonar:scan.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sonar_scanner_cli",
    build_file_content = """
filegroup(
    name = "files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "bb8f709f9cb73352f8d1260a3b3c506c0f41146754bc630762c126d795499d0b",
    strip_prefix = "sonar-scanner-8.1.0.6389-linux-x64",
    urls = ["https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-8.1.0.6389-linux-x64.zip"],
)
