# `manual` keeps `bazel build //...` (every CI matrix leg, SonarCloud) from
# fetching a Go SDK and compiling gazelle; `bazel run //:gazelle` still builds it.
gazelle_binary(
    name = "gazelle_cc_binary",
    languages = ["@gazelle_cc//language/cc"],
    tags = ["manual"],
)

GAZELLE_ARGS = [
    "src/algorithms",
    "src/backend/ports",
    "src/backend/protocol",
    "src/backend/checksum",
    "src/backend/diagnostics",
    "src/backend/config",
    "src/backend/definition",
    "src/backend/calibration",
    "src/backend/logging",
    "src/backend/service_functions",
    "src/backend/flash",
    "src/ui/desktop/calibration",
    "src/ui/desktop/checksum",
    "src/ui/desktop/menu",
    "src/ui/desktop/channels",
    "apps/bench",
    "src/platform/desktop/common/connection/testing",
    "src/platform/desktop/common/ports",
    "src/ui/desktop/definition",
    "src/platform/desktop/unix/j2534",
    "src/platform/desktop/windows/j2534",
    "src/ui/desktop/biu",
    "src/ui/desktop/hexedit",
    "src/platform/desktop/common/remote_utility",
]

gazelle(
    name = "gazelle",
    args = GAZELLE_ARGS,
    gazelle = ":gazelle_cc_binary",
    tags = ["manual"],
)

gazelle(
    name = "gazelle_diff",
    args = GAZELLE_ARGS,
    gazelle = ":gazelle_cc_binary",
    mode = "diff",
    tags = ["manual"],
)

