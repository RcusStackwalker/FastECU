load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//bazel:clang_tidy.bzl", "clang_tidy_runner")
load("//bazel:portable_targets.bzl", "CLOSURE_ROOTS")

package(default_visibility = ["//visibility:public"])

# Scope is GAZELLE_ARGS: widening gazelle to another area means adding a path.
# gazelle:cc_group unit
# gazelle:map_kind cc_test fastecu_portable_gtest //bazel:gtest_targets.bzl
# gazelle:exclude src/algorithms/protocol/qt_compat
# `manual` keeps `bazel build //...` (every CI matrix leg, SonarCloud) from
# fetching a Go SDK and compiling gazelle; `bazel run //:gazelle` still builds it.
gazelle_binary(
    name = "gazelle_cc_binary",
    languages = ["@gazelle_cc//language/cc"],
    tags = ["manual"],
)

GAZELLE_ARGS = [
    "src/algorithms",
    "src/backend/ports",
    "src/backend/protocol",
    "src/backend/checksum",
    "src/backend/diagnostics",
    "src/backend/config",
    "src/backend/definition",
    "src/backend/calibration",
    "src/backend/logging",
    "src/backend/service_functions",
    "src/backend/flash",
]

gazelle(
    name = "gazelle",
    args = GAZELLE_ARGS,
    gazelle = ":gazelle_cc_binary",
    tags = ["manual"],
)

gazelle(
    name = "gazelle_diff",
    args = GAZELLE_ARGS,
    gazelle = ":gazelle_cc_binary",
    mode = "diff",
    tags = ["manual"],
)

# Symbolic macros cannot implicitly declare their hardcoded source inputs.
exports_files([".clang-tidy"])

alias(
    name = "fastecu",
    actual = "//apps/desktop:fastecu",
)

alias(
    name = "fastecu-bench",
    actual = "//apps/bench:fastecu-bench",
)

py_test(
    name = "clang_tidy_runner_test",
    size = "small",
    srcs = [
        "scripts/clang_tidy_runner.py",
        "scripts/clang_tidy_runner_test.py",
    ],
    imports = ["scripts"],
    main = "scripts/clang_tidy_runner_test.py",
    deps = ["@python_deps//pyyaml"],
)

py_test(
    name = "gazelle_check_test",
    size = "small",
    srcs = [
        "scripts/gazelle_check.py",
        "scripts/gazelle_check_test.py",
    ],
    imports = ["scripts"],
    main = "scripts/gazelle_check_test.py",
)

# Every //src/platform label reachable from a portable target, however many
# layers of `deps` away. Platform packages restrict their own visibility to
# //src/platform, //src/ui, //apps and //tests, so this is empty until someone
# widens that list -- at which point Bazel is satisfied and only the assertion
# below is not.
#
# `filter` rather than a recursive //src/platform/... pattern: genquery rejects
# those. The roots come from bazel/portable_targets.bzl, and a name that does
# not resolve fails here, in the scope, rather than in any check.
genquery(
    name = "portable_closure_violations",
    expression = "filter('^//src/platform/', deps(set(" + " ".join(CLOSURE_ROOTS) + ")))",
    scope = CLOSURE_ROOTS,
)

# Fails the *build*, not a test: CI runs `bazel build -k --config=release //...`
# before it runs the suite, so a violation surfaces at the earlier step.
genrule(
    name = "portable_closure",
    srcs = [":portable_closure_violations"],
    outs = ["portable_closure_report.txt"],
    cmd = """if [ -s $< ]; then
  echo "FAIL: a portable target reaches platform code:" >&2
  sed 's/^/  /' $< >&2
  echo "" >&2
  echo "Portable targets must not depend on //src/platform, directly or through" >&2
  echo "several layers of deps. Move the platform-facing code to src/platform or" >&2
  echo "src/ui, or reach it through a backend port." >&2
  exit 1
fi
echo "OK: no //src/platform label is reachable from a portable target." > $@""",
)

py_test(
    name = "windows_preprocessor_guards",
    size = "small",
    srcs = ["scripts/check-windows-preprocessor-guards.py"],
    data = [
        "//src/backend/definitions:file_actions.h",
        "//src/platform/desktop/common/serial:serial_port_actions_direct.h",
    ],
    main = "scripts/check-windows-preprocessor-guards.py",
)

# Whole-tree and changed-files clang-tidy, each as a report or with fixes
# applied. See bazel/clang_tidy.bzl for how they are run.
clang_tidy_runner(
    name = "clang_tidy_report",
    mode = "report",
)

clang_tidy_runner(
    name = "clang_tidy_fix",
    mode = "fix",
)

clang_tidy_runner(
    name = "clang_tidy_fix_changed",
    changed = True,
    mode = "fix",
)

clang_tidy_runner(
    name = "clang_tidy_report_changed",
    changed = True,
    mode = "report",
)
