# `manual` keeps `bazel build //...` (every CI matrix leg, SonarCloud) from
# fetching a Go SDK and compiling gazelle; `bazel run //:gazelle` still builds it.
gazelle_binary(
    name = "gazelle_cc_binary",
    languages = ["@gazelle_cc//language/cc"],
    tags = ["manual"],
)

GAZELLE_ARGS = [
    "src",
    "apps",
    "tests",
    "resources/shared",
]

gazelle(
    name = "gazelle",
    args = GAZELLE_ARGS,
    gazelle = ":gazelle_cc_binary",
    tags = ["manual"],
)

gazelle(
    name = "gazelle_diff",
    args = GAZELLE_ARGS,
    gazelle = ":gazelle_cc_binary",
    mode = "diff",
    tags = ["manual"],
)

# Symbolic macros cannot implicitly declare their hardcoded source inputs.
exports_files([
    ".clang-tidy",
    ".github/workflows/pr.yml",
    ".github/workflows/sonar.yml",
    "sonar-project.properties",
])

alias(
    name = "fastecu",
    actual = "//apps/desktop:fastecu",
)

alias(
    name = "fastecu-bench",
    actual = "//apps/bench:fastecu-bench",
)

