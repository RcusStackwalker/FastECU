# `manual` keeps `bazel build //...` (every CI matrix leg, SonarCloud) from
# fetching a Go SDK and compiling gazelle; `bazel run //:gazelle` still builds it.
gazelle_binary(
    name = "gazelle_cc_binary",
    languages = ["@gazelle_cc//language/cc"],
    tags = ["manual"],
)

GAZELLE_ARGS = [
    "src",
    "apps",
    "tests",
    "resources/shared",
]

gazelle(
    name = "gazelle",
    args = GAZELLE_ARGS,
    gazelle = ":gazelle_cc_binary",
    tags = ["manual"],
)

gazelle(
    name = "gazelle_diff",
    args = GAZELLE_ARGS,
    gazelle = ":gazelle_cc_binary",
    mode = "diff",
    tags = ["manual"],
)

# Symbolic macros cannot implicitly declare their hardcoded source inputs.
exports_files([".clang-tidy"])

alias(
    name = "fastecu",
    actual = "//apps/desktop:fastecu",
)

alias(
    name = "fastecu-bench",
    actual = "//apps/bench:fastecu-bench",
)

py_test(
    name = "clang_tidy_runner_test",
    size = "small",
    srcs = [
        "scripts/clang_tidy_runner.py",
        "scripts/clang_tidy_runner_test.py",
    ],
    imports = ["scripts"],
    main = "scripts/clang_tidy_runner_test.py",
    deps = ["@python_deps//pyyaml"],
)

py_test(
    name = "gazelle_check_test",
    size = "small",
    srcs = [
        "scripts/gazelle_check.py",
        "scripts/gazelle_check_test.py",
    ],
    data = ["BUILD.bazel"],
    imports = ["scripts"],
    main = "scripts/gazelle_check_test.py",
)

py_test(
    name = "test_ownership_test",
    size = "small",
    srcs = [
        "scripts/gazelle_check.py",
        "scripts/test_ownership_test.py",
    ],
    imports = ["scripts"],
    main = "scripts/test_ownership_test.py",
)

py_test(
    name = "windows_preprocessor_guards",
    size = "small",
    srcs = ["scripts/check-windows-preprocessor-guards.py"],
    data = [
        "//src/platform/desktop/common/serial/direct:serial_port_actions_direct.h",
    ],
    main = "scripts/check-windows-preprocessor-guards.py",
)

# Whole-tree and changed-files clang-tidy, each as a report or with fixes
# applied. See bazel/clang_tidy.bzl for how they are run.
clang_tidy_runner(
    name = "clang_tidy_report",
    mode = "report",
)

clang_tidy_runner(
    name = "clang_tidy_fix",
    mode = "fix",
)

clang_tidy_runner(
    name = "clang_tidy_fix_changed",
    changed = True,
    mode = "fix",
)

clang_tidy_runner(
    name = "clang_tidy_report_changed",
    changed = True,
    mode = "report",
)
