# Computes the resolved transitive label closure of every required portable
# flash target, so the Python check below can catch a platform dependency
# reached through several layers of `deps` -- something the per-BUILD-file
# text scan in check-portable-closure.py cannot see, since that scan only
# looks at each target's own immediate BUILD-file text.
genquery(
    name = "portable_backend_closure",
    expression = "deps(set(" + " ".join([
        "//src/backend/flash:flash_types",
        "//src/backend/flash:flash_plan",
        "//src/backend/flash:flash_validation",
        "//src/backend/flash:flash_executor",
        "//src/backend/flash/eeprom:denso_sh705x_eeprom_common",
        "//src/backend/flash/eeprom:denso_sh705x_eeprom_kline",
        "//src/backend/flash/eeprom:denso_sh705x_eeprom_can",
        "//src/backend/protocol:protocol",
    ]) + "))",
    scope = [
        "//src/backend/flash:flash_types",
        "//src/backend/flash:flash_plan",
        "//src/backend/flash:flash_validation",
        "//src/backend/flash:flash_executor",
        "//src/backend/flash/eeprom:denso_sh705x_eeprom_common",
        "//src/backend/flash/eeprom:denso_sh705x_eeprom_kline",
        "//src/backend/flash/eeprom:denso_sh705x_eeprom_can",
        "//src/backend/protocol",
    ],
)

