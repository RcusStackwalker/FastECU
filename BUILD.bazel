# Computes the resolved transitive label closure of every required portable
# backend target, so the Python check below can catch a platform dependency
# reached through several layers of `deps` -- something the per-BUILD-file
# text scan in check-portable-closure.py cannot see, since that scan only
# looks at each target's own immediate BUILD-file text.
genquery(
    name = "portable_backend_closure",
    expression = "deps(set(" + " ".join(CLOSURE_ROOTS) + "))",
    scope = CLOSURE_ROOTS,
)

# The registry reaches the check as JSON in the environment, so it reads the
# same list the genquery above was built from rather than a hardcoded copy.
py_test(
    name = "portable_closure",
    size = "small",
    srcs = ["scripts/check-portable-closure.py"],
    data = [":portable_backend_closure"] + PORTABLE_BUILD_FILES,
    env = {"PORTABLE_REGISTRY": json.encode(PORTABLE_PACKAGES)},
    main = "scripts/check-portable-closure.py",
)

