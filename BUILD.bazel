        "//src/backend/flash/eeprom:denso_sh705x_eeprom_can",
        "//src/backend/flash/ecu:mitsu_colt_m32r_can_plan",
        "//src/backend/flash/ecu:mitsu_colt_m32r_can_executor",
        "//src/backend/flash/ecu:subaru_mitsu_m32r_kline_plan",
        "//src/backend/flash/ecu:subaru_mitsu_m32r_kline_executor",
