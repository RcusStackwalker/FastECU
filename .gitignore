# QtCreator
*.autosave

# QtCreator Qml
*.qmlproject.user
*.qmlproject.user.*

# QtCreator CMake
CMakeLists.txt.user*

# QtCreator 4.8< compilation database
compile_commands.json

# Hedron drops an `external` symlink to Bazel's external repos at the workspace
# root when generating compile_commands.json.
/external

# clangd fallback flags (machine-specific absolute paths, e.g. Homebrew prefix)
compile_flags.txt

# QtCreator local machine specific files for imported projects
*creator.user*

*_qmlcache.qrc

# local packaging script output
/dist/
/FastECU-*.zip

# lychee link-check response cache
/.lycheecache
/bazel-pkg-*.zip

/.worktrees/
/.cargo/

# Local analysis output: clang-tidy reports and coverage runs
/reports/

# Python bytecode caches. scripts/ and bazel/compile_commands/ hold the only
# Python in the tree (clang_tidy_runner, refresh_sonar); running either or
# their pytest suites drops a __pycache__ next to the source, and an
# untracked-but-not-ignored .pyc is one `git add -A` away from being
# committed.
__pycache__/
*.py[cod]

# Editor swap files
*.sw[a-p]
.superpowers/
